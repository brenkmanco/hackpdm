# Copy to .env (chmod 600 .env) and replace all placeholder values before deploying.
# Never commit .env to version control.

HACKPDM_DOMAIN=pdm.example.com
ODOO_DB=hackpdm_prod
POSTGRES_USER=odoo
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_32_CHAR_SECRET
ODOO_WORKERS=5

# Optional PostgreSQL memory tuning (adjust to host RAM)
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=1536MB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=200
