<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hp_settings_restrict_properties" model="hp.settings">
            <field name="name">restrict_properties</field>
            <field name="description">don't allow unknown properties</field>
            <field name="type">bool</field>
            <field name="bool_value" eval="True"/>
        </record>
        <record id="hp_settings_restrict_types" model="hp.settings">
            <field name="name">restrict_types</field>
            <field name="description">only known file types</field>
            <field name="type">bool</field>
            <field name="bool_value" eval="True"/>
        </record>
        <record id="hp_settings_client_version" model="hp.settings">
            <field name="name">client_version</field>
            <field name="description">hackpdm client version</field>
            <field name="type">char</field>
            <field name="char_value">1.0.0.27</field>
        </record>
        <record id="hp_test_data_one" model="hp.test">
            <!-- Binary: base64-encoded "hello" -->
            <!-- <field name="binary" type="base64">aGVsbG8=</field> -->
            <!-- <field name="binary" filename="file_name" widget="binary"/> -->

            <!-- Boolean -->
            <field name="boolean">True</field>

            <!-- Char -->
            <field name="character">Test Character Field</field>

            <!-- Date -->
            <field name="dates">2024-01-01</field>

            <!-- Datetime (UTC) -->
            <field name="datetimes">2024-01-01 12:34:56</field>

            <!-- Float -->
            <field name="floats">123.456</field>

            <!-- HTML -->
            <field name="html">&lt;p&gt;&lt;strong&gt;Test HTML&lt;/strong&gt; content for hp.test.&lt;/p&gt;</field>

            <!-- Image: base64-encoded 1×1 PNG (keep it on a single line) -->
            <!-- <field name="image">iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+X2f8AAAAASUVORK5CYII=</field> -->

            <!-- Integer -->
            <field name="integer">42</field>

            <!-- JSON (Use eval with a Python dictionary) -->
            <field name="json" eval="{'key': 'value', 'number': 123, 'flag': True}"/>

            <!-- Monetary -->
            <field name="monetary">19.99</field>

            <!-- Selection -->
            <field name="selection">option_a</field>

            <!-- Text -->
            <field name="text">This is a long text field used for testing.</field>
        </record>

        <record id="hp_test_data_two" model="hp.test">
            <field name="character">Record Two</field>
            <field name="manytoone" ref="hp_test_data_one"/>
            <!-- One2many: create inline children -->
            <field name="onetomany" eval="[(0, 0, {'character': 'Child 1', 'manytoone': ref('hp_test_data_one')})]"/>
            <field name="manytomany" eval="[(6, 0, [ref('hp_test_data_one')])]"/>
            <field name="monetary">21.99</field>
        </record>

    </data>
</odoo>