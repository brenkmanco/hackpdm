<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="hp_settings_restrict_properties" model="hp.settings">
            <field name="name">restrict_properties</field>
            <field name="description">don't allow unknown properties</field>
            <field name="type">bool</field>
            <field name="bool_value" eval="True"/>
        </record>
        <record id="hp_settings_restrict_types" model="hp.settings">
            <field name="name">restrict_types</field>
            <field name="description">only known file types</field>
            <field name="type">bool</field>
            <field name="bool_value" eval="True"/>
        </record>
    </data>

    <!-- Kept as the administrator sets them: never reset by a module upgrade -->
    <data noupdate="1">
        <record id="hp_settings_client_version" model="hp.settings">
            <field name="name">client_version</field>
            <field name="description">required HackPDM client version or range (e.g. '1.1.0', '>=1.1.0', '&lt;=1.3.0', '>=1.1.0, &lt;2.0.0', or '1.1.0 - 1.3.0'); clients outside this range are denied access until updated</field>
            <field name="type">char</field>
            <field name="char_value">&gt;=1.1.0, &lt;2.0.0</field>
        </record>
        <record id="hp_settings_client_latest_version" model="hp.settings">
            <field name="name">client_latest_version</field>
            <field name="description">latest published HackPDM client version (e.g. '1.2.0'); compatible older clients are prompted to update without blocking login</field>
            <field name="type">char</field>
        </record>
        <record id="hp_settings_client_download_url" model="hp.settings">
            <field name="name">client_download_url</field>
            <field name="description">where clients download the installer (https URL, or a file or network-share path)</field>
            <field name="type">char</field>
        </record>
        <record id="hp_settings_client_download_sha256" model="hp.settings">
            <field name="name">client_download_sha256</field>
            <field name="description">SHA-256 of the installer at client_download_url; clients refuse a file that does not match</field>
            <field name="type">char</field>
        </record>
    </data>
</odoo>
