<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top Menu -->
    <menuitem 
        id="hack_menu_root"
        name="hackpdm"
        sequence="25"/>

    <!-- Folder Directories -->
    <menuitem
        id="hack_menu_directory"
        name="Hack"
        parent="hack_menu_root"
        action="action_hp_directory"
        sequence="1" />
    <!-- Entry Files -->
    <menuitem
        id="hack_menu_entry"
        name="Entries"
        parent="hack_menu_root"
        action="action_hp_entry"
        sequence="1"/>

    <data>
        <record id="hp_directory_view_tree" model="ir.ui.view">
            <field name="name">hp.directory.tree</field>
            <field name="model">hp.directory</field>
            <field name="arch" type="xml">
                <tree string="File Directory">
                    <field name="name"/>
                    <field name="parent_id"/>
                    <field name="default_cat"/>
                </tree>
            </field>
        </record>

        <record id="hp_entry_view_tree" model="ir.ui.view">
            <field name="name">hp.entry.tree</field>
            <field name="model">hp.entry</field>
            <field name="arch" type="xml">
                <tree string="Entry Files">
                    <field name="name"/>
                </tree>
            </field>
        </record>
    </data>

    <data>
        <record id="action_hp_directory" model="ir.actions.act_window">
            <field name="name">File Directory</field>
            <field name="res_model">hp.directory</field>
            <field name="view_mode">tree,form</field>
        </record>
        <record id="action_hp_entry" model="ir.actions.act_window">
            <field name="name">Entry Files</field>
            <field name="res_model">hp.entry</field>
            <field name="view_mode">tree,form</field>
        </record>
        
        <!-- <menuitem id="menu_hp_directory" name="File Directory" action="action_hp_directory" parent="base.menu_custom"/>
        <menuitem id="menu_hp_entry" name="Entry Files" action="action_hp_entry" parent="base.menu_custom"/> -->
    </data>
</odoo>