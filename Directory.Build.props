<Project>
  <PropertyGroup>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <!-- The one HackPDM version: the client's assembly, file and package versions all come from it.
       Release builds override it from the git tag (vX.Y.Z): dotnet publish -p:HackPdmVersion=X.Y.Z
       The server's hp.settings "client_version" is the oldest client version it accepts. -->
  <PropertyGroup>
    <HackPdmVersion Condition="'$(HackPdmVersion)' == ''">1.1.0</HackPdmVersion>
    <Version>$(HackPdmVersion)</Version>
    <AssemblyVersion>$(HackPdmVersion).0</AssemblyVersion>
    <FileVersion>$(HackPdmVersion).0</FileVersion>
    <InformationalVersion>$(HackPdmVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Uno single project: the package (MSIX) manifest's version -->
    <ApplicationDisplayVersion>$(HackPdmVersion)</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- Publishing & Windows Explorer File Properties metadata -->
    <Product>HackPDM</Product>
    <Company>HackPDM</Company>
    <Authors>Justin Johnson and HackPDM Contributors</Authors>
    <Description>Open-source local-first Product Data Management (PDM) desktop client for CAD &amp; Odoo.</Description>
    <Copyright>Copyright (c) HackPDM Contributors (GPL-3.0)</Copyright>
    <PackageProjectUrl>https://github.com/moonxbears/wyrmpdm</PackageProjectUrl>
    <RepositoryUrl>https://github.com/moonxbears/wyrmpdm</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
