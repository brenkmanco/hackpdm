<?xml version="1.0" encoding="utf-8" ?>
<!--
	Shared HackPDM styles, matching the Components page of the Figma file "HackPDM — Uno Material Design".
	Merged in App.xaml after the Material theme, so every page can use them.

	Colors: brushes below that carry a "set by ThemeService" note are recolored from the active preset at startup
	and whenever the preset or a Theme Editor color changes (MaterialRoles.AppBrushes); their XAML colors are
	placeholders. Everything else uses Material brushes ({ThemeResource PrimaryBrush}, …) or the app's
	HackSurfaceContainer* brushes, which follow the preset too.

	Shapes: panel corners and border thickness come from the shape style (HackPanelCornerRadius,
	HackPanelBorderThickness). Those values are set after this file loads, so styles here can't carry them:
	set CornerRadius and BorderThickness on the element itself, e.g.
	<Border Style="{StaticResource HackPaneOutlinedStyle}" BorderThickness="{StaticResource HackPanelBorderThickness}"
	        CornerRadius="{StaticResource HackPanelCornerRadius}" />
-->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!--  ===== Panes (Figma: Pane card) =====  -->
	<!--  Tinted pane: folders, preview, side panels. No border.  -->
	<Style x:Key="HackPaneTintedStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource HackSurfaceContainerLowBrush}" />
	</Style>
	<!--  Outlined pane: file list, inspector, tables.  -->
	<Style x:Key="HackPaneOutlinedStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{StaticResource HackPanelStrokeBrush}" />
	</Style>
	<!--  Toolbar strip across the top of a page.  -->
	<Style x:Key="HackToolbarStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource HackSurfaceContainerBrush}" />
		<Setter Property="Padding" Value="8,4,12,4" />
		<Setter Property="CornerRadius" Value="16" />
	</Style>
	<!--  Pane title ("Folders", "Preview").  -->
	<Style
		x:Key="HackPaneTitleStyle"
		BasedOn="{StaticResource TitleMedium}"
		TargetType="TextBlock">
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>
	<!--  Small secondary text: summaries, hints, counts.  -->
	<Style
		x:Key="HackCaptionStyle"
		BasedOn="{StaticResource BodySmall}"
		TargetType="TextBlock">
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
	</Style>

	<!--  ===== Banners (Figma: Banner) =====  -->
	<Style x:Key="HackBannerInfoStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource SecondaryContainerBrush}" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="12" />
	</Style>
	<Style x:Key="HackBannerWarningStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource TertiaryContainerBrush}" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="12" />
	</Style>
	<Style x:Key="HackBannerErrorStyle" TargetType="Border">
		<Setter Property="Background" Value="{ThemeResource ErrorContainerBrush}" />
		<Setter Property="Padding" Value="16,8" />
		<Setter Property="CornerRadius" Value="12" />
	</Style>

	<!--  ===== Buttons (Figma: Icon button, Chip) =====  -->
	<!--  32px icon buttons in pane headers and tab strips.  -->
	<Style
		x:Key="PaneIconButtonStyle"
		BasedOn="{StaticResource IconButtonStyle}"
		TargetType="Button">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="32" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="16" />
	</Style>
	<Style
		x:Key="PaneIconToggleButtonStyle"
		BasedOn="{StaticResource IconToggleButtonStyle}"
		TargetType="ToggleButton">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="MinWidth" Value="32" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="CornerRadius" Value="16" />
	</Style>
	<!--  Assist chip (Refresh, Search): runs an action. A Chip control would stay toggled after a click, so this is a button shaped like one.  -->
	<Style
		x:Key="AssistChipButtonStyle"
		BasedOn="{StaticResource OutlinedButtonStyle}"
		TargetType="Button">
		<Setter Property="Height" Value="32" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="8,6,16,6" />
		<Setter Property="CornerRadius" Value="8" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
		<Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
	</Style>
	<!--  Compact text button for secondary bars ("Group by").  -->
	<Style
		x:Key="GroupedBarTextButtonStyle"
		BasedOn="{StaticResource TextButtonStyle}"
		TargetType="Button">
		<Setter Property="Height" Value="32" />
		<Setter Property="MinHeight" Value="32" />
		<Setter Property="Padding" Value="12,0" />
	</Style>
	<!--  Clickable column label in hand-built tables (styled like the table header).  -->
	<Style
		x:Key="GroupedSortHeaderButtonStyle"
		BasedOn="{StaticResource TextButtonStyle}"
		TargetType="Button">
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="Padding" Value="2,1" />
		<Setter Property="CornerRadius" Value="4" />
		<Setter Property="FontSize" Value="12" />
		<Setter Property="FontWeight" Value="Medium" />
		<Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
	</Style>

	<!--  ===== Tabs (Figma: Tab) — transparent strip, label color marks the selected tab, Primary underline =====  -->
	<SolidColorBrush x:Key="TabViewBackground" Color="Transparent" />
	<SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent" />
	<SolidColorBrush x:Key="TabViewItemSeparator" Color="Transparent" />
	<SolidColorBrush x:Key="TabViewSelectedItemBorderBrush" Color="Transparent" />
	<!--  set by ThemeService  -->
	<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="#20808080" />
	<SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="#20808080" />
	<SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="Gray" />
	<SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="TabViewItemHeaderForegroundPressed" Color="Gray" />
	<SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="Gray" />
	<!--  secondary tabs (inspectors) keep the selected label in On Surface: alias it in the TabView's resources with
	     <StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="HackSecondaryTabForegroundSelectedBrush" />  -->
	<SolidColorBrush x:Key="HackSecondaryTabForegroundSelectedBrush" Color="Gray" />
	<SolidColorBrush x:Key="TabViewBorderBrush" Color="Gray" />
	<!--  the underline: the last two stops are set by ThemeService to Primary  -->
	<LinearGradientBrush x:Key="TabViewItemHeaderBackgroundSelected" StartPoint="0,0" EndPoint="0,1">
		<GradientStop Offset="0" Color="Transparent" />
		<GradientStop Offset="0.94" Color="Transparent" />
		<GradientStop Offset="0.94" Color="Gray" />
		<GradientStop Offset="1" Color="Gray" />
	</LinearGradientBrush>
	<x:Double x:Key="TabViewItemHeaderFontSize">14</x:Double>
	<x:Double x:Key="TabViewItemMinHeight">48</x:Double>
	<Thickness x:Key="TabViewTopHeaderPadding">8,0,0,0</Thickness>

	<!--  ===== Tables (Figma: File table/Header) — header on Surface Container Low, On Surface Variant labels; set by ThemeService =====  -->
	<SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Gray" />
	<SolidColorBrush x:Key="TableViewHeaderForeground" Color="Gray" />

	<!--  ===== Trees (Figma: Folder tree/Item) — the selected item is a Secondary Container pill; set by ThemeService =====  -->
	<SolidColorBrush x:Key="TreeViewItemBackgroundSelected" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemBackgroundSelectedPressed" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemForegroundSelected" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemForegroundSelectedPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemForegroundSelectedPressed" Color="Gray" />
	<SolidColorBrush x:Key="TreeViewItemSelectionIndicatorForeground" Color="Transparent" />

	<!--  ===== Navigation rail (Figma: Navigation item) — rail on the page background, selected item a Secondary Container pill =====  -->
	<SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="Transparent" />
	<SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent" />
	<SolidColorBrush x:Key="NavigationViewDefaultPaneBorderBrush" Color="Transparent" />
	<!--  Uno Material's NavigationView reads these two; set by ThemeService  -->
	<SolidColorBrush x:Key="NavigationViewPaneBackground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewBackground" Color="Gray" />
	<!--  set by ThemeService  -->
	<SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewExpandedPaneBackground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewContentBackground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForeground" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForegroundPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForegroundPressed" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemBackgroundPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemBackgroundPressed" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPointerOver" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemForegroundSelectedPressed" Color="Gray" />
	<SolidColorBrush x:Key="NavigationViewItemSeparatorForeground" Color="Gray" />
</ResourceDictionary>
