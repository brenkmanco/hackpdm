<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <UnoSingleProject>true</UnoSingleProject>
    <UnoFeatures>Svg;Material;Toolkit</UnoFeatures>
    <UnoDisableResizetizer>true</UnoDisableResizetizer>
    <UnoResizetizerEnabled>false</UnoResizetizerEnabled>
    <DisableDefaultUnoResizetizerItems>true</DisableDefaultUnoResizetizerItems>
    <NoWarn>$(NoWarn);NU1605;NU1903;NU1202;CA1416</NoWarn>
    <PackageConflictResolution>false</PackageConflictResolution>
    <OutputType Condition="$(TargetFramework.Contains('windows'))">WinExe</OutputType>
    <OutputType Condition="!$(TargetFramework.Contains('windows'))">Exe</OutputType>
    <TargetFrameworks>net10.0-windows10.0.26100.0;net10.0-desktop</TargetFrameworks>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('windows'))">10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>HackPDM</RootNamespace>
    <ApplicationManifest Condition="$(TargetFramework.Contains('windows'))">app.manifest</ApplicationManifest>
    <Platform>x64</Platform>
    <Platforms>x86;x64;ARM64</Platforms>
    <PublishProfile Condition="$(TargetFramework.Contains('windows'))">win-$(Platform).pubxml</PublishProfile>
    <EnableMsixTooling Condition="$(TargetFramework.Contains('windows'))">true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableWindowsTargeting Condition="$(TargetFramework.Contains('windows'))">true</EnableWindowsTargeting>
    <WindowsTargetPlatformVersion Condition="$(TargetFramework.Contains('windows'))">10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsAppSDKSelfContained Condition="$(TargetFramework.Contains('windows'))">true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="('$(Platform)' == 'AnyCPU' or '$(Platform)' == 'Any CPU') and '$(RuntimeIdentifier)' == '' and $(TargetFramework.Contains('windows'))">win-x64</RuntimeIdentifier>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <PublishTrimmed>False</PublishTrimmed>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('windows'))">10.0.17763.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\hackpdm-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableSmokeTests)' == 'true'">
    <DefineConstants>$(DefineConstants);SMOKE_TESTS</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(EnableSmokeTests)' == 'true'">
    <Compile Include="..\HackPDM.SmokeTests\*.cs" Link="SmokeTests\%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.UI.Xaml.Controls" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HackPDM.Core\HackPDM.Core.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('windows'))">
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WinUI.TableView" Version="1.5.1" />
  </ItemGroup>

  <ItemGroup>
    <UnoImage Remove="**\*.svg" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260529003" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup Condition="!$(TargetFramework.Contains('windows'))">
    <ApplicationDefinition Include="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </ApplicationDefinition>
  </ItemGroup>

  <Target Name="RemoveTransitiveWindowsDesktopDependenciesForExe"
          AfterTargets="ResolvePackageAssets"
          BeforeTargets="_CheckForTransitiveWindowsDesktopDependencies"
          Condition="!$(TargetFramework.Contains('windows'))">
    <ItemGroup>
      <TransitiveFrameworkReference Remove="@(TransitiveFrameworkReference)"
        Condition="'%(Identity)' == 'Microsoft.WindowsDesktop.App' Or
                   '%(Identity)' == 'Microsoft.WindowsDesktop.App.WPF' Or
                   '%(Identity)' == 'Microsoft.WindowsDesktop.App.WindowsForms'" />
    </ItemGroup>
  </Target>

  <Target Name="GenerateAssetMap" BeforeTargets="CoreCompile;XamlPreCompile">
    <PropertyGroup>
      <_AssetMapFile>$(IntermediateOutputPath)AssetMap.g.cs</_AssetMapFile>
    </PropertyGroup>
    <ItemGroup>
      <_StatusSvg Include="Assets\StatusIcons\*.svg" />
      <_AssetMapEntry Include="Assets\*.png;Assets\*.ico;Assets\*.gif" Folder="" />
      <_AssetMapEntry Include="Assets\Icons\*.svg" Folder="Icons/" />
      <_AssetMapEntry Include="@(_StatusSvg)" Folder="StatusIcons/" />
      <_AssetMapEntry Include="Assets\StatusIcons\*.png" Exclude="@(_StatusSvg->'Assets\StatusIcons\%(Filename).png');Assets\StatusIcons\*_640.png" Folder="StatusIcons/" />
      <_AssetMapLine Include="@(_AssetMapEntry->'		( &quot;%(Filename)&quot;, &quot;%(Folder)%(Filename)%(Extension)&quot; ),')" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(_AssetMapFile)"
      Lines="// &lt;auto-generated /&gt; by the GenerateAssetMap target in HackPDM.csproj;namespace HackPDM.Common%3B;public static partial class Assets;{;	private static readonly (string Key, string Path)[] BundledImages =;	[;@(_AssetMapLine);	]%3B;}"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(_AssetMapFile)" />
      <Compile Include="$(_AssetMapFile)" />
      <FileWrites Include="$(_AssetMapFile)" />
    </ItemGroup>
  </Target>
</Project>
