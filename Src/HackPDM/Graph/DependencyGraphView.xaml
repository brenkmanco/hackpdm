<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Graph.DependencyGraphView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:conv="using:HackPDM.Common"
	xmlns:controls="using:HackPDM.Common"
	xmlns:local="using:HackPDM.Graph"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pp="urn:wyrmpdm:penpot-sync"
	xmlns:rep="using:HackPDM.Core.Services"
	xmlns:types="using:HackPDM.Common"
	xmlns:tv="using:WinUI.TableView"
	xmlns:ut="using:Uno.Themes"
	xmlns:utu="using:Uno.Toolkit.UI"
	Background="{ThemeResource BackgroundBrush}"
	mc:Ignorable="d pp">

	<Page.Resources>
		<conv:FileSizeConverter x:Key="FileSizeFormatter" />
		<conv:LocalDateTimeConverter x:Key="LocalDateFormatter" />
		<local:ValueTextConverter x:Key="ValueFormatter" />
		<!--
			Material look for this screen, built from the Penpot frames "Dependency Graph — Light" / "— Dark".
			Colors come from the active color preset; the graph canvas takes its colors from the same scheme
			(GraphThemes.FromScheme). Pane corners and borders come from the shape style (HackPanel* resources).
		-->
		<Style
			x:Key="InfoLabel"
			BasedOn="{StaticResource BodySmall}"
			TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,12,0" />
		</Style>
		<Style
			x:Key="InfoValue"
			BasedOn="{StaticResource BodyMedium}"
			TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="IsTextSelectionEnabled" Value="True" />
		</Style>
		<DataTemplate x:Key="RelatedVersionTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
		</DataTemplate>
		<DataTemplate x:Key="RelatedNameTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="RelatedPathTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind BasePath}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChildVersionTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
		</DataTemplate>
		<DataTemplate x:Key="ChildNameTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChildPathTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind BasePath}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
	</Page.Resources>

	<Grid Margin="12" RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Folder Breadcrumb & Pane Controls Bar (Penpot: Toolbar)  -->
		<Border Grid.Row="0" pp:Id="graph.toolbar" Style="{StaticResource HackToolbarStyle}">
			<Grid ColumnSpacing="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel
					Grid.Column="0"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="4">
					<ToggleButton
						x:Name="ToggleFoldersPaneBtn"
						Click="ToggleSidePanes_Click"
						IsChecked="True"
						Style="{StaticResource PaneIconToggleButtonStyle}"
						ToolTipService.ToolTip="Show or hide folders sidebar">
						<FontIcon FontSize="16" Glyph="&#xE8B7;" />
						<ut:ControlExtensions.AlternateContent>
							<FontIcon
								FontSize="16"
								Foreground="{ThemeResource PrimaryBrush}"
								Glyph="&#xE8B7;" />
						</ut:ControlExtensions.AlternateContent>
					</ToggleButton>
					<ToggleButton
						x:Name="ToggleFilesPaneBtn"
						Click="ToggleSidePanes_Click"
						IsChecked="True"
						Style="{StaticResource PaneIconToggleButtonStyle}"
						ToolTipService.ToolTip="Show or hide folder files list">
						<FontIcon FontSize="16" Glyph="&#xE8FD;" />
						<ut:ControlExtensions.AlternateContent>
							<FontIcon
								FontSize="16"
								Foreground="{ThemeResource PrimaryBrush}"
								Glyph="&#xE8FD;" />
						</ut:ControlExtensions.AlternateContent>
					</ToggleButton>
				</StackPanel>
				<BreadcrumbBar
					x:Name="FolderBreadcrumb"
					Grid.Column="1"
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					ItemsSource="{x:Bind ViewModel.BreadcrumbPath}">
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:DataType="types:TreeData">
							<StackPanel
								Padding="3,2"
								Orientation="Horizontal"
								Spacing="5"
								ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
								<controls:FolderIcon
									VerticalAlignment="Center"
									IconSize="14"
									IsOpen="False"
									IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
									Origin="{x:Bind Origin, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="14"
									FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
									Text="{x:Bind Name}" />
							</StackPanel>
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>
			</Grid>
		</Border>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="GraphFoldersCol" Width="264" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition x:Name="GraphFilesCol" Width="260" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  folders  -->
			<Border pp:Id="graph.foldersPane"
				x:Name="GraphFoldersCard"
				Grid.Column="0"
				Style="{StaticResource HackPaneTintedStyle}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0" Padding="16,12,8,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock pp:Id="graph.foldersTitle"
							Grid.Column="0"
							Style="{StaticResource HackPaneTitleStyle}"
							Text="Folders" />
						<StackPanel
							Grid.Column="1"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<ToggleButton
								x:Name="GraphBranchLinesToggle"
								Click="BranchLinesToggle_Click"
								Style="{StaticResource PaneIconToggleButtonStyle}"
								ToolTipService.ToolTip="Show or hide tree branching guide lines">
								<FontIcon FontSize="14" Glyph="&#xE8FD;" />
								<ut:ControlExtensions.AlternateContent>
									<FontIcon
										FontSize="14"
										Foreground="{ThemeResource PrimaryBrush}"
										Glyph="&#xE8FD;" />
								</ut:ControlExtensions.AlternateContent>
							</ToggleButton>
							<Button
								Click="ExpandAllFolders_Click"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Expand all folders">
								<FontIcon FontSize="14" Glyph="&#xE70D;" />
							</Button>
							<Button
								Click="CollapseAllFolders_Click"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Collapse all folders">
								<FontIcon FontSize="14" Glyph="&#xE70E;" />
							</Button>
						</StackPanel>
					</Grid>
					<Grid Grid.Row="1">
						<TreeView
							x:Name="FolderTree"
							Padding="4,4"
							VerticalAlignment="Stretch"
							BorderThickness="0"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							SelectionMode="Single">
							<TreeView.Resources>
								<Thickness x:Key="TreeViewItemPresenterPadding">0,0,0,0</Thickness>
								<Thickness x:Key="TreeViewItemPresenterMargin">0,0,0,0</Thickness>
								<x:Double x:Key="TreeViewItemIndent">16</x:Double>
								<x:Double x:Key="TreeViewItemMinHeight">30</x:Double>
								<x:Double x:Key="TreeViewItemExpandCollapseChevronFontSize">11</x:Double>
							</TreeView.Resources>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="types:TreeData">
									<TreeViewItem
										MinHeight="30"
										Margin="0"
										Padding="0"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
										<StackPanel
											VerticalAlignment="Stretch"
											Orientation="Horizontal">
											<controls:TreeBranchGuides
												VerticalAlignment="Stretch"
												BranchRevision="{x:Bind BranchRevision, Mode=OneWay}"
												IndentWidth="16"
												NodeData="{x:Bind}" />
											<controls:FolderIcon
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												IconSize="18"
												IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
												IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
												Origin="{x:Bind Origin, Mode=OneWay}" />
											<TextBlock
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												FontSize="14"
												FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
												Text="{x:Bind Name}" />
											<Border
												Margin="0,0,5,0"
												Padding="6,0"
												VerticalAlignment="Center"
												Background="{ThemeResource HackSurfaceContainerHighBrush}"
												CornerRadius="8"
												Visibility="{x:Bind SubfolderCountVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="11"
													Foreground="{ThemeResource OnSurfaceVariantBrush}"
													Text="{x:Bind SubfolderCountText, Mode=OneWay}" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<Border
							Background="{ThemeResource HackSurfaceContainerLowBrush}"
							CornerRadius="{StaticResource HackPanelCornerRadius}"
							Visibility="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}">
							<Grid RowDefinitions="Auto,*">
								<ProgressBar
									Grid.Row="0"
									Margin="6,6,6,0"
									IsIndeterminate="True" />
								<StackPanel
									Grid.Row="1"
									Padding="16"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">
									<ProgressRing
										Width="28"
										Height="28"
										HorizontalAlignment="Center"
										IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" />
									<TextBlock
										HorizontalAlignment="Center"
										Style="{StaticResource LabelLarge}"
										Foreground="{ThemeResource OnSurfaceVariantBrush}"
										Text="Loading Folders…" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Border>

			<!--  Splitter: Folders <-> Files  -->
			<controls:PaneSplitter
				x:Name="GraphFoldersSplitter"
				Grid.Column="1"
				DragCompleted="GraphSplitter_DragCompleted"
				DragDelta="GraphFoldersSplitter_DragDelta"
				Orientation="Vertical" />

			<!--  files of the folder  -->
			<Border pp:Id="graph.filesPane"
				x:Name="GraphFilesCard"
				Grid.Column="2"
				Style="{StaticResource HackPaneOutlinedStyle}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid
						Grid.Row="0"
						Padding="16,8,8,4"
						ColumnDefinitions="*,Auto">
						<TextBlock pp:Id="graph.filesTitle" Style="{StaticResource HackPaneTitleStyle}" Text="Files" />
						<CheckBox
							x:Name="SelectAll"
							Grid.Column="1"
							MinWidth="0"
							Content="Select all"
							IsThreeState="False" />
					</Grid>
					<Grid Grid.Row="1">
						<ListView
							x:Name="EntryList"
							Padding="4,0"
							ItemsSource="{x:Bind ViewModel.Entries}"
							SelectionMode="Extended">
							<ListView.ItemTemplate>
								<DataTemplate x:DataType="local:GraphEntryItem">
									<TextBlock
										Style="{StaticResource BodyMedium}"
										FontWeight="Normal"
										Text="{x:Bind Name}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap" />
								</DataTemplate>
							</ListView.ItemTemplate>
						</ListView>
						<ProgressBar
							Height="3"
							VerticalAlignment="Top"
							IsHitTestVisible="False"
							IsIndeterminate="True"
							Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}" />
						<Border
							Padding="20,16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{ThemeResource HackSurfaceContainerHighBrush}"
							CornerRadius="12"
							IsHitTestVisible="False"
							Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}">
							<StackPanel Spacing="8">
								<ProgressRing
									Width="24"
									Height="24"
									HorizontalAlignment="Center"
									IsActive="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}" />
								<TextBlock
									Style="{StaticResource BodyMedium}"
									Foreground="{ThemeResource OnSurfaceVariantBrush}"
									Text="Loading files…" />
							</StackPanel>
						</Border>
					</Grid>
					<TextBlock
						Grid.Row="2"
						Margin="16,4,16,10"
						Style="{StaticResource HackCaptionStyle}"
						Text="{x:Bind ViewModel.EntryCountText, Mode=OneWay}" />
				</Grid>
			</Border>

			<!--  Splitter: Files <-> Graph  -->
			<controls:PaneSplitter
				x:Name="GraphFilesSplitter"
				Grid.Column="3"
				DragCompleted="GraphSplitter_DragCompleted"
				DragDelta="GraphFilesSplitter_DragDelta"
				Orientation="Vertical" />

			<!--  graph  -->
			<Grid Grid.Column="4" RowSpacing="8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<!--  Penpot: Graph controls (direction filter chips, zoom icon buttons, Fit assist chip)  -->
			<StackPanel pp:Id="graph.controls"
				Grid.Row="0"
				Orientation="Horizontal"
				Spacing="8">
				<utu:Chip
					x:Name="DirectionChildrenChip"
					CanRemove="False"
					Click="DirectionChip_Click"
					Content="Children"
					IsChecked="{x:Bind ViewModel.IsChildrenDirection, Mode=OneWay}"
					Style="{StaticResource FilterChipStyle}"
					Tag="Children" />
				<utu:Chip
					x:Name="DirectionParentsChip"
					CanRemove="False"
					Click="DirectionChip_Click"
					Content="Parents"
					IsChecked="{x:Bind ViewModel.IsParentsDirection, Mode=OneWay}"
					Style="{StaticResource FilterChipStyle}"
					Tag="Parents" />
				<utu:Chip
					x:Name="DirectionBothChip"
					CanRemove="False"
					Click="DirectionChip_Click"
					Content="Both"
					IsChecked="{x:Bind ViewModel.IsBothDirection, Mode=OneWay}"
					Style="{StaticResource FilterChipStyle}"
					Tag="Both" />
				<Border
					Width="1"
					Height="24"
					Margin="4,0"
					VerticalAlignment="Center"
					Background="{ThemeResource OutlineVariantBrush}" />
				<Button
					Command="{x:Bind ViewModel.ZoomOutCommand}"
					Style="{StaticResource PaneIconButtonStyle}"
					ToolTipService.ToolTip="Zoom out">
					<FontIcon FontSize="14" Glyph="&#xE738;" />
				</Button>
				<TextBlock
					MinWidth="44"
					VerticalAlignment="Center"
					Style="{StaticResource LabelLarge}"
					Foreground="{ThemeResource OnSurfaceVariantBrush}"
					Text="{x:Bind ViewModel.ZoomText, Mode=OneWay}"
					TextAlignment="Center" />
				<Button
					Command="{x:Bind ViewModel.ZoomInCommand}"
					Style="{StaticResource PaneIconButtonStyle}"
					ToolTipService.ToolTip="Zoom in">
					<FontIcon FontSize="14" Glyph="&#xE710;" />
				</Button>
				<Button
					VerticalAlignment="Center"
					Command="{x:Bind ViewModel.FitCommand}"
					Style="{StaticResource AssistChipButtonStyle}"
					ToolTipService.ToolTip="Show the whole graph">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<FontIcon
							FontSize="16"
							Foreground="{ThemeResource PrimaryBrush}"
							Glyph="&#xE9A6;" />
						<TextBlock VerticalAlignment="Center" Text="Fit" />
					</StackPanel>
				</Button>
				<ProgressRing
					Width="20"
					Height="20"
					IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
			</StackPanel>
			<!--  Penpot: Graph canvas (outlined pane; NodeGraphView draws on the Surface color)  -->
			<Border pp:Id="graph.canvas"
				Grid.Row="1"
				Style="{StaticResource HackPaneOutlinedStyle}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<local:NodeGraphView x:Name="Graph" />
					<TextBlock
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Style="{StaticResource BodyMedium}"
						Foreground="{ThemeResource OnSurfaceVariantBrush}"
						IsHitTestVisible="False"
						Text="Pick one or more files to see their dependencies"
						Visibility="{x:Bind ViewModel.ShowHint, Mode=OneWay}" />
					<Border
						Margin="0,16,0,0"
						Padding="16,10"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Background="{ThemeResource HackSurfaceContainerHighBrush}"
						CornerRadius="12"
						IsHitTestVisible="False"
						Visibility="{x:Bind ViewModel.IsGraphBusyOverlayVisible, Mode=OneWay}">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<ProgressRing
								Width="18"
								Height="18"
								IsActive="{x:Bind ViewModel.IsGraphBusyOverlayVisible, Mode=OneWay}" />
							<TextBlock
								VerticalAlignment="Center"
								Style="{StaticResource BodyMedium}"
								Text="Building dependency graph…" />
						</StackPanel>
					</Border>

					<!--  details of the clicked file, over the bottom of the graph (Penpot: Details)  -->
					<Border pp:Id="graph.details"
						Height="320"
						Margin="8"
						Padding="12"
						VerticalAlignment="Bottom"
						Background="{ThemeResource HackSurfaceContainerHighBrush}"
						CornerRadius="{StaticResource HackPanelCornerRadius}"
						Visibility="{x:Bind ViewModel.IsDetailsOpen, Mode=OneWay}">
						<Grid ColumnSpacing="16">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="310" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  info card  -->
							<Grid RowSpacing="8">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<!--  the band takes the file kind's color, as the graph box does; white text passes contrast on every kind  -->
								<Border
									Padding="12,6"
									Background="{x:Bind ViewModel.InfoHeaderBrush}"
									CornerRadius="8">
									<TextBlock
										Style="{StaticResource TitleSmall}"
										Foreground="White"
										Text="{x:Bind ViewModel.InfoName, Mode=OneWay}"
										TextTrimming="CharacterEllipsis" />
								</Border>
								<Grid Grid.Row="1" ColumnSpacing="12">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border
										Width="110"
										Height="90"
										Background="{ThemeResource HackSurfaceContainerBrush}"
										CornerRadius="8">
										<Grid>
											<Image Source="{x:Bind ViewModel.PreviewImage, Mode=OneWay}" Stretch="Uniform" />
											<TextBlock
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												Style="{StaticResource HackCaptionStyle}"
												Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}"
												Visibility="{x:Bind ViewModel.IsNoPreviewVisible, Mode=OneWay}" />
										</Grid>
									</Border>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock Style="{StaticResource InfoValue}" Text="{x:Bind ViewModel.InfoType, Mode=OneWay}" />
										<TextBlock Style="{StaticResource InfoValue}" Text="{x:Bind ViewModel.InfoSize, Mode=OneWay}" />
										<TextBlock Style="{StaticResource InfoValue}" Text="{x:Bind ViewModel.InfoVersions, Mode=OneWay}" />
										<TextBlock Style="{StaticResource InfoValue}" Text="{x:Bind ViewModel.InfoState, Mode=OneWay}" />
									</StackPanel>
								</Grid>
								<Grid
									Grid.Row="2"
									ColumnSpacing="4"
									RowSpacing="2">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock Style="{StaticResource InfoLabel}" Text="Folder" />
									<TextBlock
										Grid.Column="1"
										Style="{StaticResource InfoValue}"
										Text="{x:Bind ViewModel.InfoFolder, Mode=OneWay}"
										ToolTipService.ToolTip="{x:Bind ViewModel.InfoPathToolTip, Mode=OneWay}" />
									<TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Changed" />
									<TextBlock
										Grid.Row="1"
										Grid.Column="1"
										Style="{StaticResource InfoValue}"
										Text="{x:Bind ViewModel.InfoModified, Mode=OneWay}" />
									<TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Uses" />
									<TextBlock
										Grid.Row="2"
										Grid.Column="1"
										Style="{StaticResource InfoValue}"
										Text="{x:Bind ViewModel.InfoUses, Mode=OneWay}" />
									<TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="Used by" />
									<TextBlock
										Grid.Row="3"
										Grid.Column="1"
										Style="{StaticResource InfoValue}"
										Text="{x:Bind ViewModel.InfoUsedBy, Mode=OneWay}" />
								</Grid>
								<StackPanel pp:Id="graph.actions" Grid.Row="3" Orientation="Horizontal">
									<Button pp:Id="graph.graphAround"
										Command="{x:Bind ViewModel.FocusDetailNodeCommand}"
										Content="Graph around it"
										Style="{StaticResource FilledTonalButtonStyle}"
										ToolTipService.ToolTip="Draw the graph around this file (or double-click its box)" />
									<Button pp:Id="graph.showInFiles"
										Command="{x:Bind ViewModel.LocateDetailCommand}"
										Content="Show in file manager"
										Style="{StaticResource TextButtonStyle}" />
								</StackPanel>
							</Grid>

							<!--  the file manager's detail tables  -->
							<TabView
								x:Name="DetailTabs"
								Grid.Column="1"
								Margin="0,0,40,0"
								IsAddTabButtonVisible="False"
								TabWidthMode="SizeToContent">
								<TabView.Resources>
									<!--  Penpot: secondary tabs keep the selected label in On Surface; tighter padding so all five fit  -->
									<StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="HackSecondaryTabForegroundSelectedBrush" />
									<Thickness x:Key="TabViewItemHeaderPadding">12,0,12,0</Thickness>
								</TabView.Resources>
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.HistoryRows}">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="80" Header="Version">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="96" Header="Mod User">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModUser}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="156" Header="Mod Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="80" Header="Size">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Size, Converter={StaticResource FileSizeFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn MinWidth="88" Width="*" Header="Rel Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind RelDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.ParentRows}">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" CellTemplate="{StaticResource RelatedVersionTemplate}" Header="Version" />
											<tv:TableViewTemplateColumn Width="200" CellTemplate="{StaticResource RelatedNameTemplate}" Header="Name" />
											<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource RelatedPathTemplate}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.ChildRows}">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" CellTemplate="{StaticResource ChildVersionTemplate}" Header="Version" />
											<tv:TableViewTemplateColumn Width="200" CellTemplate="{StaticResource ChildNameTemplate}" Header="Name" />
											<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource ChildPathTemplate}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.PropertyRows}">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" Header="Version">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="150" Header="Property">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="140" Header="Configuration">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Configuration}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Type">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Type}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="*" Header="Value">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ValueData, Converter={StaticResource ValueFormatter}}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.VersionRows}">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="105" Header="Version Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="105" Header="File Size">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind FileSize, Converter={StaticResource FileSizeFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="115" Header="Directory Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind DirectoryId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Node Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind NodeId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Entry Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind EntryId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="125" Header="Attachment Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind AttachmentId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="155" Header="Modify Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModifyDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="180" Header="Checksum">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Checksum}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="260" Header="Odoo Complete Path">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind OdooCompletePath}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>

							<Button
								Grid.Column="1"
								Margin="0,8,0,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Command="{x:Bind ViewModel.CloseDetailsCommand}"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Close (Esc)">
								<FontIcon FontSize="14" Glyph="&#xE711;" />
							</Button>
						</Grid>
					</Border>
				</Grid>
			</Border>
			<TextBlock
				Grid.Row="2"
				Margin="4,0"
				Style="{StaticResource HackCaptionStyle}"
				Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
				TextTrimming="CharacterEllipsis" />
		</Grid>
		</Grid>
	</Grid>
</Page>
