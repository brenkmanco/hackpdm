<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.FileManager.HackFileManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tv="using:WinUI.TableView"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:conv="using:HackPDM.Common"
	xmlns:controls="using:HackPDM.Common"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:types="using:HackPDM.Common"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">



	<Page.Resources>
		<!--  Converter  -->
		<conv:FileSizeConverter x:Key="FileSizeFormatter" />
		<conv:LocalDateTimeConverter x:Key="LocalDateFormatter" />
		<conv:TypeIconConverter x:Key="TypeIcon" />
		<conv:StatusIconConverter x:Key="StatusIcon" />
		<conv:FileStatusDescriptionConverter x:Key="StatusDescription" />
		<conv:StatusRowBackgroundConverter x:Key="StatusRowBackground" />
		<conv:StatusTextBrushConverter x:Key="StatusTextBrush" />
		<!--  Icon Column Template  -->
		<DataTemplate x:Key="IconCellTemplate">
			<Canvas
				Width="28"
				Height="22"
				Margin="0,0,4,0"
				VerticalAlignment="Center"
				ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}">
				<Image
					Canvas.Left="0"
					Canvas.Top="1"
					Width="20"
					Height="20"
					Source="{Binding Type, Converter={StaticResource TypeIcon}}" />
				<Image
					Canvas.Left="10"
					Canvas.Top="0"
					Width="14"
					Height="14"
					Source="{Binding Status, Converter={StaticResource StatusIcon}}"
					Stretch="UniformToFill" />
			</Canvas>
		</DataTemplate>
		<!--  Status Column Template  -->
		<DataTemplate x:Key="StatusCellTemplate">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Foreground="{Binding Status, Converter={StaticResource StatusTextBrush}}"
				Text="{Binding Status}"
				ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}" />
		</DataTemplate>
		<!--  Size Column Template  -->
		<DataTemplate x:Key="SizeCellTemplate">
			<TextBlock
				Padding="5,0,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Text="{Binding Size, Converter={StaticResource FileSizeFormatter}}"
				TextAlignment="Right" />
		</DataTemplate>
		<!--  Grouped Entry List Templates  -->
		<DataTemplate x:Key="GroupHeaderTemplate">
			<Border
				Margin="0,4,0,2"
				Padding="10,6"
				Background="{ThemeResource SubtleFillColorSecondaryBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Grid ColumnSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<FontIcon
						Grid.Column="0"
						VerticalAlignment="Center"
						FontSize="10"
						Glyph="{Binding ChevronGlyph}" />
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						FontSize="12"
						FontWeight="SemiBold"
						Text="{Binding DisplayKey}"
						TextTrimming="CharacterEllipsis" />
					<Border
						Grid.Column="2"
						Padding="6,1"
						VerticalAlignment="Center"
						Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
						CornerRadius="8">
						<TextBlock
							FontSize="10"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{Binding CountText}" />
					</Border>
				</Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="GroupedEntryRowTemplate">
			<Grid
				MinHeight="26"
				Padding="14,1,6,1"
				Background="{Binding Status, Converter={StaticResource StatusRowBackground}}"
				ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="36" />
					<ColumnDefinition Width="*" MinWidth="160" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="105" />
					<ColumnDefinition Width="95" />
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="140" />
				</Grid.ColumnDefinitions>
				<Canvas
					Grid.Column="0"
					Width="28"
					Height="22"
					VerticalAlignment="Center"
					ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}">
					<Image
						Canvas.Left="0"
						Canvas.Top="1"
						Width="20"
						Height="20"
						Source="{Binding Type, Converter={StaticResource TypeIcon}}" />
					<Image
						Canvas.Left="10"
						Canvas.Top="0"
						Width="14"
						Height="14"
						Source="{Binding Status, Converter={StaticResource StatusIcon}}"
						Stretch="UniformToFill" />
				</Canvas>
				<TextBlock
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{Binding Name}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="2"
					VerticalAlignment="Center"
					Text="{Binding Type}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="3"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Text="{Binding Size, Converter={StaticResource FileSizeFormatter}}"
					TextAlignment="Right" />
				<TextBlock
					Grid.Column="4"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Foreground="{Binding Status, Converter={StaticResource StatusTextBrush}}"
					Text="{Binding Status}"
					TextTrimming="CharacterEllipsis"
					ToolTipService.ToolTip="{Binding Status, Converter={StaticResource StatusDescription}}" />
				<TextBlock
					Grid.Column="5"
					VerticalAlignment="Center"
					Text="{Binding Checkout}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="6"
					VerticalAlignment="Center"
					Text="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="7"
					VerticalAlignment="Center"
					Text="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>
		<controls:EntryGroupTemplateSelector
			x:Key="EntryGroupTemplateSelector"
			EntryRowTemplate="{StaticResource GroupedEntryRowTemplate}"
			GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}" />
		<!--  text keeps the theme's color (a fixed white was invisible on light presets)  -->
		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Normal" />
		</Style>
	</Page.Resources>

	<Grid
		Margin="12"
		CornerRadius="{StaticResource HackPanelCornerRadius}"
		RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Top Folder Navigation & Breadcrumb Bar  -->
		<Border
			x:Name="BreadcrumbHeaderCard"
			Grid.Row="0"
			Padding="6,4"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{StaticResource HackPanelStrokeBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid ColumnSpacing="6">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!--  Pane Toggle & Up Navigation  -->
				<StackPanel
					Grid.Column="0"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="2">
					<ToggleButton
						x:Name="ToggleFolderPaneButton"
						Padding="6,5"
						Click="ToggleFolderPane_Click"
						IsChecked="True"
						ToolTipService.ToolTip="Show or hide folder tree panel">
						<FontIcon FontSize="13" Glyph="&#xE8A0;" />
					</ToggleButton>
					<Button
						x:Name="NavigateUpButton"
						Padding="6,5"
						Click="NavigateUp_Click"
						IsEnabled="False"
						ToolTipService.ToolTip="Go up one folder (Alt+Up)">
						<FontIcon FontSize="12" Glyph="&#xE74A;" />
					</Button>
					<Border
						Width="1"
						Height="18"
						Margin="6,0,2,0"
						VerticalAlignment="Center"
						Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</StackPanel>

				<!--  Developed Breadcrumb Trail  -->
				<BreadcrumbBar
					x:Name="OdooDirectoryBreadcrumb"
					Grid.Column="1"
					VerticalAlignment="Center"
					ItemsSource="{x:Bind BreadcrumbPath}">
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:DataType="types:TreeData">
							<StackPanel
								Padding="4,2"
								Orientation="Horizontal"
								Spacing="6"
								ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
								<controls:FolderIcon
									VerticalAlignment="Center"
									IconSize="15"
									IsOpen="False"
									IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
									Origin="{x:Bind Origin, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
									Text="{x:Bind Name}" />
								<Border
									Padding="4,0"
									VerticalAlignment="Center"
									Background="#222EA043"
									BorderBrush="#552EA043"
									BorderThickness="1"
									CornerRadius="3"
									Visibility="{x:Bind LocalBadgeVisibility, Mode=OneWay}">
									<TextBlock
										FontSize="9"
										Foreground="#4CC36B"
										Text="Local" />
								</Border>
								<Border
									Padding="4,0"
									VerticalAlignment="Center"
									Background="#221F88E5"
									BorderBrush="#551F88E5"
									BorderThickness="1"
									CornerRadius="3"
									Visibility="{x:Bind RemoteBadgeVisibility, Mode=OneWay}">
									<TextBlock
										FontSize="9"
										Foreground="#58B4FF"
										Text="Server" />
								</Border>
							</StackPanel>
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>

				<!--  Breadcrumb Trail Actions & Status  -->
				<StackPanel
					Grid.Column="2"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="6">
					<Button
						x:Name="SubfolderMenuButton"
						Padding="8,4"
						Click="SubfolderMenuButton_Click"
						ToolTipService.ToolTip="Jump directly to a subfolder"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon FontSize="12" Glyph="&#xE8B7;" />
							<TextBlock
								x:Name="SubfolderMenuLabel"
								VerticalAlignment="Center"
								FontSize="11"
								Text="Subfolders" />
							<FontIcon FontSize="9" Glyph="&#xE70D;" />
						</StackPanel>
					</Button>
					<Button
						x:Name="CopyPathButton"
						Padding="8,4"
						Click="CopyPath_Click"
						ToolTipService.ToolTip="Copy current vault folder path">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon
								x:Name="CopyPathIcon"
								FontSize="12"
								Glyph="&#xE8C8;" />
							<TextBlock
								x:Name="CopyPathLabel"
								VerticalAlignment="Center"
								FontSize="11"
								Text="Copy path" />
						</StackPanel>
					</Button>
					<Border
						x:Name="CurrentFolderOriginPill"
						Padding="8,4"
						VerticalAlignment="Center"
						Background="{ThemeResource SubtleFillColorSecondaryBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="10"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<Ellipse
								x:Name="CurrentFolderOriginDot"
								Width="7"
								Height="7"
								VerticalAlignment="Center"
								Fill="#C69749" />
							<TextBlock
								x:Name="CurrentFolderOriginText"
								VerticalAlignment="Center"
								FontSize="11"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
						</StackPanel>
					</Border>
					<Button
						x:Name="LayoutMenuButton"
						Padding="8,4"
						ToolTipService.ToolTip="Rearrange or dock workspace panels">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon FontSize="12" Glyph="&#xE8A9;" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="11"
								Text="Layout" />
							<FontIcon FontSize="9" Glyph="&#xE70D;" />
						</StackPanel>
						<Button.Flyout>
							<MenuFlyout>
								<MenuFlyoutItem Click="PresetBalanced_Click" Text="Balanced (Folders Left · Details Bottom)" />
								<MenuFlyoutItem Click="PresetRightInspector_Click" Text="Widescreen (Inspector Right)" />
								<MenuFlyoutItem Click="PresetRightSidebar_Click" Text="Sidebar Right (Folders Right)" />
								<MenuFlyoutItem Click="PresetFocusEntries_Click" Text="Focus Files (Maximize List)" />
								<MenuFlyoutSeparator />
								<ToggleMenuFlyoutItem x:Name="MenuShowFolders" Click="MenuTogglePane_Click" Text="Folders Panel" />
								<ToggleMenuFlyoutItem x:Name="MenuShowDetails" Click="MenuTogglePane_Click" Text="Details Inspector" />
								<ToggleMenuFlyoutItem x:Name="MenuShowPreview" Click="MenuTogglePane_Click" Text="Preview Panel" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem Click="PresetBalanced_Click" Text="Reset Default Layout" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>
			</Grid>
		</Border>

		<!--  Rearrangeable & Dockable Workspace Container  -->
		<Grid x:Name="WorkspaceGrid" Grid.Row="1">
			<!--  Folders Pane Card  -->
			<Border
				x:Name="FoldersPaneCard"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{StaticResource HackPanelStrokeBrush}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Folder Tree Toolbar Header (Draggable Grip + Dock Actions)  -->
					<Border
						Grid.Row="0"
						Padding="8,6,6,6"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,0,0,1">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid
								x:Name="FoldersDragGrip"
								Grid.Column="0"
								Padding="2,2"
								Background="Transparent"
								PointerCanceled="PaneGrip_PointerCaptureLost"
								PointerCaptureLost="PaneGrip_PointerCaptureLost"
								PointerMoved="PaneGrip_PointerMoved"
								PointerPressed="FoldersGrip_PointerPressed"
								PointerReleased="PaneGrip_PointerReleased"
								Tag="Folders"
								ToolTipService.ToolTip="Drag to dock Folders Left or Right">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<Grid
										Width="8"
										Height="12"
										VerticalAlignment="Center"
										Opacity="0.45">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid.RowDefinitions>
											<RowDefinition Height="*" />
											<RowDefinition Height="*" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										<Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										<Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										<Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										<Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										<Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
									</Grid>
									<controls:FolderIcon
										IconSize="15"
										IsOpen="True"
										IsRoot="True"
										Origin="Synced" />
									<TextBlock
										VerticalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Text="Folders" />
								</StackPanel>
							</Grid>
							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="2">
								<ToggleButton
									x:Name="BranchLinesToggleButton"
									Padding="5,4"
									Click="BranchLinesToggle_Click"
									ToolTipService.ToolTip="Show or hide tree branching guide lines">
									<FontIcon FontSize="11" Glyph="&#xE8FD;" />
								</ToggleButton>
								<Button
									x:Name="ExpandAllButton"
									Padding="5,4"
									Click="ExpandAllFolders_Click"
									ToolTipService.ToolTip="Expand all folders">
									<FontIcon FontSize="10" Glyph="&#xE70D;" />
								</Button>
								<Button
									x:Name="CollapseAllButton"
									Padding="5,4"
									Click="CollapseAllFolders_Click"
									ToolTipService.ToolTip="Collapse all folders">
									<FontIcon FontSize="10" Glyph="&#xE70E;" />
								</Button>
								<Button
									x:Name="RefreshTreeButton"
									Padding="5,4"
									Click="Refresh_Click"
									ToolTipService.ToolTip="Refresh folder tree (F5)">
									<FontIcon FontSize="10" Glyph="&#xE72C;" />
								</Button>
								<Button
									Padding="5,4"
									ToolTipService.ToolTip="Dock options">
									<FontIcon FontSize="10" Glyph="&#xE712;" />
									<Button.Flyout>
										<MenuFlyout>
											<MenuFlyoutItem Click="DockFoldersLeft_Click" Text="Dock Left" />
											<MenuFlyoutItem Click="DockFoldersRight_Click" Text="Dock Right" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Click="HideFoldersPane_Click" Text="Hide Folders Panel" />
										</MenuFlyout>
									</Button.Flyout>
								</Button>
							</StackPanel>
						</Grid>
					</Border>

					<!--  Quick Folder Filter  -->
					<Grid Grid.Row="1" Margin="8,6,8,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox
							x:Name="FolderFilterBox"
							Grid.Column="0"
							MinHeight="28"
							Padding="8,4"
							FontSize="11"
							PlaceholderText="Filter folders…"
							TextChanged="FolderFilterBox_TextChanged" />
						<Button
							x:Name="ClearFilterButton"
							Grid.Column="1"
							Margin="4,0,0,0"
							Padding="6,4"
							Click="ClearFilterButton_Click"
							ToolTipService.ToolTip="Clear folder filter"
							Visibility="Collapsed">
							<FontIcon FontSize="10" Glyph="&#xE711;" />
						</Button>
					</Grid>

					<!--  TreeView  -->
					<Grid Grid.Row="2">
						<TreeView
							x:Name="OdooDirectoryTree"
							Padding="4,4"
							VerticalAlignment="Stretch"
							BorderThickness="0"
							CanDragItems="False"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							Visibility="Visible">
							<TreeView.Resources>
								<Thickness x:Key="TreeViewItemPresenterPadding">0,0,0,0</Thickness>
								<Thickness x:Key="TreeViewItemPresenterMargin">0,0,0,0</Thickness>
								<x:Double x:Key="TreeViewItemIndent">16</x:Double>
								<x:Double x:Key="TreeViewItemMinHeight">30</x:Double>
								<x:Double x:Key="TreeViewItemExpandCollapseChevronFontSize">11</x:Double>
							</TreeView.Resources>
							<TreeView.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutSubItem x:Name="TreeDownload" Text="Download">
										<MenuFlyoutItem x:Name="TreeDownloadAll" Text="All"
										Command="{x:Bind ViewModel.GetLatestDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreeDownloadTop" Text="Top Directory"
										Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeCheckout" Text="Checkout"
										Command="{x:Bind ViewModel.CheckoutDirectoryCommand}" />
									<MenuFlyoutItem x:Name="TreeUndoCheckout" Text="Undo Checkout"
										Command="{x:Bind ViewModel.UndoCheckoutDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeCommit" Text="Commit"
										Command="{x:Bind ViewModel.CommitDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeAnalyze" IsEnabled="False" Text="Analyze (Soon)" />
									<MenuFlyoutSeparator />
									<MenuFlyoutSubItem x:Name="TreeDelete" Text="Delete">
										<MenuFlyoutItem x:Name="TreeLocalDelete" Text="Local"
										Command="{x:Bind ViewModel.LocalDeleteDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreeLogicalDelete" Text="Logical"
										Command="{x:Bind ViewModel.LogicalDeleteDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreePermanentDelete" IsEnabled="False" Text="Permanent (Soon)" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="TreeUndelete" Text="Restore">
										<MenuFlyoutItem x:Name="TreeRestoreAll" Text="All"
										Command="{x:Bind ViewModel.RestoreDirectoryRecursiveCommand}" />
										<MenuFlyoutItem x:Name="TreeRestoreTop" Text="Top Directory"
										Command="{x:Bind ViewModel.RestoreDirectoryCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeOpenDirectory" Text="Open Directory"
										Command="{x:Bind ViewModel.OpenDirectoryCommand}" />
								</MenuFlyout>
							</TreeView.ContextFlyout>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="types:TreeData">
									<TreeViewItem
										MinHeight="30"
										Margin="0"
										Padding="0"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										Loaded="TreeViewItem_Loaded"
										ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
										<StackPanel
											VerticalAlignment="Stretch"
											Orientation="Horizontal">
											<controls:TreeBranchGuides
												VerticalAlignment="Stretch"
												BranchRevision="{x:Bind BranchRevision, Mode=OneWay}"
												IndentWidth="16"
												NodeData="{x:Bind}" />
											<controls:FolderIcon
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												IconSize="18"
												IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
												IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
												Origin="{x:Bind Origin, Mode=OneWay}" />
											<TextBlock
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
												Text="{x:Bind Name}" />
											<Border
												Margin="0,0,5,0"
												Padding="5,0"
												VerticalAlignment="Center"
												Background="{ThemeResource SubtleFillColorSecondaryBrush}"
												CornerRadius="8"
												Visibility="{x:Bind SubfolderCountVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Text="{x:Bind SubfolderCountText, Mode=OneWay}" />
											</Border>
											<Border
												Margin="0,0,4,0"
												Padding="4,0"
												VerticalAlignment="Center"
												Background="#222EA043"
												CornerRadius="4"
												Visibility="{x:Bind LocalBadgeVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="9"
													Foreground="#4CC36B"
													Text="Local" />
											</Border>
											<Border
												Margin="0,0,4,0"
												Padding="4,0"
												VerticalAlignment="Center"
												Background="#221F88E5"
												CornerRadius="4"
												Visibility="{x:Bind RemoteBadgeVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="9"
													Foreground="#58B4FF"
													Text="Server" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<!--  Empty Filter Hint  -->
						<StackPanel
							x:Name="EmptyTreeFilterPanel"
							Padding="16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Spacing="6"
							Visibility="Collapsed">
							<FontIcon
								HorizontalAlignment="Center"
								FontSize="20"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Glyph="&#xE8B7;" />
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="11"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="No matching folders" />
							<Button
								HorizontalAlignment="Center"
								Click="ClearFilterButton_Click"
								Content="Show all folders"
								FontSize="11" />
						</StackPanel>

						<!--  Folder Tree Loading Overlay  -->
						<Border
							x:Name="TreeLoadingOverlay"
							Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
							Visibility="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}">
							<Grid RowDefinitions="Auto,*">
								<ProgressBar
									Grid.Row="0"
									Margin="6,6,6,0"
									IsIndeterminate="True" />
								<StackPanel
									Grid.Row="1"
									Padding="16"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">
									<ProgressRing
										Width="30"
										Height="30"
										HorizontalAlignment="Center"
										IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" />
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Text="Loading Folders…" />
									<TextBlock
										HorizontalAlignment="Center"
										Foreground="{ThemeResource TextFillColorSecondaryBrush}"
										Text="{x:Bind ViewModel.TreeLoadingStatus, Mode=OneWay}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>

					<!--  Folder Tree Footer  -->
					<Border
						Grid.Row="3"
						Padding="10,5"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,1,0,0">
						<TextBlock
							x:Name="TreeSummaryText"
							FontSize="10"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Loading folders…"
							TextTrimming="CharacterEllipsis" />
					</Border>
				</Grid>
			</Border>

			<!--  Splitter: Folders <-> Workspace  -->
			<controls:PaneSplitter
				x:Name="FoldersSplitter"
				DragCompleted="OnSplitterDragCompleted"
				DragDelta="FoldersSplitter_DragDelta"
				Orientation="Vertical" />
			<!--  Primary File List Card  -->
			<Border
				x:Name="EntriesPaneCard"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{StaticResource HackPanelStrokeBrush}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  TabView for file lists + Integrated Toolbar Strip  -->
					<TabView
						x:Name="ListTabs"
						Grid.Row="0"
						IsAddTabButtonVisible="False">
						<TabView.TabStripFooter>
							<StackPanel
								Padding="6,2,8,2"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="4">
								<Button
									Padding="7,4"
									Click="Refresh_Click"
									ToolTipService.ToolTip="Refresh view (F5)">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<FontIcon FontSize="11" Glyph="&#xE72C;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Text="Refresh" />
									</StackPanel>
								</Button>
								<Button
									Padding="7,4"
									Click="Search_Click"
									ToolTipService.ToolTip="Search vault files (Ctrl+F)">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<FontIcon FontSize="11" Glyph="&#xE721;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Text="Search" />
									</StackPanel>
								</Button>
								<Border
									Width="1"
									Height="16"
									Margin="2,0"
									VerticalAlignment="Center"
									Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
								<ToggleButton
									x:Name="ToggleGroups"
									Padding="7,4"
									IsChecked="{x:Bind ViewModel.IsGroupingEnabled, Mode=TwoWay}"
									ToolTipService.ToolTip="Group entries by status or property">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<FontIcon FontSize="11" Glyph="&#xE8FD;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Text="Grouped" />
									</StackPanel>
								</ToggleButton>
								<ToggleButton
									x:Name="ShowInactive"
									Padding="7,4"
									IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
									ToolTipService.ToolTip="Show deleted/inactive files">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<FontIcon FontSize="11" Glyph="&#xE890;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Text="Inactive" />
									</StackPanel>
								</ToggleButton>
								<ToggleButton
									x:Name="Anchor"
									Padding="7,4"
									Checked="Anchor_Checked"
									ToolTipService.ToolTip="Keep window always on top"
									Unchecked="Anchor_Checked">
									<StackPanel Orientation="Horizontal" Spacing="5">
										<FontIcon FontSize="11" Glyph="&#xE718;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="11"
											Text="Pin" />
									</StackPanel>
								</ToggleButton>
								<Button
									x:Name="AdditionalTools"
									Padding="7,4"
									ToolTipService.ToolTip="Additional tools">
									<FontIcon FontSize="12" Glyph="&#xE712;" />
									<Button.Flyout>
										<MenuFlyout>
											<MenuFlyoutItem x:Name="OdooRefreshDropdown" Click="Refresh_Click" Text="Refresh View (F5)" />
											<MenuFlyoutItem x:Name="OdooSearchDropdown" Click="Search_Click" Text="Search (Ctrl+F)" />
											<MenuFlyoutItem x:Name="OdooManageTypesDropdown" Click="ManageTypes_Click" Text="Manage File Types" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem x:Name="ShowHidden" IsEnabled="False" Text="Ignore Filter (Soon)" />
											<MenuFlyoutItem x:Name="StatusWindowDropdown" Click="StatusWindow_Click" Text="Status Log" />
										</MenuFlyout>
									</Button.Flyout>
								</Button>
							</StackPanel>
						</TabView.TabStripFooter>

						<TabViewItem
							x:Name="RootEntryList"
							Header="Entries"
							IsClosable="False">
							<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
								<!--  headers and widths come from the saved column settings (ApplyColumnSettings), matched by SortMemberPath  -->
								<controls:EntryTableView
									x:Name="OdooEntryList"
									VerticalAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									AutoGenerateColumns="False"
									CanSortColumns="True"
									IsReadOnly="True"
									SelectionMode="Extended"
									SelectionUnit="Row"
									ShowDragRectangle="False">
									<tv:TableView.Columns>
										<tv:TableViewTemplateColumn
											Width="38"
											CanReorder="True"
											CanResize="True"
											CellTemplate="{StaticResource IconCellTemplate}" />
										<tv:TableViewTextColumn Binding="{Binding Name}" SortMemberPath="Name" />
										<tv:TableViewTextColumn Binding="{Binding Type}" SortMemberPath="Type" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource SizeCellTemplate}" SortMemberPath="Size" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource StatusCellTemplate}" SortMemberPath="Status" />
										<tv:TableViewTextColumn Binding="{Binding Checkout}" SortMemberPath="Checkout" />
										<tv:TableViewTextColumn Binding="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}" SortMemberPath="LocalDate" />
										<tv:TableViewTextColumn Binding="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}" SortMemberPath="RemoteDate" />
										<tv:TableViewTextColumn Binding="{Binding FullName}" SortMemberPath="FullName" />
									</tv:TableView.Columns>
									<tv:TableView.ContextFlyout>
										<MenuFlyout>
											<MenuFlyoutSubItem x:Name="EntryOpen" Text="Open">
												<MenuFlyoutItem Text="Preview Latest Remote" Command="{x:Bind ViewModel.OpenSelectedLatestRemoteCommand}" />
												<MenuFlyoutItem Text="Latest Local" Command="{x:Bind ViewModel.OpenSelectedLatestLocalCommand}" />
												<MenuFlyoutItem Text="File Directory" Command="{x:Bind ViewModel.OpenSelectedFoldersCommand}" />
											</MenuFlyoutSubItem>
											<MenuFlyoutItem Text="Download" Command="{x:Bind ViewModel.GetLatestSelectedCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Text="Checkout" Command="{x:Bind ViewModel.CheckoutSelectedCommand}" />
											<MenuFlyoutItem Text="Undo Checkout" Command="{x:Bind ViewModel.UndoCheckoutSelectedCommand}" />
											<MenuFlyoutSeparator />
											<!--  one item per EntryRowKeys.Names, added by the view  -->
											<MenuFlyoutSubItem x:Name="EntryGroupBy" Text="Group By" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Text="Commit" Command="{x:Bind ViewModel.CommitSelectedCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem IsEnabled="False" Text="Restore (Soon)" />
											<MenuFlyoutItem Text="Upload Preview Image" Command="{x:Bind ViewModel.UploadPreviewImageCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutSubItem x:Name="EntryDelete" Text="Delete">
												<MenuFlyoutItem Text="Local" Command="{x:Bind ViewModel.LocalDeleteSelectedCommand}" />
												<MenuFlyoutItem Text="Logical" Command="{x:Bind ViewModel.LogicalDeleteSelectedCommand}" />
												<MenuFlyoutItem Text="Permanent" Command="{x:Bind ViewModel.PermanentDeleteSelectedCommand}" />
											</MenuFlyoutSubItem>
										</MenuFlyout>
									</tv:TableView.ContextFlyout>
								</controls:EntryTableView>

								<!--  Grouped entry list (used on non-Windows targets where TableView.GroupDescriptions is unavailable)  -->
								<Grid
									x:Name="GroupedEntryContainer"
									Visibility="Collapsed">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>
									<Border
										Grid.Row="0"
										Padding="8,4"
										Background="{ThemeResource SubtleFillColorTertiaryBrush}"
										BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
										BorderThickness="0,0,0,1">
										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel
												Grid.Column="0"
												VerticalAlignment="Center"
												Orientation="Horizontal"
												Spacing="6">
												<FontIcon FontSize="11" Glyph="&#xE8FD;" />
												<TextBlock
													x:Name="GroupedByLabel"
													VerticalAlignment="Center"
													FontSize="11"
													FontWeight="SemiBold"
													Text="Grouped by Status" />
											</StackPanel>
											<StackPanel
												Grid.Column="1"
												VerticalAlignment="Center"
												Orientation="Horizontal"
												Spacing="4">
												<Button
													x:Name="GroupByMenuButton"
													Padding="7,3"
													ToolTipService.ToolTip="Choose field to group by">
													<StackPanel Orientation="Horizontal" Spacing="4">
														<TextBlock FontSize="11" Text="Group by" />
														<FontIcon FontSize="9" Glyph="&#xE70D;" />
													</StackPanel>
													<Button.Flyout>
														<MenuFlyout x:Name="GroupByToolbarFlyout" />
													</Button.Flyout>
												</Button>
												<Button
													Padding="6,3"
													Click="ExpandAllGroups_Click"
													ToolTipService.ToolTip="Expand all groups">
													<FontIcon FontSize="10" Glyph="&#xE70D;" />
												</Button>
												<Button
													Padding="6,3"
													Click="CollapseAllGroups_Click"
													ToolTipService.ToolTip="Collapse all groups">
													<FontIcon FontSize="10" Glyph="&#xE70E;" />
												</Button>
											</StackPanel>
										</Grid>
									</Border>
									<Border
										Grid.Row="1"
										Padding="14,3,6,3"
										BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
										BorderThickness="0,0,0,1">
										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="36" />
												<ColumnDefinition Width="*" MinWidth="160" />
												<ColumnDefinition Width="75" />
												<ColumnDefinition Width="75" />
												<ColumnDefinition Width="105" />
												<ColumnDefinition Width="95" />
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="140" />
											</Grid.ColumnDefinitions>
											<Button Grid.Column="1" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Name" FontSize="11" FontWeight="SemiBold" Tag="Name" />
											<Button Grid.Column="2" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Type" FontSize="11" FontWeight="SemiBold" Tag="Type" />
											<Button Grid.Column="3" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Size" FontSize="11" FontWeight="SemiBold" Tag="Size" />
											<Button Grid.Column="4" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Status" FontSize="11" FontWeight="SemiBold" Tag="Status" />
											<Button Grid.Column="5" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Checkout" FontSize="11" FontWeight="SemiBold" Tag="Checkout" />
											<Button Grid.Column="6" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Local Date" FontSize="11" FontWeight="SemiBold" Tag="LocalDate" />
											<Button Grid.Column="7" Padding="2,1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Click="GroupedSortColumn_Click" Content="Remote Date" FontSize="11" FontWeight="SemiBold" Tag="RemoteDate" />
										</Grid>
									</Border>
									<ListView
										x:Name="GroupedEntryList"
										Grid.Row="2"
										HorizontalContentAlignment="Stretch"
										IsItemClickEnabled="True"
										ItemTemplateSelector="{StaticResource EntryGroupTemplateSelector}"
										SelectionMode="Extended">
										<ListView.ItemContainerStyle>
											<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
												<Setter Property="HorizontalContentAlignment" Value="Stretch" />
												<Setter Property="Padding" Value="4,0" />
												<Setter Property="MinHeight" Value="0" />
											</Style>
										</ListView.ItemContainerStyle>
									</ListView>
								</Grid>

								<!--  Top Progress Strip & Centered Entry Loading Card  -->
								<ProgressBar
									Height="3"
									VerticalAlignment="Top"
									IsHitTestVisible="False"
									IsIndeterminate="{x:Bind ViewModel.IsEntriesProgressIndeterminate, Mode=OneWay}"
									Maximum="100"
									Minimum="0"
									Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}"
									Value="{x:Bind ViewModel.EntriesLoadingPercent, Mode=OneWay}" />

								<Border
									x:Name="EntriesLoadingOverlay"
									MinWidth="300"
									Padding="24,18"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}">
									<StackPanel HorizontalAlignment="Center" Spacing="10">
										<ProgressRing
											Width="32"
											Height="32"
											HorizontalAlignment="Center"
											IsActive="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}" />
										<TextBlock
											HorizontalAlignment="Center"
											FontSize="13"
											FontWeight="SemiBold"
											Text="{x:Bind ViewModel.EntriesLoadingStatus, Mode=OneWay}"
											TextAlignment="Center" />
										<ProgressBar
											Width="240"
											IsIndeterminate="{x:Bind ViewModel.IsEntriesProgressIndeterminate, Mode=OneWay}"
											Maximum="100"
											Minimum="0"
											Value="{x:Bind ViewModel.EntriesLoadingPercent, Mode=OneWay}" />
									</StackPanel>
								</Border>

								<TextBlock
									x:Name="EmptyFolderHint"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="13"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									IsHitTestVisible="False"
									Text="This folder has no entries"
									Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
							</Grid>
						</TabViewItem>
						<TabViewItem
							x:Name="ChangesTab"
							Header="{x:Bind ViewModel.ChangesTabHeader, Mode=OneWay}"
							IsClosable="False">
							<Grid Padding="8" ColumnSpacing="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Border
									Grid.Column="0"
									Padding="10"
									Background="{ThemeResource LayerFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="6">
									<Grid RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="SemiBold"
												Text="{x:Bind ViewModel.LocalChangesHeader, Mode=OneWay}" />
											<Button
												Grid.Column="1"
												Padding="10,4"
												Command="{x:Bind ViewModel.CommitDirectoryCommand}"
												Content="Commit Folder" />
										</Grid>
										<tv:TableView
											x:Name="HackChangesList"
											Grid.Row="1"
											AutoGenerateColumns="False"
											IsReadOnly="True"
											ItemsSource="{x:Bind ViewModel.LocalChanges}">
											<tv:TableView.Columns>
												<tv:TableViewTextColumn Width="130" Binding="{Binding Name}" Header="File Name" />
												<tv:TableViewTextColumn Width="*" Binding="{Binding Status, Converter={StaticResource StatusDescription}}" Header="Status" />
												<tv:TableViewTextColumn Width="78" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
												<tv:TableViewTextColumn Width="152" Binding="{Binding LocalDate, Converter={StaticResource LocalDateFormatter}}" Header="Local Date" />
											</tv:TableView.Columns>
										</tv:TableView>
									</Grid>
								</Border>

								<Border
									Grid.Column="1"
									Padding="10"
									Background="{ThemeResource LayerFillColorDefaultBrush}"
									BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
									BorderThickness="1"
									CornerRadius="6">
									<Grid RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="SemiBold"
												Text="{x:Bind ViewModel.RemoteChangesHeader, Mode=OneWay}" />
											<Button
												Grid.Column="1"
												Padding="10,4"
												Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}"
												Content="Download Folder" />
										</Grid>
										<tv:TableView
											x:Name="OdooChangesList"
											Grid.Row="1"
											AutoGenerateColumns="False"
											IsReadOnly="True"
											ItemsSource="{x:Bind ViewModel.RemoteChanges}">
											<tv:TableView.Columns>
												<tv:TableViewTextColumn Width="130" Binding="{Binding Name}" Header="File Name" />
												<tv:TableViewTextColumn Width="*" Binding="{Binding Status, Converter={StaticResource StatusDescription}}" Header="Status" />
												<tv:TableViewTextColumn Width="78" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
												<tv:TableViewTextColumn Width="152" Binding="{Binding RemoteDate, Converter={StaticResource LocalDateFormatter}}" Header="Remote Date" />
											</tv:TableView.Columns>
										</tv:TableView>
									</Grid>
								</Border>
							</Grid>
						</TabViewItem>
					</TabView>

					<!--  Entries Pane Compact Summary Strip  -->
					<Border
						Grid.Row="1"
						Padding="10,5"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,1,0,0">
						<Grid ColumnDefinitions="Auto,*">
							<StackPanel
								Grid.Column="0"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="14">
								<TextBlock
									x:Name="EntryListStatus"
									VerticalAlignment="Center"
									FontWeight="SemiBold"
									Text="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}" />
								<TextBlock
									x:Name="EntryListModified"
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind ViewModel.EntriesLabelModified, Mode=OneWay}" />
								<TextBlock
									x:Name="EntryListLocalOnly"
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind ViewModel.EntriesLabelLocal, Mode=OneWay}" />
								<TextBlock
									x:Name="EntryListRemoteOnly"
									VerticalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind ViewModel.EntriesLabelRemote, Mode=OneWay}" />
							</StackPanel>
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}"
								TextTrimming="CharacterEllipsis" />
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!--  Splitter: Entries <-> Details+Preview Inspector Host  -->
			<controls:PaneSplitter
				x:Name="InspectorSplitter"
				DragCompleted="OnSplitterDragCompleted"
				DragDelta="InspectorSplitter_DragDelta"
				Orientation="Horizontal" />

			<!--  Dockable Inspector Host (Details + Preview, horizontal when Bottom or vertical when Right)  -->
			<Grid x:Name="DetailsAndPreviewHost">
				<!--  Details Inspector Card  -->
				<Border
					x:Name="DetailsPaneCard"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{StaticResource HackPanelStrokeBrush}"
					BorderThickness="{StaticResource HackPanelBorderThickness}"
					CornerRadius="{StaticResource HackPanelCornerRadius}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  Details Header Strip (Draggable Grip + Dock Actions)  -->
						<Border
							Grid.Row="0"
							Padding="8,5,6,5"
							BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
							BorderThickness="0,0,0,1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid
									x:Name="DetailsDragGrip"
									Grid.Column="0"
									Padding="2,2"
									Background="Transparent"
									PointerCanceled="PaneGrip_PointerCaptureLost"
									PointerCaptureLost="PaneGrip_PointerCaptureLost"
									PointerMoved="PaneGrip_PointerMoved"
									PointerPressed="DetailsGrip_PointerPressed"
									PointerReleased="PaneGrip_PointerReleased"
									Tag="Details"
									ToolTipService.ToolTip="Drag to dock Inspector Bottom or Right">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Grid
											Width="8"
											Height="12"
											VerticalAlignment="Center"
											Opacity="0.45">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										</Grid>
										<FontIcon FontSize="12" Glyph="&#xE946;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="12"
											FontWeight="SemiBold"
											Text="Inspector" />
									</StackPanel>
								</Grid>
								<StackPanel
									Grid.Column="1"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Spacing="2">
									<Button
										x:Name="SwapInspectorDockButton"
										Padding="5,3"
										Click="ToggleInspectorDock_Click"
										ToolTipService.ToolTip="Switch Inspector between Bottom and Right dock">
										<FontIcon FontSize="11" Glyph="&#xE8A9;" />
									</Button>
									<Button
										Padding="5,3"
										ToolTipService.ToolTip="Inspector dock options">
										<FontIcon FontSize="10" Glyph="&#xE712;" />
										<Button.Flyout>
											<MenuFlyout>
												<MenuFlyoutItem Click="DockInspectorBottom_Click" Text="Dock Bottom" />
												<MenuFlyoutItem Click="DockInspectorRight_Click" Text="Dock Right" />
												<MenuFlyoutItem Click="SwapPreviewPlacement_Click" Text="Swap Details / Preview" />
												<MenuFlyoutSeparator />
												<MenuFlyoutItem Click="HideDetailsPane_Click" Text="Hide Inspector" />
											</MenuFlyout>
										</Button.Flyout>
									</Button>
									<Button
										Padding="5,3"
										Click="HideDetailsPane_Click"
										ToolTipService.ToolTip="Hide Inspector">
										<FontIcon FontSize="10" Glyph="&#xE711;" />
									</Button>
								</StackPanel>
							</Grid>
						</Border>

						<Grid Grid.Row="1">
							<TabView
								x:Name="VersionTabs"
								VerticalAlignment="Stretch"
								IsAddTabButtonVisible="False"
								SelectionChanged="VersionTabs_SelectionChanged">
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<tv:TableView
										x:Name="OdooHistory"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OHistories}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="135" Binding="{Binding ModUser}" Header="Mod User" />
											<tv:TableViewTextColumn Width="155" Binding="{Binding ModDate, Converter={StaticResource LocalDateFormatter}}" Header="Mod Date" />
											<tv:TableViewTextColumn Width="105" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
											<tv:TableViewTextColumn MinWidth="115" Width="*" Binding="{Binding RelDate, Converter={StaticResource LocalDateFormatter}}" Header="Rel Date" />
										</tv:TableView.Columns>
										<tv:TableView.ContextFlyout>
											<MenuFlyout x:Name="HistoryContextMenu">
												<MenuFlyoutSubItem x:Name="HistoryDownload" Text="Download">
													<MenuFlyoutItem x:Name="HistoryDownloadTemp" Text="Temporary"
													Command="{x:Bind ViewModel.DownloadHistoryToTempCommand}" />
													<MenuFlyoutItem x:Name="HistoryDownloadOverwrite" Text="Overwrite"
													Command="{x:Bind ViewModel.DownloadHistoryOverwriteCommand}" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem x:Name="HistoryOpen" Text="Open">
													<MenuFlyoutItem x:Name="HistoryOpenTemp" Text="Temporary"
													Command="{x:Bind ViewModel.OpenHistoryFromTempCommand}" />
													<MenuFlyoutItem x:Name="HistoryOpenOverwrite" Text="Overwrite"
													Command="{x:Bind ViewModel.OpenHistoryOverwriteCommand}" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem x:Name="HistoryMove" Text="Move">
													<MenuFlyoutItem x:Name="HistoryMoveTemp" Text="Temporary"
													Command="{x:Bind ViewModel.MoveHistoryToTempCommand}" />
													<MenuFlyoutItem x:Name="HistoryMoveOverwrite" Text="Overwrite"
													Command="{x:Bind ViewModel.MoveHistoryToWorkingCommand}" />
												</MenuFlyoutSubItem>
											</MenuFlyout>
										</tv:TableView.ContextFlyout>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<tv:TableView
										x:Name="OdooParents"
										AutoGenerateColumns="False"
										CanSortColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OParents}"
										RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="220" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<controls:EntryTableView
										x:Name="OdooChildren"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OChildren}"
										RowDetailsVisibilityMode="Collapsed"
										SelectionMode="Extended"
										SelectionUnit="Row"
										ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="220" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</controls:EntryTableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView
										x:Name="OdooProperties"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OProperties}"
										RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="160" Binding="{Binding Name}" Header="Property" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding Configuration}" Header="Configuration" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding Type}" Header="Type" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding ValueData}" Header="Value" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView
										x:Name="OdooVersionInfoList"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OVersions}"
										RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="105" Binding="{Binding Id}" Header="Version Id" />
											<tv:TableViewTextColumn Width="105" Binding="{Binding FileSize, Converter={StaticResource FileSizeFormatter}}" Header="File Size" />
											<tv:TableViewTextColumn Width="115" Binding="{Binding DirectoryId}" Header="Directory Id" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding NodeId}" Header="Node Id" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding EntryId}" Header="Entry Id" />
											<tv:TableViewTextColumn Width="125" Binding="{Binding AttachmentId}" Header="Attachment Id" />
											<tv:TableViewTextColumn Width="155" Binding="{Binding ModifyDate, Converter={StaticResource LocalDateFormatter}}" Header="Modify Date" />
											<tv:TableViewTextColumn Width="180" Binding="{Binding Checksum}" Header="Checksum" />
											<tv:TableViewTextColumn Width="260" Binding="{Binding OdooCompletePath}" Header="Odoo Complete Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>
							<ProgressBar
								Height="3"
								VerticalAlignment="Top"
								IsHitTestVisible="False"
								IsIndeterminate="True"
								Visibility="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" />
						</Grid>
					</Grid>
				</Border>

				<!--  Splitter: Details <-> Preview  -->
				<controls:PaneSplitter
					x:Name="DetailsPreviewSplitter"
					DragCompleted="OnSplitterDragCompleted"
					DragDelta="DetailsPreviewSplitter_DragDelta"
					Orientation="Vertical" />

				<!--  Preview Card  -->
				<Border
					x:Name="PreviewPaneCard"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
					BorderBrush="{StaticResource HackPanelStrokeBrush}"
					BorderThickness="{StaticResource HackPanelBorderThickness}"
					CornerRadius="{StaticResource HackPanelCornerRadius}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  Preview Header Strip (Draggable Grip + PiP + Dock Actions)  -->
						<Border
							Grid.Row="0"
							Padding="8,5,6,5"
							BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
							BorderThickness="0,0,0,1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid
									x:Name="PreviewDragGrip"
									Grid.Column="0"
									Padding="2,2"
									Background="Transparent"
									PointerCanceled="PaneGrip_PointerCaptureLost"
									PointerCaptureLost="PaneGrip_PointerCaptureLost"
									PointerMoved="PaneGrip_PointerMoved"
									PointerPressed="PreviewGrip_PointerPressed"
									PointerReleased="PaneGrip_PointerReleased"
									Tag="Preview"
									ToolTipService.ToolTip="Drag to swap Preview position or dock">
									<StackPanel Orientation="Horizontal" Spacing="6">
										<Grid
											Width="8"
											Height="12"
											VerticalAlignment="Center"
											Opacity="0.45">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
										</Grid>
										<FontIcon FontSize="12" Glyph="&#xE8B9;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="12"
											FontWeight="SemiBold"
											Text="Preview" />
									</StackPanel>
								</Grid>
								<StackPanel
									Grid.Column="1"
									VerticalAlignment="Center"
									Orientation="Horizontal"
									Spacing="2">
									<Button
										x:Name="UploadPreviewButton"
										Padding="5,3"
										Command="{x:Bind ViewModel.UploadPreviewImageCommand}"
										ToolTipService.ToolTip="Upload custom preview image for selected committed file">
										<FontIcon FontSize="11" Glyph="&#xE898;" />
									</Button>
									<Button
										x:Name="EnterPipButton"
										Padding="5,3"
										Click="OnTogglePipClicked"
										ToolTipService.ToolTip="Pop preview into Picture-in-Picture window">
										<FontIcon FontSize="11" Glyph="&#xE73F;" />
									</Button>
									<Button
										Padding="5,3"
										Click="SwapPreviewPlacement_Click"
										ToolTipService.ToolTip="Swap Preview and Details positions">
										<FontIcon FontSize="11" Glyph="&#xE8AB;" />
									</Button>
									<Button
										Padding="5,3"
										Click="HidePreviewPane_Click"
										ToolTipService.ToolTip="Hide Preview panel">
										<FontIcon FontSize="10" Glyph="&#xE711;" />
									</Button>
								</StackPanel>
							</Grid>
						</Border>

						<Grid
							x:Name="ImageSlot"
							Grid.Row="1"
							Margin="8"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch">
							<StackPanel
								x:Name="NoPreviewPanel"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								Spacing="8">
								<ProgressRing
									x:Name="LoadRing"
									Width="30"
									Height="30"
									HorizontalAlignment="Center"
									IsActive="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}"
									Visibility="{x:Bind ViewModel.IsPreviewLoading, Mode=OneWay}" />
								<TextBlock
									x:Name="NoPreviewText"
									HorizontalAlignment="Center"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}"
									TextAlignment="Center" />
							</StackPanel>
							<Image
								x:Name="OdooEntryImage"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch"
								Stretch="Uniform"
								Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}" />
						</Grid>
					</Grid>
				</Border>
			</Grid>
		</Grid>

		<!--  Interactive Drag-to-Dock Drop Zone Overlay (sibling of WorkspaceGrid so it always spans the full workspace)  -->
		<Grid
			x:Name="DockDropOverlay"
			Grid.Row="1"
			IsHitTestVisible="False"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border
				x:Name="ZoneLeft"
				Grid.Row="0"
				Grid.RowSpan="2"
				Grid.Column="0"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Left" />
			</Border>

			<Border
				x:Name="ZoneRight"
				Grid.Row="0"
				Grid.RowSpan="2"
				Grid.Column="2"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Right" />
			</Border>

			<Border
				x:Name="ZoneBottom"
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Bottom" />
			</Border>

			<Border
				x:Name="ZoneSwapPreview"
				Grid.Row="1"
				Grid.Column="1"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Swap Preview / Details" />
			</Border>
		</Grid>
	</Grid>

</Page>
