<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.FileManager.HackFileManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tv="using:WinUI.TableView"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:conv="using:HackPDM.Common"
	xmlns:controls="using:HackPDM.Common"
	xmlns:graph="using:HackPDM.Graph"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:pp="urn:wyrmpdm:penpot-sync"
	xmlns:rep="using:HackPDM.Core.Services"
	xmlns:types="using:HackPDM.Common"
	xmlns:ut="using:Uno.Themes"
	xmlns:utu="using:Uno.Toolkit.UI"
	Background="{ThemeResource BackgroundBrush}"
	mc:Ignorable="d pp">



	<Page.Resources>
		<!--  Converter  -->
		<conv:FileSizeConverter x:Key="FileSizeFormatter" />
		<conv:LocalDateTimeConverter x:Key="LocalDateFormatter" />
		<conv:TypeIconConverter x:Key="TypeIcon" />
		<conv:StatusIconConverter x:Key="StatusIcon" />
		<conv:FileStatusDescriptionConverter x:Key="StatusDescription" />
		<conv:StatusRowBackgroundConverter x:Key="StatusRowBackground" />
		<conv:StatusTextBrushConverter x:Key="StatusTextBrush" />
		<graph:ValueTextConverter x:Key="ValueFormatter" />
		<!--  Icon Column Template  -->
		<DataTemplate x:Key="IconCellTemplate" x:DataType="rep:EntryRow">
			<Canvas
				Width="28"
				Height="22"
				Margin="0,0,4,0"
				VerticalAlignment="Center"
				ToolTipService.ToolTip="{x:Bind Status, Converter={StaticResource StatusDescription}}">
				<Image
					Canvas.Left="0"
					Canvas.Top="1"
					Width="20"
					Height="20"
					Source="{x:Bind Type, Converter={StaticResource TypeIcon}}" />
				<Image
					Canvas.Left="10"
					Canvas.Top="0"
					Width="14"
					Height="14"
					Source="{x:Bind Status, Converter={StaticResource StatusIcon}}"
					Stretch="UniformToFill" />
			</Canvas>
		</DataTemplate>
		<!--  Status Column Template  -->
		<DataTemplate x:Key="StatusCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				FontWeight="SemiBold"
				Foreground="{x:Bind Status, Converter={StaticResource StatusTextBrush}}"
				Text="{x:Bind StatusText}"
				ToolTipService.ToolTip="{x:Bind Status, Converter={StaticResource StatusDescription}}" />
		</DataTemplate>
		<!--  Size Column Template  -->
		<DataTemplate x:Key="SizeCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="5,0,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Center"
				Text="{x:Bind Size, Converter={StaticResource FileSizeFormatter}}"
				TextAlignment="Right" />
		</DataTemplate>
		<!--  Compiled Entry / Changes Cell Templates  -->
		<DataTemplate x:Key="EntryNameCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind Name}"
				TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="EntryTypeCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind Type}"
				TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="EntryCheckoutCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind CheckoutText}"
				TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="EntryLocalDateCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind LocalDate, Converter={StaticResource LocalDateFormatter}}" />
		</DataTemplate>
		<DataTemplate x:Key="EntryRemoteDateCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind RemoteDate, Converter={StaticResource LocalDateFormatter}}" />
		</DataTemplate>
		<DataTemplate x:Key="EntryFullNameCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind FullName}"
				TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChangesStatusCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind Status, Converter={StaticResource StatusDescription}}"
				TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChangesSizeCellTemplate" x:DataType="rep:EntryRow">
			<TextBlock
				Padding="4,0,4,0"
				VerticalAlignment="Center"
				Text="{x:Bind Size, Converter={StaticResource FileSizeFormatter}}" />
		</DataTemplate>
		<DataTemplate x:Key="ParentVersionCellTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
		</DataTemplate>
		<DataTemplate x:Key="ParentNameCellTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ParentPathCellTemplate" x:DataType="rep:ParentRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind BasePath}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChildVersionCellTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
		</DataTemplate>
		<DataTemplate x:Key="ChildNameCellTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<DataTemplate x:Key="ChildPathCellTemplate" x:DataType="rep:ChildrenRow">
			<TextBlock VerticalAlignment="Center" Text="{x:Bind BasePath}" TextTrimming="CharacterEllipsis" />
		</DataTemplate>
		<!--  Grouped Entry List Templates  -->
		<DataTemplate x:Key="GroupHeaderTemplate" x:DataType="types:EntryGroupHeader">
			<Border
				Margin="0,4,0,2"
				Padding="10,6"
				Background="{ThemeResource HackSurfaceContainerHighBrush}"
				BorderBrush="{ThemeResource OutlineVariantBrush}"
				BorderThickness="1"
				CornerRadius="4">
				<Grid ColumnSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<FontIcon
						Grid.Column="0"
						VerticalAlignment="Center"
						FontSize="10"
						Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" />
					<TextBlock
						Grid.Column="1"
						VerticalAlignment="Center"
						FontSize="12"
						FontWeight="SemiBold"
						Text="{x:Bind DisplayKey}"
						TextTrimming="CharacterEllipsis" />
					<Border
						Grid.Column="2"
						Padding="6,1"
						VerticalAlignment="Center"
						Background="{ThemeResource SurfaceBrush}"
						CornerRadius="8">
						<TextBlock
							FontSize="10"
							Foreground="{ThemeResource OnSurfaceVariantBrush}"
							Text="{x:Bind CountText}" />
					</Border>
				</Grid>
			</Border>
		</DataTemplate>
		<DataTemplate x:Key="GroupedEntryRowTemplate" x:DataType="rep:EntryRow">
			<Grid
				MinHeight="26"
				Padding="14,1,6,1"
				Background="{x:Bind Status, Converter={StaticResource StatusRowBackground}}"
				ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="36" />
					<ColumnDefinition Width="*" MinWidth="160" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="75" />
					<ColumnDefinition Width="105" />
					<ColumnDefinition Width="95" />
					<ColumnDefinition Width="140" />
					<ColumnDefinition Width="140" />
				</Grid.ColumnDefinitions>
				<Canvas
					Grid.Column="0"
					Width="28"
					Height="22"
					VerticalAlignment="Center"
					ToolTipService.ToolTip="{x:Bind Status, Converter={StaticResource StatusDescription}}">
					<Image
						Canvas.Left="0"
						Canvas.Top="1"
						Width="20"
						Height="20"
						Source="{x:Bind Type, Converter={StaticResource TypeIcon}}" />
					<Image
						Canvas.Left="10"
						Canvas.Top="0"
						Width="14"
						Height="14"
						Source="{x:Bind Status, Converter={StaticResource StatusIcon}}"
						Stretch="UniformToFill" />
				</Canvas>
				<TextBlock
					Grid.Column="1"
					VerticalAlignment="Center"
					Text="{x:Bind Name}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="2"
					VerticalAlignment="Center"
					Text="{x:Bind Type}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="3"
					HorizontalAlignment="Right"
					VerticalAlignment="Center"
					Text="{x:Bind Size, Converter={StaticResource FileSizeFormatter}}"
					TextAlignment="Right" />
				<TextBlock
					Grid.Column="4"
					VerticalAlignment="Center"
					FontWeight="SemiBold"
					Foreground="{x:Bind Status, Converter={StaticResource StatusTextBrush}}"
					Text="{x:Bind StatusText}"
					TextTrimming="CharacterEllipsis"
					ToolTipService.ToolTip="{x:Bind Status, Converter={StaticResource StatusDescription}}" />
				<TextBlock
					Grid.Column="5"
					VerticalAlignment="Center"
					Text="{x:Bind CheckoutText}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="6"
					VerticalAlignment="Center"
					Text="{x:Bind LocalDate, Converter={StaticResource LocalDateFormatter}}"
					TextTrimming="CharacterEllipsis" />
				<TextBlock
					Grid.Column="7"
					VerticalAlignment="Center"
					Text="{x:Bind RemoteDate, Converter={StaticResource LocalDateFormatter}}"
					TextTrimming="CharacterEllipsis" />
			</Grid>
		</DataTemplate>
		<controls:EntryGroupTemplateSelector
			x:Key="EntryGroupTemplateSelector"
			EntryRowTemplate="{StaticResource GroupedEntryRowTemplate}"
			GroupHeaderTemplate="{StaticResource GroupHeaderTemplate}" />
		<!--
			Material look for this screen, built from the Figma file "HackPDM — Uno Material Design"
			(frames "File Manager — Light" / "— Dark"). Colors come from the active color preset (ThemePresets);
			pane corners and borders from the shape style (HackPanel* resources). Shared button, chip, tab, table and
			tree styles are in Styles/HackControls.xaml.
		-->
		<!--  text keeps the theme's color (a fixed white was invisible on light presets)  -->
		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Normal" />
		</Style>
	</Page.Resources>

	<Grid
		Margin="12"
		CornerRadius="{StaticResource HackPanelCornerRadius}"
		RowSpacing="12">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Top Header Area (Breadcrumb Bar + Optional Resume Banner)  -->
		<Grid Grid.Row="0" RowSpacing="8">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>

			<!--  Top Folder Navigation & Breadcrumb Bar  -->
			<Border pp:Id="fm.toolbar" Grid.Row="0" Style="{StaticResource HackToolbarStyle}">
			<Grid ColumnSpacing="4">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
				</Grid.ColumnDefinitions>

				<!--  Pane Toggle & Up Navigation (Figma: icon buttons)  -->
				<StackPanel
					Grid.Column="0"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="4">
					<ToggleButton
						x:Name="ToggleFolderPaneButton"
						Click="ToggleFolderPane_Click"
						IsChecked="True"
						Style="{StaticResource IconToggleButtonStyle}"
						ToolTipService.ToolTip="Show or hide folder tree panel">
						<FontIcon FontSize="18" Glyph="&#xE700;" />
						<ut:ControlExtensions.AlternateContent>
							<FontIcon FontSize="18" Glyph="&#xE700;" />
						</ut:ControlExtensions.AlternateContent>
					</ToggleButton>
					<Button
						x:Name="NavigateUpButton"
						Click="NavigateUp_Click"
						IsEnabled="False"
						Style="{StaticResource IconButtonStyle}"
						ToolTipService.ToolTip="Go up one folder (Alt+Up)">
						<FontIcon FontSize="18" Glyph="&#xE72B;" />
					</Button>
				</StackPanel>

				<!--  Breadcrumb Trail  -->
				<BreadcrumbBar
					x:Name="OdooDirectoryBreadcrumb"
					Grid.Column="1"
					Margin="8,0,0,0"
					VerticalAlignment="Center"
					ItemsSource="{x:Bind BreadcrumbPath}">
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:DataType="types:TreeData">
							<StackPanel
								Padding="0,2"
								Orientation="Horizontal"
								Spacing="6"
								ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
								<TextBlock
									VerticalAlignment="Center"
									FontSize="14"
									FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
									Text="{x:Bind Name}" />
								<Border
									Padding="4,0"
									VerticalAlignment="Center"
									Background="#222EA043"
									BorderBrush="#552EA043"
									BorderThickness="1"
									CornerRadius="3"
									Visibility="{x:Bind LocalBadgeVisibility, Mode=OneWay}">
									<TextBlock
										FontSize="9"
										Foreground="#4CC36B"
										Text="Local" />
								</Border>
								<Border
									Padding="4,0"
									VerticalAlignment="Center"
									Background="#221F88E5"
									BorderBrush="#551F88E5"
									BorderThickness="1"
									CornerRadius="3"
									Visibility="{x:Bind RemoteBadgeVisibility, Mode=OneWay}">
									<TextBlock
										FontSize="9"
										Foreground="#58B4FF"
										Text="Server" />
								</Border>
							</StackPanel>
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>

				<!--  Folder Origin Chip & Actions (Figma: assist chip, text button, outlined buttons)  -->
				<StackPanel
					Grid.Column="2"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="8">
					<Border
						x:Name="CurrentFolderOriginPill"
						Height="32"
						Padding="12,0,16,0"
						VerticalAlignment="Center"
						BorderBrush="{ThemeResource OutlineVariantBrush}"
						BorderThickness="1"
						CornerRadius="8"
						Visibility="Collapsed">
						<StackPanel
							VerticalAlignment="Center"
							Orientation="Horizontal"
							Spacing="8">
							<Ellipse
								x:Name="CurrentFolderOriginDot"
								Width="8"
								Height="8"
								VerticalAlignment="Center"
								Fill="#C69749" />
							<TextBlock
								x:Name="CurrentFolderOriginText"
								VerticalAlignment="Center"
								FontSize="14"
								FontWeight="Medium"
								Foreground="{ThemeResource OnSurfaceBrush}" />
						</StackPanel>
					</Border>
					<Button
						x:Name="CopyPathButton"
						Click="CopyPath_Click"
						Style="{StaticResource TextButtonStyle}"
						ToolTipService.ToolTip="Copy current vault folder path">
						<StackPanel Orientation="Horizontal" Spacing="8">
							<FontIcon
								x:Name="CopyPathIcon"
								FontSize="14"
								Glyph="&#xE8C8;" />
							<TextBlock
								x:Name="CopyPathLabel"
								VerticalAlignment="Center"
								FontSize="14"
								FontWeight="Medium"
								Text="Copy path" />
						</StackPanel>
					</Button>
					<Button
						x:Name="SubfolderMenuButton"
						Click="SubfolderMenuButton_Click"
						Style="{StaticResource OutlinedButtonStyle}"
						ToolTipService.ToolTip="Jump directly to a subfolder"
						Visibility="Collapsed">
						<TextBlock
							x:Name="SubfolderMenuLabel"
							VerticalAlignment="Center"
							FontSize="14"
							FontWeight="Medium"
							Text="Subfolders" />
					</Button>
					<Button
						Content="Layout"
						Style="{StaticResource OutlinedButtonStyle}"
						ToolTipService.ToolTip="Rearrange or dock workspace panels">
						<Button.Flyout>
							<MenuFlyout>
								<MenuFlyoutItem Click="PresetBalanced_Click" Text="Balanced (Folders Left · Details Bottom)" />
								<MenuFlyoutItem Click="PresetRightInspector_Click" Text="Widescreen (Inspector Right)" />
								<MenuFlyoutItem Click="PresetRightSidebar_Click" Text="Sidebar Right (Folders Right)" />
								<MenuFlyoutItem Click="PresetFocusEntries_Click" Text="Focus Files (Maximize List)" />
								<MenuFlyoutSeparator />
								<ToggleMenuFlyoutItem x:Name="MenuShowFolders" Click="MenuTogglePane_Click" Text="Folders Panel" />
								<ToggleMenuFlyoutItem x:Name="MenuShowDetails" Click="MenuTogglePane_Click" Text="Details Inspector" />
								<ToggleMenuFlyoutItem x:Name="MenuShowPreview" Click="MenuTogglePane_Click" Text="Preview Panel" />
								<MenuFlyoutSeparator />
								<MenuFlyoutItem Click="PresetBalanced_Click" Text="Reset Default Layout" />
							</MenuFlyout>
						</Button.Flyout>
					</Button>
				</StackPanel>
			</Grid>
			</Border>

			<!--  Saved Download Resume Banner  -->
			<Border
				Grid.Row="1"
				Padding="10,6"
				Background="{ThemeResource HackSurfaceContainerLowBrush}"
				BorderBrush="{ThemeResource PrimaryBrush}"
				BorderThickness="1"
				CornerRadius="16"
				Visibility="{x:Bind ViewModel.HasResumableDownload, Mode=OneWay}">
				<Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
					<FontIcon
						VerticalAlignment="Center"
						FontSize="15"
						Foreground="{ThemeResource PrimaryBrush}"
						Glyph="&#xE896;" />
					<StackPanel
						Grid.Column="1"
						VerticalAlignment="Center"
						Spacing="1">
						<TextBlock
							FontSize="12"
							FontWeight="SemiBold"
							Text="Unfinished download ready to resume" />
						<TextBlock
							FontSize="11"
							Foreground="{ThemeResource OnSurfaceVariantBrush}"
							Text="{x:Bind ViewModel.ResumableDownloadSummary, Mode=OneWay}"
							TextTrimming="CharacterEllipsis" />
					</StackPanel>
					<StackPanel
						Grid.Column="2"
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="6">
						<Button
							Padding="10,4"
							Command="{x:Bind ViewModel.ResumeSavedDownloadCommand}"
							Content="Resume Download"
							Style="{StaticResource FilledButtonStyle}" />
						<Button
							Command="{x:Bind ViewModel.ClearSavedDownloadCommand}"
							Content="Clear"
							Style="{StaticResource TextButtonStyle}"
							ToolTipService.ToolTip="Discard saved download progress" />
					</StackPanel>
				</Grid>
			</Border>
		</Grid>

		<!--  Rearrangeable & Dockable Workspace Container  -->
		<Grid x:Name="WorkspaceGrid" Grid.Row="1">
			<!--  Folders Pane Card  -->
			<Border pp:Id="fm.foldersPane"
				x:Name="FoldersPaneCard"
				Style="{StaticResource HackPaneTintedStyle}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  Folders Header (the title is the drag handle) + Tree and Dock Actions  -->
					<Grid Grid.Row="0" Padding="16,12,8,4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Grid
							x:Name="FoldersDragGrip"
							Grid.Column="0"
							Background="Transparent"
							PointerCanceled="PaneGrip_PointerCaptureLost"
							PointerCaptureLost="PaneGrip_PointerCaptureLost"
							PointerMoved="PaneGrip_PointerMoved"
							PointerPressed="FoldersGrip_PointerPressed"
							PointerReleased="PaneGrip_PointerReleased"
							ToolTipService.ToolTip="Drag to dock Folders Left or Right">
							<TextBlock pp:Id="fm.foldersTitle"
								VerticalAlignment="Center"
								Style="{StaticResource HackPaneTitleStyle}"
								Text="Folders" />
						</Grid>
						<StackPanel
							Grid.Column="1"
							VerticalAlignment="Center"
							Orientation="Horizontal">
							<ToggleButton
								x:Name="BranchLinesToggleButton"
								Click="BranchLinesToggle_Click"
								Style="{StaticResource PaneIconToggleButtonStyle}"
								ToolTipService.ToolTip="Show or hide tree branching guide lines">
								<FontIcon FontSize="13" Glyph="&#xE8FD;" />
								<ut:ControlExtensions.AlternateContent>
									<FontIcon
										FontSize="13"
										Foreground="{ThemeResource PrimaryBrush}"
										Glyph="&#xE8FD;" />
								</ut:ControlExtensions.AlternateContent>
							</ToggleButton>
							<Button
								Click="ExpandAllFolders_Click"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Expand all folders">
								<FontIcon FontSize="12" Glyph="&#xE70D;" />
							</Button>
							<Button
								Click="CollapseAllFolders_Click"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Collapse all folders">
								<FontIcon FontSize="12" Glyph="&#xE70E;" />
							</Button>
							<Button
								Click="Refresh_Click"
								Style="{StaticResource PaneIconButtonStyle}"
								ToolTipService.ToolTip="Refresh folder tree (F5)">
								<FontIcon FontSize="12" Glyph="&#xE72C;" />
							</Button>
							<Button Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Dock options">
								<FontIcon FontSize="13" Glyph="&#xE712;" />
								<Button.Flyout>
									<MenuFlyout>
										<MenuFlyoutItem Click="DockFoldersLeft_Click" Text="Dock Left" />
										<MenuFlyoutItem Click="DockFoldersRight_Click" Text="Dock Right" />
										<MenuFlyoutSeparator />
										<MenuFlyoutItem Click="HideFoldersPane_Click" Text="Hide Folders Panel" />
									</MenuFlyout>
								</Button.Flyout>
							</Button>
						</StackPanel>
					</Grid>

					<!--  Quick Folder Filter (Figma: outlined text field with a search icon)  -->
					<Grid
						Grid.Row="1"
						Margin="8,4,8,4"
						ColumnSpacing="4">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBox
							x:Name="FolderFilterBox"
							Grid.Column="0"
							PlaceholderText="Filter folders…"
							Style="{StaticResource OutlinedTextBoxStyle}"
							TextChanged="FolderFilterBox_TextChanged">
							<ut:ControlExtensions.Icon>
								<FontIcon FontSize="16" Glyph="&#xE721;" />
							</ut:ControlExtensions.Icon>
						</TextBox>
						<Button
							x:Name="ClearFilterButton"
							Grid.Column="1"
							VerticalAlignment="Center"
							Click="ClearFilterButton_Click"
							Style="{StaticResource PaneIconButtonStyle}"
							ToolTipService.ToolTip="Clear folder filter"
							Visibility="Collapsed">
							<FontIcon FontSize="12" Glyph="&#xE711;" />
						</Button>
					</Grid>

					<!--  TreeView  -->
					<Grid Grid.Row="2">
						<TreeView
							x:Name="OdooDirectoryTree"
							Margin="8,0"
							Padding="0,4"
							VerticalAlignment="Stretch"
							BorderThickness="0"
							CanDragItems="False"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							Visibility="Visible">
								<TreeView.Resources>
									<Thickness x:Key="TreeViewItemPresenterPadding">0,0,0,0</Thickness>
									<Thickness x:Key="TreeViewItemPresenterMargin">0,0,0,0</Thickness>
									<x:Double x:Key="TreeViewItemIndent">16</x:Double>
									<x:Double x:Key="TreeViewItemMinHeight">32</x:Double>
									<x:Double x:Key="TreeViewItemExpandCollapseChevronFontSize">11</x:Double>
								</TreeView.Resources>
							<TreeView.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutSubItem x:Name="TreeDownload" Text="Download">
										<MenuFlyoutItem Text="All"
										Command="{x:Bind ViewModel.GetLatestDirectoryCommand}" />
										<MenuFlyoutItem Text="Top Directory"
										Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Checkout"
										Command="{x:Bind ViewModel.CheckoutDirectoryCommand}" />
									<MenuFlyoutItem Text="Undo Checkout"
										Command="{x:Bind ViewModel.UndoCheckoutDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Commit"
										Command="{x:Bind ViewModel.CommitDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutSubItem Text="Delete">
										<MenuFlyoutItem Text="Local"
										Command="{x:Bind ViewModel.LocalDeleteDirectoryCommand}" />
										<MenuFlyoutItem Text="Logical"
										Command="{x:Bind ViewModel.LogicalDeleteDirectoryCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="TreeUndelete" Text="Restore">
										<MenuFlyoutItem Text="All"
										Command="{x:Bind ViewModel.RestoreDirectoryRecursiveCommand}" />
										<MenuFlyoutItem Text="Top Directory"
										Command="{x:Bind ViewModel.RestoreDirectoryCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Open Directory"
										Command="{x:Bind ViewModel.OpenDirectoryCommand}" />
								</MenuFlyout>
							</TreeView.ContextFlyout>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="types:TreeData">
									<TreeViewItem
										MinHeight="32"
										Margin="0"
										Padding="0"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										CornerRadius="16"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										Loaded="TreeViewItem_Loaded"
										ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
										<StackPanel
											VerticalAlignment="Stretch"
											Orientation="Horizontal">
											<controls:TreeBranchGuides
												VerticalAlignment="Stretch"
												BranchRevision="{x:Bind BranchRevision, Mode=OneWay}"
												IndentWidth="16"
												NodeData="{x:Bind}" />
											<controls:FolderIcon
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												IconSize="20"
												IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
												IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
												Origin="{x:Bind Origin, Mode=OneWay}" />
											<TextBlock
												Margin="0,0,8,0"
												VerticalAlignment="Center"
												FontSize="14"
												FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
												Text="{x:Bind Name}" />
											<TextBlock
												Margin="0,0,8,0"
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="Medium"
												Foreground="{ThemeResource OnSurfaceVariantBrush}"
												Text="{x:Bind SubfolderCountText, Mode=OneWay}"
												Visibility="{x:Bind SubfolderCountVisibility, Mode=OneWay}" />
											<Border
												Margin="0,0,4,0"
												Padding="4,0"
												VerticalAlignment="Center"
												Background="#222EA043"
												CornerRadius="4"
												Visibility="{x:Bind LocalBadgeVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="9"
													Foreground="#4CC36B"
													Text="Local" />
											</Border>
											<Border
												Margin="0,0,4,0"
												Padding="4,0"
												VerticalAlignment="Center"
												Background="#221F88E5"
												CornerRadius="4"
												Visibility="{x:Bind RemoteBadgeVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="9"
													Foreground="#58B4FF"
													Text="Server" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<!--  Empty Filter Hint  -->
						<StackPanel
							x:Name="EmptyTreeFilterPanel"
							Padding="16"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Spacing="6"
							Visibility="Collapsed">
							<FontIcon
								HorizontalAlignment="Center"
								FontSize="20"
								Foreground="{ThemeResource OnSurfaceVariantBrush}"
								Glyph="&#xE8B7;" />
							<TextBlock
								HorizontalAlignment="Center"
								FontSize="11"
								Foreground="{ThemeResource OnSurfaceVariantBrush}"
								Text="No matching folders" />
							<Button
								HorizontalAlignment="Center"
								Click="ClearFilterButton_Click"
								Content="Show all folders"
								Style="{StaticResource TextButtonStyle}" />
						</StackPanel>

						<!--  Folder Tree Loading Overlay  -->
						<Border
							x:Name="TreeLoadingOverlay"
							Background="{ThemeResource SurfaceBrush}"
							Visibility="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}">
							<Grid RowDefinitions="Auto,*">
								<ProgressBar
									Grid.Row="0"
									Margin="6,6,6,0"
									IsIndeterminate="True" />
								<StackPanel
									Grid.Row="1"
									Padding="16"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">
									<ProgressRing
										Width="30"
										Height="30"
										HorizontalAlignment="Center"
										IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" />
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Text="Loading Folders…" />
									<TextBlock
										HorizontalAlignment="Center"
										Foreground="{ThemeResource OnSurfaceVariantBrush}"
										Text="{x:Bind ViewModel.TreeLoadingStatus, Mode=OneWay}"
										TextAlignment="Center"
										TextWrapping="Wrap" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>

					<!--  Folder Tree Footer  -->
					<Border Grid.Row="3" Padding="16,4,16,12">
						<TextBlock
							x:Name="TreeSummaryText"
							Style="{StaticResource HackCaptionStyle}"
							Text="Loading folders…"
							TextTrimming="CharacterEllipsis" />
					</Border>
				</Grid>
			</Border>

			<!--  Splitter: Folders <-> Workspace  -->
			<controls:PaneSplitter
				x:Name="FoldersSplitter"
				DragCompleted="OnSplitterDragCompleted"
				DragDelta="FoldersSplitter_DragDelta"
				Orientation="Vertical" />
			<!--  Primary File List Card  -->
			<Border pp:Id="fm.fileList"
				x:Name="EntriesPaneCard"
				Style="{StaticResource HackPaneOutlinedStyle}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<!--  TabView for file lists + view-option chips (Figma: Tab strip / View options)  -->
					<TabView
						x:Name="ListTabs"
						Grid.Row="0"
						IsAddTabButtonVisible="False"
						TabWidthMode="SizeToContent">
						<TabView.TabStripFooter>
							<StackPanel
								Padding="8,0,12,0"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="8">
								<utu:Chip
									x:Name="ToggleGroups"
									Content="Grouped"
									IsChecked="{x:Bind ViewModel.IsGroupingEnabled, Mode=TwoWay}"
									CanRemove="False"
								Style="{StaticResource FilterChipStyle}"
									ToolTipService.ToolTip="Group entries by status or property" />
								<utu:Chip
									x:Name="ShowInactive"
									Content="Inactive"
									IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
									CanRemove="False"
								Style="{StaticResource FilterChipStyle}"
									ToolTipService.ToolTip="Show deleted/inactive files" />
								<utu:Chip
									x:Name="Anchor"
									Checked="Anchor_Checked"
									Content="Pin"
									CanRemove="False"
								Style="{StaticResource FilterChipStyle}"
									ToolTipService.ToolTip="Keep window always on top"
									Unchecked="Anchor_Checked" />
								<Button
									Click="Refresh_Click"
									Style="{StaticResource AssistChipButtonStyle}"
									ToolTipService.ToolTip="Refresh view (F5)">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<FontIcon
											FontSize="14"
											Foreground="{ThemeResource PrimaryBrush}"
											Glyph="&#xE72C;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="14"
											FontWeight="Medium"
											Text="Refresh" />
									</StackPanel>
								</Button>
								<Button
									Click="Search_Click"
									Style="{StaticResource AssistChipButtonStyle}"
									ToolTipService.ToolTip="Search vault files (Ctrl+F)">
									<StackPanel Orientation="Horizontal" Spacing="8">
										<FontIcon
											FontSize="14"
											Foreground="{ThemeResource PrimaryBrush}"
											Glyph="&#xE721;" />
										<TextBlock
											VerticalAlignment="Center"
											FontSize="14"
											FontWeight="Medium"
											Text="Search" />
									</StackPanel>
								</Button>
								<Button Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Additional tools">
									<FontIcon FontSize="14" Glyph="&#xE712;" />
									<Button.Flyout>
										<MenuFlyout>
											<MenuFlyoutItem Click="Refresh_Click" Text="Refresh View (F5)" />
											<MenuFlyoutItem Click="Search_Click" Text="Search (Ctrl+F)" />
											<MenuFlyoutItem Click="ManageTypes_Click" Text="Manage File Types" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Click="StatusWindow_Click" Text="Status Log" />
										</MenuFlyout>
									</Button.Flyout>
								</Button>
							</StackPanel>
						</TabView.TabStripFooter>

						<TabViewItem
							x:Name="RootEntryList"
							Header="Entries"
							IsClosable="False">
							<Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
								<!--  headers and widths come from the saved column settings (ApplyColumnSettings), matched by SortMemberPath  -->
								<controls:EntryTableView
									x:Name="OdooEntryList"
									VerticalAlignment="Stretch"
									VerticalContentAlignment="Stretch"
									AutoGenerateColumns="False"
									CanSortColumns="True"
									IsReadOnly="True"
									SelectionMode="Extended"
									SelectionUnit="Row"
									ShowDragRectangle="False">
									<tv:TableView.Columns>
										<tv:TableViewTemplateColumn
											Width="38"
											CanReorder="True"
											CanResize="True"
											CanSort="False"
											CellTemplate="{StaticResource IconCellTemplate}" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryNameCellTemplate}" SortMemberPath="Name" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryTypeCellTemplate}" SortMemberPath="Type" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource SizeCellTemplate}" SortMemberPath="Size" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource StatusCellTemplate}" SortMemberPath="Status" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryCheckoutCellTemplate}" SortMemberPath="Checkout" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryLocalDateCellTemplate}" SortMemberPath="LocalDate" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryRemoteDateCellTemplate}" SortMemberPath="RemoteDate" />
										<tv:TableViewTemplateColumn CellTemplate="{StaticResource EntryFullNameCellTemplate}" SortMemberPath="FullName" />
									</tv:TableView.Columns>
									<tv:TableView.ContextFlyout>
										<MenuFlyout>
											<MenuFlyoutSubItem x:Name="EntryOpen" Text="Open">
												<MenuFlyoutItem Text="Preview Latest Remote" Command="{x:Bind ViewModel.OpenSelectedLatestRemoteCommand}" />
												<MenuFlyoutItem Text="Latest Local" Command="{x:Bind ViewModel.OpenSelectedLatestLocalCommand}" />
												<MenuFlyoutItem Text="File Directory" Command="{x:Bind ViewModel.OpenSelectedFoldersCommand}" />
											</MenuFlyoutSubItem>
											<MenuFlyoutItem Text="Download" Command="{x:Bind ViewModel.GetLatestSelectedCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Text="Checkout" Command="{x:Bind ViewModel.CheckoutSelectedCommand}" />
											<MenuFlyoutItem Text="Undo Checkout" Command="{x:Bind ViewModel.UndoCheckoutSelectedCommand}" />
											<MenuFlyoutSeparator />
											<!--  one item per EntryRowKeys.Names, added by the view  -->
											<MenuFlyoutSubItem x:Name="EntryGroupBy" Text="Group By" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Text="Commit" Command="{x:Bind ViewModel.CommitSelectedCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutItem Text="Upload Preview Image" Command="{x:Bind ViewModel.UploadPreviewImageCommand}" />
											<MenuFlyoutSeparator />
											<MenuFlyoutSubItem x:Name="EntryDelete" Text="Delete">
												<MenuFlyoutItem Text="Local" Command="{x:Bind ViewModel.LocalDeleteSelectedCommand}" />
												<MenuFlyoutItem Text="Logical" Command="{x:Bind ViewModel.LogicalDeleteSelectedCommand}" />
												<MenuFlyoutItem Text="Permanent" Command="{x:Bind ViewModel.PermanentDeleteSelectedCommand}" />
											</MenuFlyoutSubItem>
										</MenuFlyout>
									</tv:TableView.ContextFlyout>
								</controls:EntryTableView>

								<!--  Grouped entry list (used on non-Windows targets where TableView.GroupDescriptions is unavailable)  -->
								<Grid
									x:Name="GroupedEntryContainer"
									Visibility="Collapsed">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
									</Grid.RowDefinitions>
									<Border
										Grid.Row="0"
										Padding="8,4"
										Background="{ThemeResource HackSurfaceContainerLowBrush}"
										BorderBrush="{ThemeResource OutlineVariantBrush}"
										BorderThickness="0,0,0,1">
										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="Auto" />
											</Grid.ColumnDefinitions>
											<StackPanel
												Grid.Column="0"
												VerticalAlignment="Center"
												Orientation="Horizontal"
												Spacing="6">
												<FontIcon FontSize="11" Glyph="&#xE8FD;" />
												<TextBlock
													VerticalAlignment="Center"
													FontSize="11"
													FontWeight="SemiBold"
													Text="{x:Bind ViewModel.GroupedByLabelText, Mode=OneWay}" />
											</StackPanel>
											<StackPanel
												Grid.Column="1"
												VerticalAlignment="Center"
												Orientation="Horizontal"
												Spacing="4">
												<Button
													Style="{StaticResource GroupedBarTextButtonStyle}"
													ToolTipService.ToolTip="Choose field to group by">
													<StackPanel Orientation="Horizontal" Spacing="6">
														<TextBlock VerticalAlignment="Center" FontSize="12" FontWeight="Medium" Text="Group by" />
														<FontIcon FontSize="9" Glyph="&#xE70D;" />
													</StackPanel>
													<Button.Flyout>
														<MenuFlyout x:Name="GroupByToolbarFlyout" />
													</Button.Flyout>
												</Button>
												<Button
													Click="ExpandAllGroups_Click"
													Style="{StaticResource PaneIconButtonStyle}"
													ToolTipService.ToolTip="Expand all groups">
													<FontIcon FontSize="10" Glyph="&#xE70D;" />
												</Button>
												<Button
													Click="CollapseAllGroups_Click"
													Style="{StaticResource PaneIconButtonStyle}"
													ToolTipService.ToolTip="Collapse all groups">
													<FontIcon FontSize="10" Glyph="&#xE70E;" />
												</Button>
											</StackPanel>
										</Grid>
									</Border>
									<Border
										Grid.Row="1"
										Padding="14,3,6,3"
										BorderBrush="{ThemeResource OutlineVariantBrush}"
										BorderThickness="0,0,0,1">
										<Grid ColumnSpacing="8">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="36" />
												<ColumnDefinition Width="*" MinWidth="160" />
												<ColumnDefinition Width="75" />
												<ColumnDefinition Width="75" />
												<ColumnDefinition Width="105" />
												<ColumnDefinition Width="95" />
												<ColumnDefinition Width="140" />
												<ColumnDefinition Width="140" />
											</Grid.ColumnDefinitions>
											<Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Name" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="Name" />
											<Button Grid.Column="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Type" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="Type" />
											<Button Grid.Column="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Right" Click="GroupedSortColumn_Click" Content="Size" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="Size" />
											<Button Grid.Column="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Status" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="Status" />
											<Button Grid.Column="5" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Checkout" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="Checkout" />
											<Button Grid.Column="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Local Date" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="LocalDate" />
											<Button Grid.Column="7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Click="GroupedSortColumn_Click" Content="Remote Date" Style="{StaticResource GroupedSortHeaderButtonStyle}" Tag="RemoteDate" />
										</Grid>
									</Border>
									<ListView
										x:Name="GroupedEntryList"
										Grid.Row="2"
										HorizontalContentAlignment="Stretch"
										IsItemClickEnabled="True"
										ItemTemplateSelector="{StaticResource EntryGroupTemplateSelector}"
										SelectionMode="Extended">
										<ListView.ItemContainerStyle>
											<Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
												<Setter Property="HorizontalContentAlignment" Value="Stretch" />
												<Setter Property="Padding" Value="4,0" />
												<Setter Property="MinHeight" Value="0" />
											</Style>
										</ListView.ItemContainerStyle>
									</ListView>
								</Grid>

								<!--  Top Progress Strip & Centered Entry Loading Card  -->
								<ProgressBar
									Height="3"
									VerticalAlignment="Top"
									IsHitTestVisible="False"
									IsIndeterminate="{x:Bind ViewModel.IsEntriesProgressIndeterminate, Mode=OneWay}"
									Maximum="100"
									Minimum="0"
									Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}"
									Value="{x:Bind ViewModel.EntriesLoadingPercent, Mode=OneWay}" />

								<Border
									x:Name="EntriesLoadingOverlay"
									MinWidth="300"
									Padding="24,18"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Background="{ThemeResource SurfaceBrush}"
									BorderBrush="{ThemeResource OutlineVariantBrush}"
									BorderThickness="1"
									CornerRadius="8"
									Visibility="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}">
									<StackPanel HorizontalAlignment="Center" Spacing="10">
										<ProgressRing
											Width="32"
											Height="32"
											HorizontalAlignment="Center"
											IsActive="{x:Bind ViewModel.IsEntriesLoading, Mode=OneWay}" />
										<TextBlock
											HorizontalAlignment="Center"
											FontSize="13"
											FontWeight="SemiBold"
											Text="{x:Bind ViewModel.EntriesLoadingStatus, Mode=OneWay}"
											TextAlignment="Center" />
										<ProgressBar
											Width="240"
											IsIndeterminate="{x:Bind ViewModel.IsEntriesProgressIndeterminate, Mode=OneWay}"
											Maximum="100"
											Minimum="0"
											Value="{x:Bind ViewModel.EntriesLoadingPercent, Mode=OneWay}" />
									</StackPanel>
								</Border>

								<TextBlock
									x:Name="EmptyFolderHint"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									FontSize="13"
									Foreground="{ThemeResource OnSurfaceVariantBrush}"
									IsHitTestVisible="False"
									Text="This folder has no entries"
									Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}" />
							</Grid>
						</TabViewItem>
						<TabViewItem
							x:Name="ChangesTab"
							Header="{x:Bind ViewModel.ChangesTabHeader, Mode=OneWay}"
							IsClosable="False">
							<Grid Padding="8" ColumnSpacing="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>

								<Border
									Grid.Column="0"
									Padding="10"
									Background="{ThemeResource HackSurfaceContainerLowBrush}"
									BorderBrush="{ThemeResource OutlineVariantBrush}"
									BorderThickness="0"
									CornerRadius="12">
									<Grid RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="SemiBold"
												Text="{x:Bind ViewModel.LocalChangesHeader, Mode=OneWay}" />
											<Button
												Grid.Column="1"
												Command="{x:Bind ViewModel.CommitDirectoryCommand}"
												Content="Commit Folder"
												Style="{StaticResource FilledTonalButtonStyle}" />
										</Grid>
										<controls:EntryTableView
											x:Name="HackChangesList"
											Grid.Row="1"
											AutoGenerateColumns="False"
											IsReadOnly="True"
											ItemsSource="{x:Bind ViewModel.LocalChanges}"
											SelectionMode="Single"
											SelectionUnit="Row"
											ShowDragRectangle="False">
											<tv:TableView.Columns>
												<tv:TableViewTemplateColumn Width="130" CellTemplate="{StaticResource EntryNameCellTemplate}" Header="File Name" />
												<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource ChangesStatusCellTemplate}" Header="Status" />
												<tv:TableViewTemplateColumn Width="78" CellTemplate="{StaticResource ChangesSizeCellTemplate}" Header="Size" />
												<tv:TableViewTemplateColumn Width="152" CellTemplate="{StaticResource EntryLocalDateCellTemplate}" Header="Local Date" />
											</tv:TableView.Columns>
										</controls:EntryTableView>
									</Grid>
								</Border>

								<Border
									Grid.Column="1"
									Padding="10"
									Background="{ThemeResource HackSurfaceContainerLowBrush}"
									BorderBrush="{ThemeResource OutlineVariantBrush}"
									BorderThickness="0"
									CornerRadius="12">
									<Grid RowSpacing="8">
										<Grid.RowDefinitions>
											<RowDefinition Height="Auto" />
											<RowDefinition Height="*" />
										</Grid.RowDefinitions>
										<Grid ColumnDefinitions="*,Auto">
											<TextBlock
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="SemiBold"
												Text="{x:Bind ViewModel.RemoteChangesHeader, Mode=OneWay}" />
											<Button
												Grid.Column="1"
												Padding="10,4"
												Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}"
												Content="Download Folder" />
										</Grid>
										<controls:EntryTableView
											x:Name="OdooChangesList"
											Grid.Row="1"
											AutoGenerateColumns="False"
											IsReadOnly="True"
											ItemsSource="{x:Bind ViewModel.RemoteChanges}"
											SelectionMode="Single"
											SelectionUnit="Row"
											ShowDragRectangle="False">
											<tv:TableView.Columns>
												<tv:TableViewTemplateColumn Width="130" CellTemplate="{StaticResource EntryNameCellTemplate}" Header="File Name" />
												<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource ChangesStatusCellTemplate}" Header="Status" />
												<tv:TableViewTemplateColumn Width="78" CellTemplate="{StaticResource ChangesSizeCellTemplate}" Header="Size" />
												<tv:TableViewTemplateColumn Width="152" CellTemplate="{StaticResource EntryRemoteDateCellTemplate}" Header="Remote Date" />
											</tv:TableView.Columns>
										</controls:EntryTableView>
									</Grid>
								</Border>
							</Grid>
						</TabViewItem>
					</TabView>

					<!--  Entries Pane Compact Summary Strip  -->
					<Border
						Grid.Row="1"
						Padding="10,5"
						BorderBrush="{ThemeResource OutlineVariantBrush}"
						BorderThickness="0,1,0,0">
						<Grid ColumnDefinitions="Auto,*">
							<StackPanel
								Grid.Column="0"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="14">
								<TextBlock
									VerticalAlignment="Center"
									FontWeight="SemiBold"
									Text="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									Foreground="{ThemeResource OnSurfaceVariantBrush}"
									Text="{x:Bind ViewModel.EntriesLabelModified, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									Foreground="{ThemeResource OnSurfaceVariantBrush}"
									Text="{x:Bind ViewModel.EntriesLabelLocal, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									Foreground="{ThemeResource OnSurfaceVariantBrush}"
									Text="{x:Bind ViewModel.EntriesLabelRemote, Mode=OneWay}" />
							</StackPanel>
							<TextBlock
								Grid.Column="1"
								HorizontalAlignment="Right"
								VerticalAlignment="Center"
								Foreground="{ThemeResource OnSurfaceVariantBrush}"
								Text="{x:Bind ViewModel.SelectionLabel, Mode=OneWay}"
								TextTrimming="CharacterEllipsis" />
						</Grid>
					</Border>
				</Grid>
			</Border>

			<!--  Splitter: Entries <-> Details+Preview Inspector Host  -->
			<controls:PaneSplitter
				x:Name="InspectorSplitter"
				DragCompleted="OnSplitterDragCompleted"
				DragDelta="InspectorSplitter_DragDelta"
				Orientation="Horizontal" />

			<!--  Dockable Inspector Host (Details + Preview, horizontal when Bottom or vertical when Right)  -->
			<Grid x:Name="DetailsAndPreviewHost">
				<!--  Details Inspector Card  -->
				<Border pp:Id="fm.details"
					x:Name="DetailsPaneCard"
					Style="{StaticResource HackPaneOutlinedStyle}"
					BorderThickness="{StaticResource HackPanelBorderThickness}"
					CornerRadius="{StaticResource HackPanelCornerRadius}">
					<Grid>
						<Grid>
							<TabView
								x:Name="VersionTabs"
								VerticalAlignment="Stretch"
								IsAddTabButtonVisible="False"
								SelectionChanged="VersionTabs_SelectionChanged"
								TabWidthMode="SizeToContent">
								<TabView.Resources>
									<!--  Figma: secondary tabs keep the label in On Surface when selected  -->
									<StaticResource x:Key="TabViewItemHeaderForegroundSelected" ResourceKey="HackSecondaryTabForegroundSelectedBrush" />
								</TabView.Resources>
								<!--  Drag handle for docking the Inspector (was the "Inspector" header row)  -->
								<TabView.TabStripHeader>
									<Grid
										x:Name="DetailsDragGrip"
										Padding="12,0,4,0"
										VerticalAlignment="Stretch"
										Background="Transparent"
										PointerCanceled="PaneGrip_PointerCaptureLost"
										PointerCaptureLost="PaneGrip_PointerCaptureLost"
										PointerMoved="PaneGrip_PointerMoved"
										PointerPressed="DetailsGrip_PointerPressed"
										PointerReleased="PaneGrip_PointerReleased"
										ToolTipService.ToolTip="Drag to dock Inspector Bottom or Right">
										<Grid
											Width="8"
											Height="12"
											VerticalAlignment="Center"
											Opacity="0.6">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="*" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid.RowDefinitions>
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
												<RowDefinition Height="*" />
											</Grid.RowDefinitions>
											<Ellipse Grid.Row="0" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
											<Ellipse Grid.Row="0" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
											<Ellipse Grid.Row="1" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="0" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
											<Ellipse Grid.Row="2" Grid.Column="1" Width="2" Height="2" Fill="{ThemeResource OnSurfaceVariantBrush}" />
										</Grid>
									</Grid>
								</TabView.TabStripHeader>
								<TabView.TabStripFooter>
									<StackPanel
										Padding="8,0,8,0"
										HorizontalAlignment="Right"
										VerticalAlignment="Center"
										Orientation="Horizontal">
										<Button
											Click="ToggleInspectorDock_Click"
											Style="{StaticResource PaneIconButtonStyle}"
											ToolTipService.ToolTip="Switch Inspector between Bottom and Right dock">
											<FontIcon FontSize="13" Glyph="&#xE8A9;" />
										</Button>
										<Button Style="{StaticResource PaneIconButtonStyle}" ToolTipService.ToolTip="Inspector dock options">
											<FontIcon FontSize="13" Glyph="&#xE712;" />
											<Button.Flyout>
												<MenuFlyout>
													<MenuFlyoutItem Click="DockInspectorBottom_Click" Text="Dock Bottom" />
													<MenuFlyoutItem Click="DockInspectorRight_Click" Text="Dock Right" />
													<MenuFlyoutItem Click="SwapPreviewPlacement_Click" Text="Swap Details / Preview" />
													<MenuFlyoutSeparator />
													<MenuFlyoutItem Click="HideDetailsPane_Click" Text="Hide Inspector" />
												</MenuFlyout>
											</Button.Flyout>
										</Button>
										<Button
											Click="HideDetailsPane_Click"
											Style="{StaticResource PaneIconButtonStyle}"
											ToolTipService.ToolTip="Hide Inspector">
											<FontIcon FontSize="12" Glyph="&#xE711;" />
										</Button>
									</StackPanel>
								</TabView.TabStripFooter>
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<controls:EntryTableView
										x:Name="OdooHistory"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OHistories}"
										SelectionMode="Single"
										SelectionUnit="Row"
										ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" Header="Version">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="135" Header="Mod User">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModUser}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="155" Header="Mod Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="105" Header="Size">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Size, Converter={StaticResource FileSizeFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn MinWidth="115" Width="*" Header="Rel Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:HistoryRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind RelDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
										<tv:TableView.ContextFlyout>
											<MenuFlyout>
												<MenuFlyoutSubItem x:Name="HistoryDownload" Text="Download">
													<MenuFlyoutItem Text="Temporary"
													Command="{x:Bind ViewModel.DownloadHistoryToTempCommand}" />
													<MenuFlyoutItem Text="Overwrite"
													Command="{x:Bind ViewModel.DownloadHistoryOverwriteCommand}" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem Text="Open">
													<MenuFlyoutItem Text="Temporary"
													Command="{x:Bind ViewModel.OpenHistoryFromTempCommand}" />
													<MenuFlyoutItem Text="Overwrite"
													Command="{x:Bind ViewModel.OpenHistoryOverwriteCommand}" />
												</MenuFlyoutSubItem>
												<MenuFlyoutSubItem x:Name="HistoryMove" Text="Move">
													<MenuFlyoutItem Text="Temporary"
													Command="{x:Bind ViewModel.MoveHistoryToTempCommand}" />
													<MenuFlyoutItem Text="Overwrite"
													Command="{x:Bind ViewModel.MoveHistoryToWorkingCommand}" />
												</MenuFlyoutSubItem>
											</MenuFlyout>
										</tv:TableView.ContextFlyout>
									</controls:EntryTableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<controls:EntryTableView
										x:Name="OdooParents"
										AutoGenerateColumns="False"
										CanSortColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OParents}"
										RowDetailsVisibilityMode="Collapsed"
										SelectionMode="Single"
										SelectionUnit="Row"
										ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" CellTemplate="{StaticResource ParentVersionCellTemplate}" Header="Version" />
											<tv:TableViewTemplateColumn Width="220" CellTemplate="{StaticResource ParentNameCellTemplate}" Header="Name" />
											<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource ParentPathCellTemplate}" Header="Folder Path" />
										</tv:TableView.Columns>
									</controls:EntryTableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<controls:EntryTableView
										x:Name="OdooChildren"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OChildren}"
										RowDetailsVisibilityMode="Collapsed"
										SelectionMode="Extended"
										SelectionUnit="Row"
										ShowDragRectangle="False">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" CellTemplate="{StaticResource ChildVersionCellTemplate}" Header="Version" />
											<tv:TableViewTemplateColumn Width="220" CellTemplate="{StaticResource ChildNameCellTemplate}" Header="Name" />
											<tv:TableViewTemplateColumn Width="*" CellTemplate="{StaticResource ChildPathCellTemplate}" Header="Folder Path" />
										</tv:TableView.Columns>
									</controls:EntryTableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OProperties}"
										RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="95" Header="Version">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Version}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="160" Header="Property">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="150" Header="Configuration">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Configuration}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Type">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Type}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="*" Header="Value">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:PropertiesRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ValueData, Converter={StaticResource ValueFormatter}}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ViewModel.OVersions}"
										RowDetailsVisibilityMode="Collapsed">
										<tv:TableView.Columns>
											<tv:TableViewTemplateColumn Width="105" Header="Version Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Id}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="105" Header="File Size">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind FileSize, Converter={StaticResource FileSizeFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="115" Header="Directory Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind DirectoryId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Node Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind NodeId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="95" Header="Entry Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind EntryId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="125" Header="Attachment Id">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind AttachmentId}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="155" Header="Modify Date">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind ModifyDate, Converter={StaticResource LocalDateFormatter}}" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="180" Header="Checksum">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind Checksum}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
											<tv:TableViewTemplateColumn Width="260" Header="Odoo Complete Path">
												<tv:TableViewTemplateColumn.CellTemplate>
													<DataTemplate x:DataType="rep:VersionRow">
														<TextBlock VerticalAlignment="Center" Text="{x:Bind OdooCompletePath}" TextTrimming="CharacterEllipsis" />
													</DataTemplate>
												</tv:TableViewTemplateColumn.CellTemplate>
											</tv:TableViewTemplateColumn>
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>
							<ProgressBar
								Height="3"
								VerticalAlignment="Top"
								IsHitTestVisible="False"
								IsIndeterminate="True"
								Visibility="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" />
						</Grid>
					</Grid>
				</Border>

				<!--  Splitter: Details <-> Preview  -->
				<controls:PaneSplitter
					x:Name="DetailsPreviewSplitter"
					DragCompleted="OnSplitterDragCompleted"
					DragDelta="DetailsPreviewSplitter_DragDelta"
					Orientation="Vertical" />

				<!--  Preview Card  -->
				<Border pp:Id="fm.previewPane"
					x:Name="PreviewPaneCard"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Style="{StaticResource HackPaneTintedStyle}"
					CornerRadius="{StaticResource HackPanelCornerRadius}">
					<Grid>
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="*" />
						</Grid.RowDefinitions>

						<!--  Preview Header (the title is the drag handle) + PiP + Dock Actions  -->
						<Grid Grid.Row="0" Padding="16,12,8,0">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid
								x:Name="PreviewDragGrip"
								Grid.Column="0"
								Background="Transparent"
								PointerCanceled="PaneGrip_PointerCaptureLost"
								PointerCaptureLost="PaneGrip_PointerCaptureLost"
								PointerMoved="PaneGrip_PointerMoved"
								PointerPressed="PreviewGrip_PointerPressed"
								PointerReleased="PaneGrip_PointerReleased"
								ToolTipService.ToolTip="Drag to swap Preview position or dock">
								<TextBlock pp:Id="fm.previewTitle"
									VerticalAlignment="Center"
									Style="{StaticResource HackPaneTitleStyle}"
									Text="Preview" />
							</Grid>
							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Orientation="Horizontal">
								<Button
									Command="{x:Bind ViewModel.UploadPreviewImageCommand}"
									Style="{StaticResource PaneIconButtonStyle}"
									ToolTipService.ToolTip="Upload custom preview image for selected committed file">
									<FontIcon FontSize="13" Glyph="&#xE898;" />
								</Button>
								<Button
									Click="OnTogglePipClicked"
									Style="{StaticResource PaneIconButtonStyle}"
									ToolTipService.ToolTip="Pop preview into Picture-in-Picture window">
									<FontIcon FontSize="13" Glyph="&#xE73F;" />
								</Button>
								<Button
									Click="SwapPreviewPlacement_Click"
									Style="{StaticResource PaneIconButtonStyle}"
									ToolTipService.ToolTip="Swap Preview and Details positions">
									<FontIcon FontSize="13" Glyph="&#xE8AB;" />
								</Button>
								<Button
									Click="HidePreviewPane_Click"
									Style="{StaticResource PaneIconButtonStyle}"
									ToolTipService.ToolTip="Hide Preview panel">
									<FontIcon FontSize="12" Glyph="&#xE711;" />
								</Button>
							</StackPanel>
						</Grid>

						<!--  Preview image well  -->
						<Border
							Grid.Row="1"
							Margin="12"
							Background="{ThemeResource HackSurfaceContainerHighBrush}"
							CornerRadius="12">
							<Grid
								Margin="8"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Stretch">
								<StackPanel
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="8"
									Visibility="{x:Bind ViewModel.IsNoPreviewVisible, Mode=OneWay}">
									<ProgressRing
										Width="30"
										Height="30"
										HorizontalAlignment="Center"
										IsActive="{x:Bind ViewModel.IsPreviewBusy, Mode=OneWay}"
										Visibility="{x:Bind ViewModel.IsPreviewBusy, Mode=OneWay}" />
									<FontIcon
										HorizontalAlignment="Center"
										FontSize="32"
										Foreground="{ThemeResource OnSurfaceVariantBrush}"
										Glyph="&#xE8B9;" />
									<TextBlock
										HorizontalAlignment="Center"
										Style="{StaticResource BodySmall}"
										Foreground="{ThemeResource OnSurfaceVariantBrush}"
										Text="{x:Bind ViewModel.PreviewStatusText, Mode=OneWay}"
										TextAlignment="Center" />
								</StackPanel>
								<Image
									x:Name="OdooEntryImage"
									HorizontalAlignment="Stretch"
									VerticalAlignment="Stretch"
									Stretch="Uniform"
									Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}" />
							</Grid>
						</Border>
					</Grid>
				</Border>
			</Grid>
		</Grid>

		<!--  Interactive Drag-to-Dock Drop Zone Overlay (sibling of WorkspaceGrid so it always spans the full workspace)  -->
		<Grid
			x:Name="DockDropOverlay"
			Grid.Row="1"
			IsHitTestVisible="False"
			Visibility="Collapsed">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>

			<Border
				x:Name="ZoneLeft"
				Grid.Row="0"
				Grid.RowSpan="2"
				Grid.Column="0"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource PrimaryBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Left" />
			</Border>

			<Border
				x:Name="ZoneRight"
				Grid.Row="0"
				Grid.RowSpan="2"
				Grid.Column="2"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource PrimaryBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Right" />
			</Border>

			<Border
				x:Name="ZoneBottom"
				Grid.Row="1"
				Grid.Column="0"
				Grid.ColumnSpan="2"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource PrimaryBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Dock Bottom" />
			</Border>

			<Border
				x:Name="ZoneSwapPreview"
				Grid.Row="1"
				Grid.Column="1"
				Margin="8"
				Background="#334CC2FF"
				BorderBrush="{ThemeResource PrimaryBrush}"
				BorderThickness="2"
				CornerRadius="8"
				Opacity="0.25"
				Visibility="Collapsed">
				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					FontSize="14"
					FontWeight="SemiBold"
					Text="Swap Preview / Details" />
			</Border>
		</Grid>
	</Grid>

</Page>
