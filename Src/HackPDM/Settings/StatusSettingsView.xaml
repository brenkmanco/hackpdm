<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Settings.StatusSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel
            MaxWidth="720"
            Margin="24,20"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Status Window" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Configure how operation logs, transfer metrics, and completion behavior work across background tasks." />
            </StackPanel>

            <!--  Log Retention Card  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnDefinitions="*,220" ColumnSpacing="16">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Log Buffer History Limit" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Maximum number of entries kept per log category (Operations, Info, Warnings &amp; Errors)."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Header="Entries per list"
                        Text="{x:Bind ViewModel.HistoryLengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </Border>

            <!--  Completion Behavior Card  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="6">
                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Window Automation" />
                    <CheckBox
                        Content="Close status window automatically when an operation completes"
                        IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />
                    <TextBlock
                        Margin="28,0,0,0"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="If errors or warnings occur during a batch upload or download, the window stays open for review."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!--  Download Persistence & Resume Card  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="6">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Download Persistence &amp; Resume" />
                        <CheckBox
                            Content="Save unfinished download progress across app restarts (recommended)"
                            IsChecked="{x:Bind ViewModel.PersistDownloadResume, Mode=TwoWay}" />
                        <TextBlock
                            Margin="28,0,0,0"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Allows Get Latest, Checkout Latest, and Dependency Downloads to resume from remaining files if the app closes. Commits are never persisted across restarts."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Border
                        Padding="12,8"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Saved Download State" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SavedDownloadStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Command="{x:Bind ViewModel.ClearSavedDownloadCommand}"
                                Content="Clear Saved Download State" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!--  Actions Card  -->
            <Border
                Padding="16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Maintenance" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Save updated log settings or clear current session log entries." />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Command="{x:Bind ViewModel.ClearLogsCommand}"
                            Content="Clear Status Logs" />
                        <Button
                            MinWidth="96"
                            Command="{x:Bind ViewModel.SubmitCommand}"
                            Content="Save"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
