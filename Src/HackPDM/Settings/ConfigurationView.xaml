<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Settings.ConfigurationView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">
	<ScrollViewer>
		<StackPanel
			MaxWidth="820"
			Margin="24,20"
			HorizontalAlignment="Stretch"
			Spacing="16">
			<StackPanel Spacing="2">
				<TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Configuration" />
				<TextBlock
					FontSize="12"
					Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					Text="Manage Odoo server credentials and local workspace folders." />
			</StackPanel>

			<Border
				Padding="16"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<StackPanel Spacing="10">
					<StackPanel Spacing="2">
						<TextBlock FontSize="16" FontWeight="SemiBold" Text="Odoo Connection" />
						<TextBlock
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Endpoint host, database, login account, and SolidWorks Document Manager key." />
					</StackPanel>
					<Frame x:Name="OdooFrame" />
				</StackPanel>
			</Border>

			<Border
				Padding="16"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6">
				<StackPanel Spacing="10">
					<StackPanel Spacing="2">
						<TextBlock FontSize="16" FontWeight="SemiBold" Text="Local Folders" />
						<TextBlock
							FontSize="12"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="Local vault directory (PWA) and temporary preview/working folder." />
					</StackPanel>
					<Frame x:Name="HackFrame" />
				</StackPanel>
			</Border>
		</StackPanel>
	</ScrollViewer>
</Page>
