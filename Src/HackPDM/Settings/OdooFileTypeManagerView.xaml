<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Settings.OdooFileTypeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Registered File Types &amp; Filters" />
                <TextBlock
                    x:Name="PolicySummaryText"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBox
                    x:Name="FilterBox"
                    Width="260"
                    PlaceholderText="Filter types or patterns…"
                    TextChanged="FilterBox_TextChanged" />
                <ProgressRing
                    x:Name="BusyRing"
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="False" />
                <Button
                    x:Name="RefreshButton"
                    Click="RefreshButton_Click"
                    Content="Refresh" />
            </StackPanel>
        </Grid>

        <TabView
            x:Name="TypesTabView"
            Grid.Row="1"
            IsAddTabButtonVisible="False">
            <TabViewItem
                x:Name="TypesTab"
                Header="Registered Types"
                IsClosable="False">
                <tv:TableView
                    x:Name="TypesTable"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind FilteredTypes}">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn
                            Width="115"
                            Binding="{Binding Extension}"
                            Header="Extension" />
                        <tv:TableViewTextColumn
                            Width="170"
                            Binding="{Binding Category}"
                            Header="Category" />
                        <tv:TableViewTextColumn
                            Width="220"
                            Binding="{Binding RegEx}"
                            Header="Regex" />
                        <tv:TableViewTextColumn
                            Width="*"
                            Binding="{Binding Description}"
                            Header="Description" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </TabViewItem>

            <TabViewItem
                x:Name="FiltersTab"
                Header="Ignore Filters"
                IsClosable="False">
                <tv:TableView
                    x:Name="FiltersTable"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind FilteredEntryFilters}">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn
                            Width="160"
                            Binding="{Binding Proto}"
                            Header="Pattern" />
                        <tv:TableViewTextColumn
                            Width="240"
                            Binding="{Binding RegEx}"
                            Header="Regular Expression" />
                        <tv:TableViewTextColumn
                            Width="*"
                            Binding="{Binding Description}"
                            Header="Description" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock
                x:Name="CountSummaryText"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button
                x:Name="CloseButton"
                Grid.Column="1"
                MinWidth="96"
                Click="CloseButton_Click"
                Content="Close" />
        </Grid>
    </Grid>
</Page>
