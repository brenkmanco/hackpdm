<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Settings.OdooFileTypeManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rep="using:HackPDM.Core.Services"
    xmlns:tv="using:WinUI.TableView"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="2">
                <TextBlock
                    FontSize="20"
                    FontWeight="SemiBold"
                    Text="Registered File Types &amp; Filters" />
                <TextBlock
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.PolicySummaryText, Mode=OneWay}" />
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <TextBox
                    Width="260"
                    PlaceholderText="Filter types or patterns…"
                    Text="{x:Bind ViewModel.FilterQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <ProgressRing
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    IsActive="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    Content="Refresh" />
            </StackPanel>
        </Grid>

        <TabView
            Grid.Row="1"
            IsAddTabButtonVisible="False">
            <TabViewItem
                Header="{x:Bind ViewModel.TypesTabHeader, Mode=OneWay}"
                IsClosable="False">
                <tv:TableView
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.FilteredTypes, Mode=OneWay}">
                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn Width="115" Header="Extension" SortMemberPath="Extension">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Extension}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="170" Header="Category" SortMemberPath="Category">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Category}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="220" Header="Regex" SortMemberPath="RegEx">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind RegEx}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="*" Header="Description" SortMemberPath="Description">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>
                </tv:TableView>
            </TabViewItem>

            <TabViewItem
                Header="{x:Bind ViewModel.FiltersTabHeader, Mode=OneWay}"
                IsClosable="False">
                <tv:TableView
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.FilteredEntryFilters, Mode=OneWay}">
                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn Width="160" Header="Pattern" SortMemberPath="Proto">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeEntryFilterRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Proto}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="240" Header="Regular Expression" SortMemberPath="RegEx">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeEntryFilterRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind RegEx}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="*" Header="Description" SortMemberPath="Description">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:FileTypeEntryFilterRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Description}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>
                </tv:TableView>
            </TabViewItem>
        </TabView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.CountSummaryText, Mode=OneWay}" />
            <Button
                Grid.Column="1"
                MinWidth="96"
                Click="CloseButton_Click"
                Content="Close" />
        </Grid>
    </Grid>
</Page>
