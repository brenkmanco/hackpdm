<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Login.ProfileManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:tv="using:WinUI.TableView"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">
	<Grid Padding="14" RowSpacing="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<Border
			Grid.Row="0"
			Padding="12,10"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
				<StackPanel Spacing="2">
					<TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Active Profile" />
					<TextBlock
						FontSize="13"
						FontWeight="SemiBold"
						Text="{x:Bind ViewModel.ConnectionTargetText, Mode=OneWay}"
						TextTrimming="CharacterEllipsis" />
				</StackPanel>
				<StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
					<Border
						Padding="8,4"
						VerticalAlignment="Center"
						Background="{ThemeResource SubtleFillColorSecondaryBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="4">
						<TextBlock FontSize="12" FontWeight="SemiBold" Text="{x:Bind ViewModel.ConnectionBadgeText, Mode=OneWay}" />
					</Border>
					<Button
						Padding="10,4"
						VerticalAlignment="Center"
						Command="{x:Bind ViewModel.LogoutCommand}"
						Content="Sign Out"
						IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
						Visibility="{x:Bind ViewModel.IsLoggedIn, Mode=OneWay}" />
				</StackPanel>
			</Grid>
		</Border>

		<StackPanel Grid.Row="1" Spacing="8">
			<InfoBar
				x:Name="StatusBannerBar"
				Title="{x:Bind ViewModel.BannerTitle, Mode=OneWay}"
				IsClosable="True"
				IsOpen="{x:Bind ViewModel.HasBanner, Mode=TwoWay}"
				Message="{x:Bind ViewModel.BannerMessage, Mode=OneWay}" />

			<Border
				Padding="12,8"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
				BorderThickness="1"
				CornerRadius="6"
				Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
				<StackPanel Spacing="6">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
						<TextBlock
							VerticalAlignment="Center"
							FontSize="12"
							FontWeight="SemiBold"
							Text="{x:Bind ViewModel.LoginStatusText, Mode=OneWay}"
							TextTrimming="CharacterEllipsis" />
						<ProgressRing
							Grid.Column="1"
							Width="16"
							Height="16"
							IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
					</Grid>
					<ProgressBar IsIndeterminate="True" />
				</StackPanel>
			</Border>
		</StackPanel>

		<Border
			Grid.Row="2"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<Border
					Grid.Row="0"
					Padding="12,7"
					BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
					BorderThickness="0,0,0,1">
					<Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
						<StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
							<TextBlock FontSize="12" FontWeight="SemiBold" Text="Status Messages" />
							<TextBlock
								FontSize="11"
								Foreground="{ThemeResource TextFillColorSecondaryBrush}"
								Text="{x:Bind ViewModel.StatusCountsText, Mode=OneWay}"
								TextTrimming="CharacterEllipsis" />
						</StackPanel>
						<StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
							<ComboBox
								MinWidth="112"
								ItemsSource="{x:Bind ViewModel.CategoryFilterOptions, Mode=OneWay}"
								SelectedIndex="{x:Bind ViewModel.SelectedCategoryFilterIndex, Mode=TwoWay}" />
							<ComboBox
								MinWidth="118"
								ItemsSource="{x:Bind ViewModel.LevelFilterOptions, Mode=OneWay}"
								SelectedIndex="{x:Bind ViewModel.SelectedLevelFilterIndex, Mode=TwoWay}" />
							<Button
								Padding="8,6"
								Command="{x:Bind ViewModel.CheckStatusCommand}"
								IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
								ToolTipService.ToolTip="Check configuration &amp; settings">
								<FontIcon FontSize="12" Glyph="&#xE72C;" />
							</Button>
							<Button
								Padding="8,6"
								Command="{x:Bind ViewModel.ClearStatusCommand}"
								IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
								ToolTipService.ToolTip="Clear status messages">
								<FontIcon FontSize="12" Glyph="&#xE74D;" />
							</Button>
						</StackPanel>
					</Grid>
				</Border>

				<Grid Grid.Row="1">
					<tv:TableView
						x:Name="ProfileManStatusList"
						AutoGenerateColumns="False"
						BorderThickness="0"
						IsReadOnly="True"
						ItemsSource="{x:Bind ViewModel.FilteredStatus, Mode=OneWay}"
						SelectionChanged="ProfileManStatusList_SelectionChanged">
						<tv:TableView.Columns>
							<tv:TableViewTextColumn Width="86" Binding="{Binding TimestampText}" Header="Time" />
							<tv:TableViewTextColumn Width="92" Binding="{Binding Status}" Header="Level" />
							<tv:TableViewTextColumn Width="118" Binding="{Binding Category}" Header="Area" />
							<tv:TableViewTextColumn Width="*" Binding="{Binding Message}" Header="Message" />
						</tv:TableView.Columns>
					</tv:TableView>
					<StackPanel
						x:Name="EmptyConnectionHint"
						Padding="20"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsHitTestVisible="False"
						Spacing="6">
						<FontIcon HorizontalAlignment="Center" FontSize="22" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE77B;" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="12"
							FontWeight="SemiBold"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}"
							Text="{x:Bind ViewModel.EmptyHintTitle, Mode=OneWay}" />
						<TextBlock
							HorizontalAlignment="Center"
							FontSize="11"
							Foreground="{ThemeResource TextFillColorTertiaryBrush}"
							Text="{x:Bind ViewModel.EmptyHintSubtitle, Mode=OneWay}"
							TextAlignment="Center"
							TextWrapping="Wrap" />
					</StackPanel>
				</Grid>

				<Border
					x:Name="SelectedMessageCard"
					Grid.Row="2"
					Padding="12,8"
					BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
					BorderThickness="0,1,0,0"
					Visibility="Collapsed">
					<TextBlock
						x:Name="SelectedMessageText"
						FontSize="12"
						IsTextSelectionEnabled="True"
						TextWrapping="Wrap" />
				</Border>
			</Grid>
		</Border>

		<Grid Grid.Row="3" ColumnSpacing="8">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Button
				Grid.Column="0"
				Height="36"
				Padding="12,5"
				Command="{x:Bind ViewModel.OpenSettingsCommand}"
				Content="Configurations…"
				IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
			<Button
				Grid.Column="1"
				Height="36"
				Padding="12,5"
				Command="{x:Bind ViewModel.TestConnectionCommand}"
				Content="{x:Bind ViewModel.TestConnectionButtonText, Mode=OneWay}"
				IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
			<Button
				Grid.Column="2"
				Height="36"
				MinWidth="140"
				Padding="12,5"
				HorizontalAlignment="Stretch"
				Command="{x:Bind ViewModel.LoginCommand}"
				Content="{x:Bind ViewModel.LoginButtonText, Mode=OneWay}"
				IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}"
				Style="{StaticResource AccentButtonStyle}" />

			<CommandBar
				Grid.Column="3"
				VerticalAlignment="Center"
				DefaultLabelPosition="Collapsed"
				IsEnabled="{x:Bind ViewModel.IsIdle, Mode=OneWay}">
				<AppBarButton Icon="More" ToolTipService.ToolTip="Profile JSON &amp; Tools">
					<AppBarButton.Flyout>
						<MenuFlyout>
							<MenuFlyoutItem Command="{x:Bind ViewModel.LoadProfileCommand}" Text="Load JSON Profile…" />
							<MenuFlyoutSubItem Text="Save Profile to JSON">
								<MenuFlyoutItem Command="{x:Bind ViewModel.SaveProfileCommand}" Text="With Password…" />
								<MenuFlyoutItem Command="{x:Bind ViewModel.SaveProfileWithoutPasswordCommand}" Text="Without Password…" />
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Command="{x:Bind ViewModel.CreateTemplateCommand}" Text="Create Template JSON…" />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Command="{x:Bind ViewModel.CheckStatusCommand}" Text="Check Configurations &amp; Settings" />
							<MenuFlyoutItem Command="{x:Bind ViewModel.ClearStatusCommand}" Text="Clear Status Messages" />
							<MenuFlyoutItem Click="OpenStatusLog_Click" Text="Open Status Log" />
						</MenuFlyout>
					</AppBarButton.Flyout>
				</AppBarButton>
			</CommandBar>
		</Grid>
	</Grid>
</Page>
