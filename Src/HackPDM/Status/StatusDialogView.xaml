<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Status.StatusDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:rep="using:HackPDM.Core.Services"
    xmlns:controls="using:HackPDM.Common"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Page.Resources>
        <DataTemplate x:Key="StatusActionCellTemplate" x:DataType="rep:BasicStatusMessage">
            <TextBlock
                Padding="4,0,4,0"
                VerticalAlignment="Center"
                Text="{x:Bind Status}" />
        </DataTemplate>
        <DataTemplate x:Key="StatusMessageCellTemplate" x:DataType="rep:BasicStatusMessage">
            <TextBlock
                Padding="4,0,4,0"
                VerticalAlignment="Center"
                Text="{x:Bind Message}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Message}" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="StatusRootGrid">
        <!--  Full Status Dialog Layout  -->
        <Grid x:Name="FullStatusRoot" Margin="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="OperationsRow" Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LowerLogsRow" Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Main Operations Log Card  -->
            <Border
                Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        Grid.Row="0"
                        Padding="10,6"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Operations" />
                    </Border>
                    <tv:TableView
                        Grid.Row="1"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
                        RowDetailsVisibilityMode="Collapsed">
                        <tv:TableView.Columns>
                            <tv:TableViewTemplateColumn
                                Width="128"
                                CellTemplate="{StaticResource StatusActionCellTemplate}"
                                Header="Action"
                                SortMemberPath="Status" />
                            <tv:TableViewTemplateColumn
                                Width="*"
                                CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                Header="Description"
                                SortMemberPath="Message" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </Grid>
            </Border>

            <!--  Resizable Horizontal Divider  -->
            <controls:PaneSplitter
                Grid.Row="1"
                DragDelta="StatusHorizontalSplitter_DragDelta"
                Orientation="Horizontal" />

            <!--  Lower Split: Info | Warnings & Errors  -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InfoLogCol" Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ErrorLogCol" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Info" />
                        </Border>
                        <tv:TableView
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.OInfo, Mode=OneWay}"
                            RowDetailsVisibilityMode="Collapsed">
                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn
                                    Width="128"
                                    CellTemplate="{StaticResource StatusActionCellTemplate}"
                                    Header="Action"
                                    SortMemberPath="Status" />
                                <tv:TableViewTemplateColumn
                                    Width="*"
                                    CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                    Header="Description"
                                    SortMemberPath="Message" />
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>

                <controls:PaneSplitter
                    Grid.Column="1"
                    DragDelta="StatusVerticalSplitter_DragDelta"
                    Orientation="Vertical" />

                <Border
                    Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Warnings &amp; Errors" />
                        </Border>
                        <tv:TableView
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.OError, Mode=OneWay}"
                            RowDetailsVisibilityMode="Collapsed">
                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn
                                    Width="128"
                                    CellTemplate="{StaticResource StatusActionCellTemplate}"
                                    Header="Action"
                                    SortMemberPath="Status" />
                                <tv:TableViewTemplateColumn
                                    Width="*"
                                    CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                    Header="Description"
                                    SortMemberPath="Message" />
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>
            </Grid>

            <!--  Progress Bar  -->
            <ProgressBar
                Grid.Row="3"
                Height="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
                Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}" />

            <!--  Progress Text, Metrics & Control Buttons  -->
            <Grid
                x:Name="StatusFooterGrid"
                Grid.Row="4"
                ColumnSpacing="12"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="StatusMetricsPanel"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasEta, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.DownloadedText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SessionDownloadedText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{x:Bind ViewModel.UploadedText, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.SessionUploadedText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="StatusActionsPanel"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="SwitchToMinimalStatus_Click"
                        Content="Minimal"
                        ToolTipService.ToolTip="Switch to compact category bar" />
                    <Button
                        x:Name="DockStatusBtn"
                        Click="DockStatusBtn_Click"
                        Content="Dock"
                        ToolTipService.ToolTip="Dock Status Log into the main window"
                        Visibility="Collapsed" />
                    <Button
                        Command="{x:Bind ViewModel.OpenLogsFolderCommand}"
                        Content="Logs Folder"
                        ToolTipService.ToolTip="Open the HackPDM diagnostic logs folder" />
                    <Button
                        Click="CopyDiagnosticsBtn_Click"
                        Content="Copy Diagnostics"
                        ToolTipService.ToolTip="Copy redacted client/server diagnostic summary to clipboard" />
                    <Button
                        Content="Configure Settings"
                        Click="StatusSettings_Click" />
                    <CheckBox
                        Content="Close When Complete"
                        IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelCommand}" />
                    <Button
                        Content="Close"
                        Click="CmdCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Minimal Status Category Strip  -->
        <Border
            x:Name="MinimalStatusRoot"
            Padding="10,6"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Message Categories  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Processing  -->
                    <Border
                        Padding="8,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        PointerPressed="CategoryPill_PointerPressed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LatestProcessingMessage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing
                                Width="13"
                                Height="13"
                                IsActive="{x:Bind ViewModel.IsInProcess, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsInProcess, Mode=OneWay}" />
                            <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.ProcessingSummaryText, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="200"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{x:Bind ViewModel.LatestProcessingMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!--  Info (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="InfoPill"
                        Padding="8,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        PointerEntered="InfoPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="12" Glyph="&#xE946;" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.InfoSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Warnings (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="WarningsPill"
                        Padding="8,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        PointerEntered="WarningsPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="WarningsPillIcon" FontSize="12" Glyph="&#xE7BA;" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.WarningSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Errors (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="ErrorsPill"
                        Padding="8,4"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        PointerEntered="ErrorsPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="ErrorsPillIcon" FontSize="12" Glyph="&#xEA39;" />
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="{x:Bind ViewModel.ErrorSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Progress + Expand / Host Controls  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.CompactProgressText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasEta, Mode=OneWay}" />
                    <ProgressBar
                        Width="88"
                        Height="6"
                        VerticalAlignment="Center"
                        IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                        Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
                        Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}" />
                    <Button
                        Padding="8,4"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Cancel"
                        FontSize="11"
                        Visibility="{x:Bind ViewModel.IsInProcess, Mode=OneWay}" />
                    <Button
                        Padding="10,4"
                        Click="OpenFullStatus_Click"
                        Content="Full Log"
                        FontSize="12"
                        ToolTipService.ToolTip="Open full Status Dialog" />
                    <Button
                        x:Name="MiniDockStatusBtn"
                        Padding="8,4"
                        Click="DockStatusBtn_Click"
                        Content="Dock"
                        FontSize="12"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="MiniCloseStatusBtn"
                        Padding="8,4"
                        Click="CmdCloseClick"
                        Content="Close"
                        FontSize="12"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Interactive Clickable Hover Popup for Info, Warnings & Errors (child card is strongly held in code-behind)  -->
        <primitives:Popup
            x:Name="StatusHoverPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsLightDismissEnabled="False" />

        <Grid.Resources>
            <DataTemplate x:Key="HoverPopupItemTemplate" x:DataType="rep:BasicStatusMessage">
                <Border
                    Margin="0,0,0,4"
                    Padding="8,6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4">
                    <StackPanel Spacing="2">
                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="{x:Bind TimestampText}" />
                        <TextBlock
                            FontSize="12"
                            Text="{x:Bind Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
    </Grid>
</Page>
