<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Status.StatusDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pp="urn:wyrmpdm:penpot-sync"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives"
    xmlns:rep="using:HackPDM.Core.Services"
    xmlns:controls="using:HackPDM.Common"
    Background="{ThemeResource BackgroundBrush}"
    mc:Ignorable="d pp">
    <Page.Resources>
        <!--
            Material look for this screen, built from the Penpot frames "Status — Light" / "— Dark" (full log) and
            "Status bar — Light" / "— Dark" (minimal strip). Elements marked pp:Id are kept in step with those frames
            by tools/WyrmpdmSync (see design/README.md). The minimal strip's warning/error pill colors and the hover
            card are set in code (StatusDialogView.xaml.cs) from the same Material roles.
        -->
        <DataTemplate x:Key="StatusActionCellTemplate" x:DataType="rep:BasicStatusMessage">
            <TextBlock
                Padding="4,0,4,0"
                VerticalAlignment="Center"
                Text="{x:Bind Status}" />
        </DataTemplate>
        <DataTemplate x:Key="StatusMessageCellTemplate" x:DataType="rep:BasicStatusMessage">
            <TextBlock
                Padding="4,0,4,0"
                VerticalAlignment="Center"
                Text="{x:Bind Message}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind Message}" />
        </DataTemplate>
    </Page.Resources>
    <Grid x:Name="StatusRootGrid">
        <!--  Full Status Dialog Layout  -->
        <Grid x:Name="FullStatusRoot" Margin="12" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="OperationsRow" Height="3*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="LowerLogsRow" Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Saved Download Resume Banner  -->
            <Border
                pp:Id="status.banner"
                Grid.Row="0"
                Style="{StaticResource HackBannerInfoStyle}"
                Visibility="{x:Bind ViewModel.ShowResumableDownloadBanner, Mode=OneWay}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource OnSecondaryContainerBrush}"
                        Glyph="&#xE896;" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            pp:Id="status.bannerTitle"
                            Foreground="{ThemeResource OnSecondaryContainerBrush}"
                            Style="{StaticResource TitleSmall}"
                            Text="Unfinished download ready to resume" />
                        <TextBlock
                            Foreground="{ThemeResource OnSecondaryContainerBrush}"
                            Style="{StaticResource BodySmall}"
                            Text="{x:Bind ViewModel.ResumableDownloadSummary, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                        <Button
                            pp:Id="status.resume"
                            Command="{x:Bind ViewModel.ResumeSavedDownloadCommand}"
                            Content="Resume Download"
                            Style="{StaticResource FilledButtonStyle}" />
                        <Button
                            Command="{x:Bind ViewModel.ClearSavedDownloadCommand}"
                            Content="Clear"
                            Style="{StaticResource TextButtonStyle}"
                            ToolTipService.ToolTip="Discard saved download progress" />
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Main Operations Log Card  -->
            <Border
                pp:Id="status.operations"
                Grid.Row="1"
                BorderThickness="{StaticResource HackPanelBorderThickness}"
                CornerRadius="{StaticResource HackPanelCornerRadius}"
                Style="{StaticResource HackPaneOutlinedStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        pp:Id="status.operationsTitle"
                        Grid.Row="0"
                        Margin="16,12,16,4"
                        Style="{StaticResource HackPaneTitleStyle}"
                        Text="Operations" />
                    <tv:TableView
                        Grid.Row="1"
                        Margin="8,0,8,8"
                        AutoGenerateColumns="False"
                        BorderThickness="0"
                        CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                        IsReadOnly="True"
                        ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
                        RowDetailsVisibilityMode="Collapsed">
                        <tv:TableView.Columns>
                            <tv:TableViewTemplateColumn
                                Width="128"
                                CellTemplate="{StaticResource StatusActionCellTemplate}"
                                Header="Action"
                                SortMemberPath="Status" />
                            <tv:TableViewTemplateColumn
                                Width="*"
                                CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                Header="Description"
                                SortMemberPath="Message" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </Grid>
            </Border>

            <!--  Resizable Horizontal Divider  -->
            <controls:PaneSplitter
                Grid.Row="2"
                DragCompleted="StatusSplitter_DragCompleted"
                DragDelta="StatusHorizontalSplitter_DragDelta"
                Orientation="Horizontal" />

            <!--  Lower Split: Info | Warnings & Errors  -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="InfoLogCol" Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="ErrorLogCol" Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    pp:Id="status.info"
                    Grid.Column="0"
                    BorderThickness="{StaticResource HackPanelBorderThickness}"
                    CornerRadius="{StaticResource HackPanelCornerRadius}"
                    Style="{StaticResource HackPaneOutlinedStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            pp:Id="status.infoTitle"
                            Grid.Row="0"
                            Margin="16,12,16,4"
                            Style="{StaticResource HackPaneTitleStyle}"
                            Text="Info" />
                        <tv:TableView
                            Grid.Row="1"
                            Margin="8,0,8,8"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.OInfo, Mode=OneWay}"
                            RowDetailsVisibilityMode="Collapsed">
                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn
                                    Width="128"
                                    CellTemplate="{StaticResource StatusActionCellTemplate}"
                                    Header="Action"
                                    SortMemberPath="Status" />
                                <tv:TableViewTemplateColumn
                                    Width="*"
                                    CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                    Header="Description"
                                    SortMemberPath="Message" />
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>

                <controls:PaneSplitter
                    Grid.Column="1"
                    DragCompleted="StatusSplitter_DragCompleted"
                    DragDelta="StatusVerticalSplitter_DragDelta"
                    Orientation="Vertical" />

                <Border
                    pp:Id="status.errors"
                    Grid.Column="2"
                    BorderThickness="{StaticResource HackPanelBorderThickness}"
                    CornerRadius="{StaticResource HackPanelCornerRadius}"
                    Style="{StaticResource HackPaneOutlinedStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            pp:Id="status.errorsTitle"
                            Grid.Row="0"
                            Margin="16,12,16,4"
                            Style="{StaticResource HackPaneTitleStyle}"
                            Text="Warnings &amp; Errors" />
                        <tv:TableView
                            Grid.Row="1"
                            Margin="8,0,8,8"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            CanSortColumns="{x:Bind ViewModel.CanSortLogColumns, Mode=OneWay}"
                            IsReadOnly="True"
                            ItemsSource="{x:Bind ViewModel.OError, Mode=OneWay}"
                            RowDetailsVisibilityMode="Collapsed">
                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn
                                    Width="128"
                                    CellTemplate="{StaticResource StatusActionCellTemplate}"
                                    Header="Action"
                                    SortMemberPath="Status" />
                                <tv:TableViewTemplateColumn
                                    Width="*"
                                    CellTemplate="{StaticResource StatusMessageCellTemplate}"
                                    Header="Description"
                                    SortMemberPath="Message" />
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>
            </Grid>

            <!--  Progress Bar  -->
            <ProgressBar
                Grid.Row="4"
                Height="4"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Center"
                IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
                Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}" />

            <!--  Progress Text, Metrics & Control Buttons  -->
            <Grid
                x:Name="StatusFooterGrid"
                Grid.Row="5"
                ColumnSpacing="12"
                RowSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel
                    x:Name="StatusMetricsPanel"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="14">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyMedium}"
                        Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HackCaptionStyle}"
                        Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasEta, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HackCaptionStyle}"
                        Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HackCaptionStyle}" Text="{x:Bind ViewModel.DownloadedText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource HackCaptionStyle}" Text="{x:Bind ViewModel.SessionDownloadedText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource HackCaptionStyle}" Text="{x:Bind ViewModel.UploadedText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource HackCaptionStyle}" Text="{x:Bind ViewModel.SessionUploadedText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="StatusActionsPanel"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="SwitchToMinimalStatus_Click"
                        Content="Minimal"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Switch to compact category bar" />
                    <Button
                        x:Name="DockStatusBtn"
                        Click="DockStatusBtn_Click"
                        Content="Dock"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Dock Status Log into the main window"
                        Visibility="Collapsed" />
                    <Button
                        Command="{x:Bind ViewModel.OpenLogsFolderCommand}"
                        Content="Logs Folder"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Open the HackPDM diagnostic logs folder" />
                    <Button
                        Click="CopyDiagnosticsBtn_Click"
                        Content="Copy Diagnostics"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Copy redacted client/server diagnostic summary to clipboard" />
                    <Button
                        Content="Configure Settings"
                        Click="StatusSettings_Click"
                        Style="{StaticResource TextButtonStyle}" />
                    <CheckBox
                        Content="Close When Complete"
                        IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />
                    <Button
                        Command="{x:Bind ViewModel.TogglePauseCommand}"
                        Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowPauseButton, Mode=OneWay}" />
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Style="{StaticResource OutlinedButtonStyle}" />
                    <Button
                        pp:Id="status.close"
                        Content="Close"
                        Click="CmdCloseClick"
                        Style="{StaticResource FilledTonalButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Minimal Status Category Strip  -->
        <Border
            x:Name="MinimalStatusRoot"
            pp:Id="status.bar"
            Margin="12"
            VerticalAlignment="Center"
            Style="{StaticResource HackToolbarStyle}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Message Categories  -->
                <StackPanel
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <!--  Processing  -->
                    <Border
                        Padding="10,6,12,6"
                        Background="Transparent"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PointerPressed="CategoryPill_PointerPressed"
                        ToolTipService.ToolTip="{x:Bind ViewModel.LatestProcessingMessage, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <ProgressRing
                                Width="13"
                                Height="13"
                                IsActive="{x:Bind ViewModel.IsActivelyRunning, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsInProcess, Mode=OneWay}" />
                            <FontIcon FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" Glyph="&#xE9D9;" />
                            <TextBlock
                                Style="{StaticResource LabelLarge}"
                                Text="{x:Bind ViewModel.ProcessingSummaryText, Mode=OneWay}" />
                            <TextBlock
                                MaxWidth="200"
                                VerticalAlignment="Center"
                                Style="{StaticResource HackCaptionStyle}"
                                Text="{x:Bind ViewModel.LatestProcessingMessage, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>

                    <!--  Info (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="InfoPill"
                        Padding="10,6,12,6"
                        Background="Transparent"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PointerEntered="InfoPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" Glyph="&#xE946;" />
                            <TextBlock
                                Style="{StaticResource LabelLarge}"
                                Text="{x:Bind ViewModel.InfoSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Warnings (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="WarningsPill"
                        Padding="10,6,12,6"
                        Background="Transparent"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PointerEntered="WarningsPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="WarningsPillIcon" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" Glyph="&#xE7BA;" />
                            <TextBlock
                                Style="{StaticResource LabelLarge}"
                                Text="{x:Bind ViewModel.WarningSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>

                    <!--  Errors (hover opens details popup; click opens full Status Dialog)  -->
                    <Border
                        x:Name="ErrorsPill"
                        Padding="10,6,12,6"
                        Background="Transparent"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        PointerEntered="ErrorsPill_PointerEntered"
                        PointerExited="CategoryPill_PointerExited"
                        PointerPressed="CategoryPill_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <FontIcon x:Name="ErrorsPillIcon" FontSize="14" Foreground="{ThemeResource OnSurfaceVariantBrush}" Glyph="&#xEA39;" />
                            <TextBlock
                                Style="{StaticResource LabelLarge}"
                                Text="{x:Bind ViewModel.ErrorSummaryText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!--  Progress + Expand / Host Controls  -->
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HackCaptionStyle}"
                        Text="{x:Bind ViewModel.CompactProgressText, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HackCaptionStyle}"
                        Text="{x:Bind ViewModel.EtaText, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasEta, Mode=OneWay}" />
                    <ProgressBar
                        Width="88"
                        Height="4"
                        VerticalAlignment="Center"
                        IsIndeterminate="{x:Bind ViewModel.IsIndeterminate, Mode=OneWay}"
                        Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
                        Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.TogglePauseCommand}"
                        Content="{x:Bind ViewModel.PauseButtonText, Mode=OneWay}"
                        Style="{StaticResource TextButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowPauseButton, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.CancelCommand}"
                        Content="Cancel"
                        Style="{StaticResource TextButtonStyle}"
                        Visibility="{x:Bind ViewModel.IsInProcess, Mode=OneWay}" />
                    <Button
                        Command="{x:Bind ViewModel.ResumeSavedDownloadCommand}"
                        Content="Resume Saved"
                        Style="{StaticResource FilledButtonStyle}"
                        Visibility="{x:Bind ViewModel.ShowResumableDownloadBanner, Mode=OneWay}" />
                    <Button
                        Click="OpenFullStatus_Click"
                        Content="Full Log"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Open full Status Dialog" />
                    <Button
                        x:Name="MiniDockStatusBtn"
                        Click="DockStatusBtn_Click"
                        Content="Dock"
                        Style="{StaticResource TextButtonStyle}"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="MiniCloseStatusBtn"
                        Click="CmdCloseClick"
                        Content="Close"
                        Style="{StaticResource TextButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Interactive Clickable Hover Popup for Info, Warnings & Errors (child card is strongly held in code-behind)  -->
        <primitives:Popup
            x:Name="StatusHoverPopup"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsLightDismissEnabled="False" />

        <Grid.Resources>
            <DataTemplate x:Key="HoverPopupItemTemplate" x:DataType="rep:BasicStatusMessage">
                <Border
                    Margin="0,0,0,4"
                    Padding="10,6"
                    Background="{ThemeResource HackSurfaceContainerBrush}"
                    CornerRadius="8">
                    <StackPanel Spacing="2">
                        <TextBlock
                            Style="{StaticResource HackCaptionStyle}"
                            Text="{x:Bind TimestampText}" />
                        <TextBlock
                            Style="{StaticResource BodyMedium}"
                            Text="{x:Bind Message}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </DataTemplate>
            <Style TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </Grid.Resources>
    </Grid>
</Page>
