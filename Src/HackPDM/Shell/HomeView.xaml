<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Shell.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:HackPDM.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid KeyDown="HomeView_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Navigation rail (Penpot: Navigation rail): labeled destinations, the Search and Status drawers, Settings  -->
        <Grid x:Name="NavRail" Padding="0,8,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Button
                x:Name="RailBackButton"
                Margin="0,0,0,8"
                HorizontalAlignment="Center"
                Click="RailBack_Click"
                IsEnabled="False"
                Style="{StaticResource PaneIconButtonStyle}"
                ToolTipService.ToolTip="Back (Alt+Left)">
                <FontIcon FontSize="16" Glyph="&#xE72B;" />
            </Button>
            <StackPanel Grid.Row="1" Spacing="8">
                <controls:NavRailItem
                    x:Name="FilesRailItem"
                    Click="RailItem_Click"
                    Glyph="&#xE8B7;"
                    Label="Files"
                    Style="{StaticResource HackNavRailItemStyle}"
                    Tag="HackFileManager"
                    ToolTipService.ToolTip="Hack File Manager (Ctrl+1)" />
                <controls:NavRailItem
                    x:Name="GraphRailItem"
                    Click="RailItem_Click"
                    Glyph="&#xE71D;"
                    Label="Graph"
                    Style="{StaticResource HackNavRailItemStyle}"
                    Tag="DependencyGraph"
                    ToolTipService.ToolTip="Dependency Graph (Ctrl+2)" />
                <controls:NavRailItem
                    x:Name="ProfilesRailItem"
                    Click="RailItem_Click"
                    Glyph="&#xE77B;"
                    Label="Profiles"
                    Style="{StaticResource HackNavRailItemStyle}"
                    Tag="ProfileManager"
                    ToolTipService.ToolTip="Profile Manager (Ctrl+3)" />
                <controls:NavRailItem
                    x:Name="ConfigsRailItem"
                    Click="RailItem_Click"
                    Glyph="&#xE9E9;"
                    Label="Configs"
                    Style="{StaticResource HackNavRailItemStyle}"
                    Tag="Configuration"
                    ToolTipService.ToolTip="Server &amp; Folder Configurations (Ctrl+4)" />
                <controls:NavRailItem
                    x:Name="SearchRailItem"
                    Click="SearchRail_Click"
                    Glyph="&#xE721;"
                    Label="Search"
                    Style="{StaticResource HackNavRailItemStyle}"
                    ToolTipService.ToolTip="Toggle Search Vault Panel (Ctrl+F)" />
                <controls:NavRailItem
                    x:Name="StatusRailItem"
                    Click="StatusRail_Click"
                    Glyph="&#xE9D9;"
                    Label="Status"
                    Style="{StaticResource HackNavRailItemStyle}"
                    ToolTipService.ToolTip="Toggle Status Log Panel (Alt+S)" />
            </StackPanel>
            <controls:NavRailItem
                x:Name="SettingsRailItem"
                Grid.Row="2"
                Click="RailItem_Click"
                Glyph="&#xE713;"
                Label="Settings"
                Style="{StaticResource HackNavRailItemStyle}"
                Tag="Settings"
                ToolTipService.ToolTip="Settings" />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusDrawerRow" Height="0" />
            </Grid.RowDefinitions>

            <!--  Primary Workspace Frame + Optional Side Search Drawer  -->
            <Grid x:Name="MainAndSearchGrid" Grid.Row="0">
                <Frame x:Name="NavFrame" Margin="0,0,0,0" />

                <controls:PaneSplitter
                    x:Name="SearchSplitter"
                    DragCompleted="ShellSplitter_DragCompleted"
                    DragDelta="SearchSplitter_DragDelta"
                    Orientation="Vertical"
                    Visibility="Collapsed" />

                <!--  Docked Search Vault Extension  -->
                <Border
                    x:Name="DockedSearchDrawer"
                    Background="{ThemeResource HackSurfaceContainerLowBrush}"
                    BorderBrush="{StaticResource HackPanelStrokeBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="SearchDrawerHeader"
                            Grid.Row="0"
                            Padding="16,4,8,4"
                            BorderBrush="{ThemeResource OutlineVariantBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <FontIcon
                                        FontSize="16"
                                        Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                        Glyph="&#xE721;" />
                                    <TextBlock Style="{StaticResource HackPaneTitleStyle}" Text="Search Vault" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        Style="{StaticResource PaneIconButtonStyle}"
                                        Click="SwitchSearchMinimal_Click"
                                        ToolTipService.ToolTip="Switch to minimal search bar">
                                        <FontIcon FontSize="13" Glyph="&#xE73F;" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource PaneIconButtonStyle}"
                                        Click="SwapSearchSide_Click"
                                        ToolTipService.ToolTip="Move Search Left or Right">
                                        <FontIcon FontSize="13" Glyph="&#xE8AB;" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource PaneIconButtonStyle}"
                                        Click="DetachSearch_Click"
                                        ToolTipService.ToolTip="Detach Search into separate window">
                                        <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                    </Button>
                                    <Button
                                        Style="{StaticResource PaneIconButtonStyle}"
                                        Click="CloseSearchDrawer_Click"
                                        ToolTipService.ToolTip="Close Search panel">
                                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <ContentControl
                                x:Name="DockedSearchHost"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                            <StackPanel
                                x:Name="MiniSearchHostActions"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="Collapsed">
                                <Button
                                    Style="{StaticResource PaneIconButtonStyle}"
                                    Click="DetachSearch_Click"
                                    ToolTipService.ToolTip="Detach Search into separate window">
                                    <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                </Button>
                                <Button
                                    Style="{StaticResource PaneIconButtonStyle}"
                                    Click="CloseSearchDrawer_Click"
                                    ToolTipService.ToolTip="Close Search bar">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--  Horizontal Splitter: Main Workspace <-> Status Log Drawer  -->
            <controls:PaneSplitter
                x:Name="StatusSplitter"
                Grid.Row="1"
                DragCompleted="ShellSplitter_DragCompleted"
                DragDelta="StatusSplitter_DragDelta"
                Orientation="Horizontal"
                Visibility="Collapsed" />

            <!--  Docked Bottom Status Log Extension  -->
            <Border
                x:Name="DockedStatusDrawer"
                Grid.Row="2"
                Background="{ThemeResource HackSurfaceContainerLowBrush}"
                BorderBrush="{StaticResource HackPanelStrokeBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="StatusDrawerHeader"
                        Grid.Row="0"
                        Padding="16,4,8,4"
                        BorderBrush="{ThemeResource OutlineVariantBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource OnSurfaceVariantBrush}"
                                    Glyph="&#xE9D9;" />
                                <TextBlock Style="{StaticResource HackPaneTitleStyle}" Text="Status Log" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    Style="{StaticResource PaneIconButtonStyle}"
                                    Click="SwitchStatusMinimal_Click"
                                    ToolTipService.ToolTip="Switch to minimal status category bar">
                                    <FontIcon FontSize="13" Glyph="&#xE73F;" />
                                </Button>
                                <Button
                                    Style="{StaticResource PaneIconButtonStyle}"
                                    Click="DetachStatus_Click"
                                    ToolTipService.ToolTip="Detach Status Log into separate window">
                                    <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                                </Button>
                                <Button
                                    Style="{StaticResource PaneIconButtonStyle}"
                                    Click="CloseStatusDrawer_Click"
                                    ToolTipService.ToolTip="Hide Status Log panel">
                                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <ContentControl
                            x:Name="DockedStatusHost"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                        <StackPanel
                            x:Name="MiniStatusHostActions"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="Collapsed">
                            <Button
                                Style="{StaticResource PaneIconButtonStyle}"
                                Click="DetachStatus_Click"
                                ToolTipService.ToolTip="Detach Status bar into separate window">
                                <FontIcon FontSize="13" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                Style="{StaticResource PaneIconButtonStyle}"
                                Click="CloseStatusDrawer_Click"
                                ToolTipService.ToolTip="Hide Status bar">
                                <FontIcon FontSize="14" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  In-Window Overlay Canvas (hover popups from bottom minimal status bar, etc.)  -->
        <Canvas x:Name="ShellOverlayCanvas" Grid.ColumnSpan="2" />
    </Grid>
</Page>
