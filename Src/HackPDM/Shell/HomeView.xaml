<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Shell.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:controls="using:HackPDM.Common"
    xmlns:local="using:HackPDM.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <NavigationView
            x:Name="HomeNavigator"
            AlwaysShowHeader="False"
        BackRequested="HomeNavigator_BackRequested"
        ExpandedModeThresholdWidth="900"
        Header="HackPDM"
        IsBackButtonVisible="Auto"
        IsBackEnabled="False"
        IsSettingsVisible="True"
        IsTabStop="False"
        ItemInvoked="HomeNavigator_ItemInvoked"
        KeyDown="HomeView_KeyDown"
        PaneDisplayMode="LeftCompact"
        PaneTitle="HackPDM"
        SelectionChanged="HomeNavigator_SelectionChanged"
        SelectionFollowsFocus="Disabled">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HackNav"
                Content="Hack File Manager"
                Tag="HackFileManager"
                ToolTipService.ToolTip="Hack File Manager (Ctrl+1)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Folder" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="GraphNav"
                Content="Dependency Graph"
                Tag="DependencyGraph"
                ToolTipService.ToolTip="Dependency Graph (Ctrl+2)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE71D;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem
                x:Name="ProfileNav"
                Content="Profile Manager"
                Tag="ProfileManager"
                ToolTipService.ToolTip="Profile Manager (Ctrl+3)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Account" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="HackOdooNav"
                Content="Configurations"
                Tag="Configuration"
                ToolTipService.ToolTip="Server &amp; Folder Configurations (Ctrl+4)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9E9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem
                x:Name="SearchNav"
                Content="Search Vault"
                SelectsOnInvoked="False"
                Tag="SearchVault"
                ToolTipService.ToolTip="Toggle Search Vault Panel (Ctrl+F)">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Find" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem
                x:Name="StatusLogNav"
                Content="Status Log"
                SelectsOnInvoked="False"
                Tag="StatusLog"
                ToolTipService.ToolTip="Toggle Status Log Panel (Alt+S)">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE9D9;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Grid x:Name="ShellExtensionsGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="StatusDrawerRow" Height="0" />
            </Grid.RowDefinitions>

            <!--  Primary Workspace Frame + Optional Side Search Drawer  -->
            <Grid x:Name="MainAndSearchGrid" Grid.Row="0">
                <Frame x:Name="NavFrame" Margin="0,0,0,0" />

                <controls:PaneSplitter
                    x:Name="SearchSplitter"
                    DragCompleted="ShellSplitter_DragCompleted"
                    DragDelta="SearchSplitter_DragDelta"
                    Orientation="Vertical"
                    Visibility="Collapsed" />

                <!--  Docked Search Vault Extension  -->
                <Border
                    x:Name="DockedSearchDrawer"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{StaticResource HackPanelStrokeBrush}"
                    BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="SearchDrawerHeader"
                            Grid.Row="0"
                            Padding="10,6"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE721;" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Text="Search Vault" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="2">
                                    <Button
                                        x:Name="MinimalSearchHeaderButton"
                                        Padding="6,4"
                                        Click="SwitchSearchMinimal_Click"
                                        ToolTipService.ToolTip="Switch to minimal search bar">
                                        <FontIcon FontSize="11" Glyph="&#xE73F;" />
                                    </Button>
                                    <Button
                                        Padding="6,4"
                                        Click="SwapSearchSide_Click"
                                        ToolTipService.ToolTip="Move Search Left or Right">
                                        <FontIcon FontSize="11" Glyph="&#xE8AB;" />
                                    </Button>
                                    <Button
                                        x:Name="DetachSearchButton"
                                        Padding="6,4"
                                        Click="DetachSearch_Click"
                                        ToolTipService.ToolTip="Detach Search into separate window">
                                        <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                    </Button>
                                    <Button
                                        Padding="6,4"
                                        Click="CloseSearchDrawer_Click"
                                        ToolTipService.ToolTip="Close Search panel">
                                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                            <ContentControl
                                x:Name="DockedSearchHost"
                                Grid.Column="0"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
                            <StackPanel
                                x:Name="MiniSearchHostActions"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2"
                                Visibility="Collapsed">
                                <Button
                                    Padding="6,4"
                                    Click="DetachSearch_Click"
                                    ToolTipService.ToolTip="Detach Search into separate window">
                                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                </Button>
                                <Button
                                    Padding="6,4"
                                    Click="CloseSearchDrawer_Click"
                                    ToolTipService.ToolTip="Close Search bar">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--  Horizontal Splitter: Main Workspace <-> Status Log Drawer  -->
            <controls:PaneSplitter
                x:Name="StatusSplitter"
                Grid.Row="1"
                DragCompleted="ShellSplitter_DragCompleted"
                DragDelta="StatusSplitter_DragDelta"
                Orientation="Horizontal"
                Visibility="Collapsed" />

            <!--  Docked Bottom Status Log Extension  -->
            <Border
                x:Name="DockedStatusDrawer"
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{StaticResource HackPanelStrokeBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border
                        x:Name="StatusDrawerHeader"
                        Grid.Row="0"
                        Padding="10,5"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <FontIcon FontSize="12" Glyph="&#xE9D9;" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Status Log" />
                            </StackPanel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    x:Name="MinimalStatusHeaderButton"
                                    Padding="6,4"
                                    Click="SwitchStatusMinimal_Click"
                                    ToolTipService.ToolTip="Switch to minimal status category bar">
                                    <FontIcon FontSize="11" Glyph="&#xE73F;" />
                                </Button>
                                <Button
                                    x:Name="DetachStatusButton"
                                    Padding="6,4"
                                    Click="DetachStatus_Click"
                                    ToolTipService.ToolTip="Detach Status Log into separate window">
                                    <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                                </Button>
                                <Button
                                    Padding="6,4"
                                    Click="CloseStatusDrawer_Click"
                                    ToolTipService.ToolTip="Hide Status Log panel">
                                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <ContentControl
                            x:Name="DockedStatusHost"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
                        <StackPanel
                            x:Name="MiniStatusHostActions"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="Collapsed">
                            <Button
                                Padding="6,4"
                                Click="DetachStatus_Click"
                                ToolTipService.ToolTip="Detach Status bar into separate window">
                                <FontIcon FontSize="11" Glyph="&#xE8A7;" />
                            </Button>
                            <Button
                                Padding="6,4"
                                Click="CloseStatusDrawer_Click"
                                ToolTipService.ToolTip="Hide Status bar">
                                <FontIcon FontSize="10" Glyph="&#xE711;" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        </NavigationView>

        <!--  In-Window Overlay Canvas (hover popups from bottom minimal status bar, etc.)  -->
        <Canvas x:Name="ShellOverlayCanvas" />
    </Grid>
</Page>
