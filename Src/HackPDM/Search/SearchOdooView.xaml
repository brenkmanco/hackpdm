<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Search.SearchOdooView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:HackPDM.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pp="urn:wyrmpdm:penpot-sync"
    xmlns:rep="using:HackPDM.Core.Services"
    Background="{ThemeResource BackgroundBrush}"
    mc:Ignorable="d pp">

    <Page.Resources>
        <common:OperatorConverter x:Key="OperationConverter" />
        <!--
            Material look for this screen, built from the Penpot frames "Search — Light" / "— Dark" (full view) and
            "Search bar — Light" / "— Dark" (minimal bar). Elements marked pp:Id are kept in step with those frames
            by tools/WyrmpdmSync (see design/README.md).
        -->
    </Page.Resources>

    <Grid>
        <!--  Full Search View  -->
        <Grid x:Name="FullSearchRoot" Margin="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Query & Property Builder Card  -->
            <Border
                x:Name="QueryBuilderCard"
                pp:Id="search.query"
                Grid.Row="0"
                Padding="16"
                CornerRadius="{StaticResource HackPanelCornerRadius}"
                Style="{StaticResource HackPaneTintedStyle}">
                <Grid x:Name="QueryLayoutGrid" ColumnSpacing="20" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="FilenameSection" Grid.Column="0" Spacing="10">
                        <TextBlock
                            pp:Id="search.filenameTitle"
                            Style="{StaticResource TitleSmall}"
                            Text="Filename &amp; Scope" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="136" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="96" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                Header="Match"
                                Grid.Column="0"
                                Style="{StaticResource HackOutlinedComboBoxStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OperatorList}"
                                SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:OperatorsRow">
                                        <TextBlock Text="{x:Bind OpRepr}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox
                                Grid.Column="1"
                                Header="Filename"
                                PlaceholderText="Search by filename…"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OutlinedTextBoxStyle}"
                                KeyDown="FileNameTextbox_KeyDown"
                                Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Grid.Column="2"
                                Header="Max"
                                KeyDown="FileNameTextbox_KeyDown"
                                Style="{StaticResource OutlinedTextBoxStyle}"
                                Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel x:Name="CheckboxesPanel" Orientation="Horizontal" Spacing="16">
                            <CheckBox
                                MinWidth="0"
                                Content="Checked Out to Me"
                                IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                            <CheckBox
                                MinWidth="0"
                                Content="Local Only"
                                IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
                            <CheckBox
                                MinWidth="0"
                                Content="Deleted on Server"
                                IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="QueryDivider"
                        Grid.Column="1"
                        Width="1"
                        Background="{ThemeResource OutlineVariantBrush}" />

                    <StackPanel x:Name="PropertySection" Grid.Column="2" Spacing="10">
                        <TextBlock
                            pp:Id="search.propertyTitle"
                            Style="{StaticResource TitleSmall}"
                            Text="Property Filter Builder" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="124" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                Header="Property"
                                Grid.Column="0"
                                Style="{StaticResource HackOutlinedComboBoxStyle}"
                                PlaceholderText="Choose a property"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.PropertiesSearchable}"
                                SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox
                                Header="Comparer"
                                Grid.Column="1"
                                Style="{StaticResource HackOutlinedComboBoxStyle}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OperatorList}"
                                SelectedItem="{x:Bind ViewModel.SelectedPropertyOperator, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:OperatorsRow">
                                        <TextBlock Text="{x:Bind OpRepr}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox
                                Grid.Column="2"
                                Header="Value"
                                PlaceholderText="Property value…"
                                HorizontalAlignment="Stretch"
                                Style="{StaticResource OutlinedTextBoxStyle}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                KeyDown="OdooSearchPropValue_KeyDown"
                                Text="{x:Bind ViewModel.PropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                pp:Id="search.addRule"
                                Grid.Column="3"
                                MinWidth="84"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.AddPropertyCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Add Rule"
                                Style="{StaticResource FilledTonalButtonStyle}" />
                        </Grid>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                Command="{x:Bind ViewModel.DeletePropertiesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Remove Selected Rule"
                                Style="{StaticResource TextButtonStyle}" />
                            <Button
                                Command="{x:Bind ViewModel.ResetPropertiesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Clear Rules"
                                Style="{StaticResource TextButtonStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Active Property Rules Card  -->
            <Border
                pp:Id="search.rules"
                Grid.Row="1"
                Padding="8,0,8,8"
                BorderThickness="{StaticResource HackPanelBorderThickness}"
                CornerRadius="{StaticResource HackPanelCornerRadius}"
                Style="{StaticResource HackPaneOutlinedStyle}">
                <common:EntryTableView
                    x:Name="OdooSearchPropList"
                    Height="110"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.PropertiesActive}"
                    SelectionMode="Extended"
                    SelectionUnit="Row"
                    ShowDragRectangle="False">
                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn Width="2*" Header="Property Name" SortMemberPath="Name">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>

                        <tv:TableViewTemplateColumn Width="1*" Header="Comparer" SortMemberPath="Comparer">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Comparer, Converter={StaticResource OperationConverter}}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>

                        <tv:TableViewTemplateColumn Width="2*" Header="Value" SortMemberPath="Value">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Value}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>
                </common:EntryTableView>
            </Border>

            <!--  Search Results Card  -->
            <Border
                pp:Id="search.results"
                Grid.Row="2"
                Padding="8,0,8,8"
                BorderThickness="{StaticResource HackPanelBorderThickness}"
                CornerRadius="{StaticResource HackPanelCornerRadius}"
                Style="{StaticResource HackPaneOutlinedStyle}">
                <common:EntryTableView
                    x:Name="OdooSearchResults"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    IsReadOnly="True"
                    DoubleTapped="OdooSearchResults_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
                    SelectionMode="Extended"
                    SelectionUnit="Row"
                    ShowDragRectangle="False">

                    <tv:TableView.Columns>
                        <tv:TableViewTemplateColumn Width="320" Header="File Name" SortMemberPath="Name">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:SearchRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                        <tv:TableViewTemplateColumn Width="*" Header="File Path" SortMemberPath="Directory">
                            <tv:TableViewTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="rep:SearchRow">
                                    <TextBlock
                                        Padding="6,0"
                                        VerticalAlignment="Center"
                                        Text="{x:Bind Directory}"
                                        TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </tv:TableViewTemplateColumn.CellTemplate>
                        </tv:TableViewTemplateColumn>
                    </tv:TableView.Columns>
                    <tv:TableView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                Click="LocateSelected_Click"
                                Text="Show in File Manager" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem Text="Checkout">
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CheckoutCommand}"
                                    Text="Checkout" />
                                <MenuFlyoutItem
                                    Command="{x:Bind ViewModel.CheckoutAndOpenCommand}"
                                    Text="Checkout and Open" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.UndoCheckoutCommand}"
                                Text="Undo Checkout" />
                            <MenuFlyoutItem
                                Command="{x:Bind ViewModel.OpenCommand}"
                                Text="Open" />
                        </MenuFlyout>
                    </tv:TableView.ContextFlyout>
                </common:EntryTableView>
            </Border>

            <Grid Grid.Row="3" Margin="0,4,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Click="SwitchToMinimalSearch_Click"
                        Content="Minimal"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Switch to compact quick-search bar" />
                    <Button
                        x:Name="btnDock"
                        Click="OdooDock_Click"
                        Content="Dock"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Dock Search panel into main window"
                        Visibility="Collapsed" />
                    <Button
                        Click="OdooCancel_Click"
                        Content="Close"
                        Style="{StaticResource TextButtonStyle}" />
                    <Button
                        Command="{x:Bind ViewModel.ResetCommand}"
                        Content="Reset"
                        Style="{StaticResource TextButtonStyle}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource HackCaptionStyle}"
                        Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="btnSearch"
                    pp:Id="search.search"
                    Grid.Column="2"
                    MinWidth="200"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    Style="{StaticResource FilledButtonStyle}" />
            </Grid>
        </Grid>

        <!--  Minimal Quick Search Bar + Combolist Results  -->
        <Border
            x:Name="MinimalSearchRoot"
            pp:Id="search.bar"
            Margin="12"
            VerticalAlignment="Center"
            Style="{StaticResource HackToolbarStyle}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136" />
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    Header="Match"
                    Style="{StaticResource HackOutlinedComboBoxStyle}"
                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.OperatorList}"
                    SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}"
                    ToolTipService.ToolTip="Filename match operator">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rep:OperatorsRow">
                            <TextBlock Text="{x:Bind OpRepr}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    KeyDown="FileNameTextbox_KeyDown"
                    PlaceholderText="Search vault files… (Enter)"
                    Style="{StaticResource OutlinedTextBoxStyle}"
                    Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Options"
                    Style="{StaticResource TextButtonStyle}"
                    ToolTipService.ToolTip="Search options (scope &amp; result limit)">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="240" Spacing="10">
                                <TextBlock
                                    Style="{StaticResource TitleSmall}"
                                    Text="Quick Search Options" />
                                <TextBox
                                    Header="Max Results"
                                    KeyDown="FileNameTextbox_KeyDown"
                                    Style="{StaticResource OutlinedTextBoxStyle}"
                                    Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Checked Out to Me"
                                    IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Local Only"
                                    IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Deleted on Server"
                                    IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.ResetCommand}"
                                    Content="Reset Filters"
                                    Style="{StaticResource TextButtonStyle}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Style="{StaticResource FilledButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing
                            Width="13"
                            Height="13"
                            IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="Search" />
                    </StackPanel>
                </Button>

                <!--  Quick-Navigate Results Combolist  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ComboBox
                        x:Name="MiniResultsCombo"
                        MinWidth="240"
                        Header="Results"
                        Style="{StaticResource HackOutlinedComboBoxStyle}"
                        MaxWidth="340"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.QuickResultsPlaceholder, Mode=OneWay}"
                        SelectionChanged="MiniResultsCombo_SelectionChanged"
                        ToolTipService.ToolTip="Pick a matching file to navigate directly in File Manager">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:SearchRow">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        Style="{StaticResource BodyMedium}"
                                        Text="{x:Bind Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Style="{StaticResource HackCaptionStyle}"
                                        Text="{x:Bind Directory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        x:Name="MiniLocateBtn"
                        VerticalAlignment="Center"
                        Click="MiniLocate_Click"
                        IsEnabled="False"
                        Style="{StaticResource PaneIconButtonStyle}"
                        ToolTipService.ToolTip="Jump to selected result in File Manager">
                        <FontIcon FontSize="14" Glyph="&#xE72A;" />
                    </Button>
                </StackPanel>

                <Button
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Click="OpenFullSearch_Click"
                    Content="Full View"
                    Style="{StaticResource TextButtonStyle}"
                    ToolTipService.ToolTip="Expand to full Search Odoo window" />

                <StackPanel
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="MiniDockBtn"
                        Click="OdooDock_Click"
                        Content="Dock"
                        Style="{StaticResource TextButtonStyle}"
                        ToolTipService.ToolTip="Dock Search bar into main window"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="MiniCloseBtn"
                        Click="OdooCancel_Click"
                        Content="Close"
                        Style="{StaticResource TextButtonStyle}"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
