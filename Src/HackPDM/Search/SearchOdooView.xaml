<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Search.SearchOdooView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:common="using:HackPDM.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rep="using:HackPDM.Core.Services"
    xmlns:x1="using:System"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <common:OperatorConverter x:Key="OperationConverter" />
    </Page.Resources>

    <Grid x:Name="SearchRootGrid">
        <!--  Full Search View  -->
        <Grid x:Name="FullSearchRoot" Margin="16" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Query & Property Builder Card  -->
            <Border
                x:Name="QueryBuilderCard"
                Grid.Row="0"
                Padding="14"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <Grid x:Name="QueryLayoutGrid" ColumnSpacing="20" RowSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.15*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="FilenameSection" Grid.Column="0" Spacing="10">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Filename &amp; Scope" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="86" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="84" />
                            </Grid.ColumnDefinitions>
                            <ComboBox
                                x:Name="OdooSearchComparer"
                                Grid.Column="0"
                                Header="Match"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OperatorList}"
                                SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:OperatorsRow">
                                        <TextBlock Text="{Binding OpRepr}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBox
                                x:Name="FileNameTextbox"
                                Grid.Column="1"
                                Header="Filename"
                                PlaceholderText="Search by filename…"
                                HorizontalAlignment="Stretch"
                                KeyDown="FileNameTextbox_KeyDown"
                                Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                x:Name="OdooMaxRes"
                                Grid.Column="2"
                                Header="Max"
                                KeyDown="FileNameTextbox_KeyDown"
                                Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>

                        <StackPanel x:Name="CheckboxesPanel" Orientation="Horizontal" Spacing="16">
                            <CheckBox
                                x:Name="OdooCheckedMe"
                                MinWidth="0"
                                Content="Checked Out to Me"
                                IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                            <CheckBox
                                x:Name="OdooLocalOnly"
                                MinWidth="0"
                                Content="Local Only"
                                IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
                            <CheckBox
                                x:Name="OdooDeletedIsLocal"
                                MinWidth="0"
                                Content="Deleted Locally"
                                IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        x:Name="QueryDivider"
                        Grid.Column="1"
                        Width="1"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel x:Name="PropertySection" Grid.Column="2" Spacing="10">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Property Filter Builder" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ComboBox
                                x:Name="OdooSearchProperty"
                                Grid.Column="0"
                                Header="Property"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.PropertiesSearchable}"
                                SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <ComboBox
                                x:Name="OdooSearchPropEqual"
                                Grid.Column="1"
                                Header="Comparer"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.OperatorList}"
                                SelectedItem="{x:Bind ViewModel.SelectedPropertyOperator, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="rep:OperatorsRow">
                                        <TextBlock Text="{Binding OpRepr}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBox
                                x:Name="OdooSearchPropValue"
                                Grid.Column="2"
                                Header="Value"
                                PlaceholderText="Property value…"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                KeyDown="OdooSearchPropValue_KeyDown"
                                Text="{x:Bind ViewModel.PropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Button
                                x:Name="OdooPropAdd"
                                Grid.Column="3"
                                MinWidth="84"
                                VerticalAlignment="Bottom"
                                Command="{x:Bind ViewModel.AddPropertyCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Add Rule" />
                        </Grid>

                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button
                                x:Name="OdooPropDelete"
                                Command="{x:Bind ViewModel.DeletePropertiesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Remove Selected Rule" />
                            <Button
                                x:Name="OdooPropertyReset"
                                Command="{x:Bind ViewModel.ResetPropertiesCommand}"
                                IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                                Content="Clear Rules" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  Active Property Rules Card  -->
            <Border
                Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <tv:TableView
                    x:Name="OdooSearchPropList"
                    Height="110"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                    IsReadOnly="True"
                    ItemsSource="{x:Bind ViewModel.PropertiesActive}">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn
                            Width="2*"
                            Binding="{Binding Name}"
                            Header="Property Name" />

                        <tv:TableViewTextColumn
                            Width="1*"
                            Binding="{Binding Comparer}"
                            Header="Comparer" />

                        <tv:TableViewTextColumn
                            Width="2*"
                            Binding="{Binding Value}"
                            Header="Value" />
                    </tv:TableView.Columns>
                </tv:TableView>
            </Border>

            <!--  Search Results Card  -->
            <Border
                Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{StaticResource HackPanelStrokeBrush}"
                BorderThickness="{StaticResource HackPanelBorderThickness}"
                CornerRadius="{StaticResource HackPanelCornerRadius}">
                <tv:TableView
                    x:Name="OdooSearchResults"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    IsReadOnly="True"
                    DoubleTapped="OdooSearchResults_DoubleTapped"
                    ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
                    SelectionMode="Extended">

                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn
                            Width="320"
                            Binding="{Binding Name}"
                            Header="File Name" />
                        <tv:TableViewTextColumn
                            Width="*"
                            Binding="{Binding Directory}"
                            Header="File Path" />
                    </tv:TableView.Columns>
                    <tv:TableView.ContextFlyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="locateToolStripMenuItem"
                                Click="LocateSelected_Click"
                                Text="Show in File Manager" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="CheckOutMenuItem" Text="Checkout">
                                <MenuFlyoutItem
                                    x:Name="checkoutToolStripMenuItem"
                                    Command="{x:Bind ViewModel.CheckoutCommand}"
                                    Text="Checkout" />
                                <MenuFlyoutItem
                                    x:Name="checkoutOpenToolStripMenuItem"
                                    Command="{x:Bind ViewModel.CheckoutAndOpenCommand}"
                                    Text="Checkout and Open" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="unCheckoutToolStripMenuItem"
                                Command="{x:Bind ViewModel.UndoCheckoutCommand}"
                                Text="Undo Checkout" />
                            <MenuFlyoutItem
                                x:Name="openToolStripMenuItem"
                                Command="{x:Bind ViewModel.OpenCommand}"
                                Text="Open" />
                        </MenuFlyout>
                    </tv:TableView.ContextFlyout>
                </tv:TableView>
            </Border>

            <Grid Grid.Row="3" Margin="0,4,0,0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Name="btnMinimal"
                        Click="SwitchToMinimalSearch_Click"
                        Content="Minimal"
                        ToolTipService.ToolTip="Switch to compact quick-search bar" />
                    <Button
                        x:Name="btnDock"
                        Click="OdooDock_Click"
                        Content="Dock"
                        ToolTipService.ToolTip="Dock Search panel into main window"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="btnCancel"
                        Click="OdooCancel_Click"
                        Content="Close" />
                    <Button
                        x:Name="btnReset"
                        Command="{x:Bind ViewModel.ResetCommand}"
                        Content="Reset" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <ProgressRing
                        Width="18"
                        Height="18"
                        VerticalAlignment="Center"
                        IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.SearchStatusText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    x:Name="btnSearch"
                    Grid.Column="2"
                    MinWidth="200"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Content="Search"
                    Style="{ThemeResource AccentButtonStyle}" />
            </Grid>
        </Grid>

        <!--  Minimal Quick Search Bar + Combolist Results  -->
        <Border
            x:Name="MinimalSearchRoot"
            Padding="10,6"
            VerticalAlignment="Center"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            Visibility="Collapsed">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" MinWidth="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ComboBox
                    x:Name="MiniComparerBox"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.OperatorList}"
                    SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}"
                    ToolTipService.ToolTip="Filename match operator">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rep:OperatorsRow">
                            <TextBlock Text="{Binding OpRepr}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBox
                    x:Name="MiniSearchBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center"
                    KeyDown="FileNameTextbox_KeyDown"
                    PlaceholderText="Search vault files… (Enter)"
                    Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Button
                    x:Name="MiniOptionsBtn"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Content="Options"
                    ToolTipService.ToolTip="Search options (scope &amp; result limit)">
                    <Button.Flyout>
                        <Flyout>
                            <StackPanel Width="240" Spacing="10">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Text="Quick Search Options" />
                                <TextBox
                                    Header="Max Results"
                                    KeyDown="FileNameTextbox_KeyDown"
                                    Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Checked Out to Me"
                                    IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Local Only"
                                    IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
                                <CheckBox
                                    MinWidth="0"
                                    Content="Deleted Locally"
                                    IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Command="{x:Bind ViewModel.ResetCommand}"
                                    Content="Reset Filters" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <Button
                    x:Name="MiniSearchBtn"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Command="{x:Bind ViewModel.SearchCommand}"
                    Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <ProgressRing
                            Width="13"
                            Height="13"
                            IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="Search" />
                    </StackPanel>
                </Button>

                <!--  Quick-Navigate Results Combolist  -->
                <StackPanel
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4">
                    <ComboBox
                        x:Name="MiniResultsCombo"
                        MinWidth="240"
                        MaxWidth="340"
                        VerticalAlignment="Center"
                        ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
                        PlaceholderText="{x:Bind ViewModel.QuickResultsPlaceholder, Mode=OneWay}"
                        SelectionChanged="MiniResultsCombo_SelectionChanged"
                        ToolTipService.ToolTip="Pick a matching file to navigate directly in File Manager">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:SearchRow">
                                <StackPanel Spacing="1">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Text="{Binding Name}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Directory}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        x:Name="MiniLocateBtn"
                        Padding="8,6"
                        VerticalAlignment="Center"
                        Click="MiniLocate_Click"
                        IsEnabled="False"
                        ToolTipService.ToolTip="Jump to selected result in File Manager">
                        <FontIcon FontSize="12" Glyph="&#xE72A;" />
                    </Button>
                </StackPanel>

                <Button
                    x:Name="MiniOpenFullBtn"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Click="OpenFullSearch_Click"
                    Content="Full View"
                    ToolTipService.ToolTip="Expand to full Search Odoo window" />

                <StackPanel
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="MiniDockBtn"
                        Click="OdooDock_Click"
                        Content="Dock"
                        ToolTipService.ToolTip="Dock Search bar into main window"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="MiniCloseBtn"
                        Click="OdooCancel_Click"
                        Content="Close"
                        Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
