<?xml version="1.0" encoding="utf-8" ?>
<UserControl
	x:Class="HackPDM.Common.FolderIcon"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	IsHitTestVisible="False">
	<Viewbox
		x:Name="IconBox"
		Width="18"
		Height="18"
		Stretch="Uniform">
		<Grid Width="32" Height="32">
			<Grid x:Name="ClosedGroup">
				<Path
					x:Name="ClosedFolderBody"
					Data="M 3,6 C 3,4.9 3.9,4 5,4 L 12.2,4 C 12.9,4 13.5,4.3 13.9,4.9 L 15.7,7.5 L 27,7.5 C 28.1,7.5 29,8.4 29,9.5 L 29,25 C 29,26.1 28.1,27 27,27 L 5,27 C 3.9,27 3,26.1 3,25 Z"
					Fill="#C69749" />
				<Path
					x:Name="ClosedFolderHighlight"
					Data="M 3,10.2 L 29,10.2 L 29,11.6 L 3,11.6 Z"
					Fill="#E5C07B"
					Opacity="0.55" />
			</Grid>
			<Grid x:Name="OpenGroup" Visibility="Collapsed">
				<Path
					x:Name="OpenFolderBack"
					Data="M 3,6 C 3,4.9 3.9,4 5,4 L 12.2,4 C 12.9,4 13.5,4.3 13.9,4.9 L 15.7,7.5 L 26.5,7.5 C 27.6,7.5 28.5,8.4 28.5,9.5 L 28.5,14 L 3,14 Z"
					Fill="#9E7432" />
				<Path
					Data="M 4.5,10.8 L 27,10.8 L 27,13.5 L 4.5,13.5 Z"
					Fill="#22190D"
					Opacity="0.45" />
				<Path
					x:Name="OpenFolderFront"
					Data="M 2.3,13.6 C 1.9,12.7 2.5,11.8 3.5,11.8 L 28.5,11.8 C 29.5,11.8 30.1,12.7 29.7,13.6 L 27.5,25.5 C 27.3,26.4 26.5,27 25.5,27 L 6.5,27 C 5.5,27 4.7,26.4 4.5,25.5 Z"
					Fill="#DFB468" />
			</Grid>
			<Path
				x:Name="RootAccent"
				Data="M 21,11 L 25.2,11 L 19.8,26 L 15.6,26 Z"
				Fill="#FFF3D1"
				Opacity="0.65"
				Visibility="Collapsed" />
			<Grid
				x:Name="LocalBadge"
				Width="12"
				Height="12"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Visibility="Collapsed">
				<Ellipse Fill="#2EA043" Stroke="#161B22" StrokeThickness="1.5" />
				<Path Data="M 6,3.2 L 6,8.8 M 3.2,6 L 8.8,6" Stroke="#FFFFFF" StrokeThickness="1.6" />
			</Grid>
			<Grid
				x:Name="RemoteBadge"
				Width="12"
				Height="12"
				HorizontalAlignment="Right"
				VerticalAlignment="Bottom"
				Visibility="Collapsed">
				<Ellipse Fill="#1F88E5" Stroke="#161B22" StrokeThickness="1.5" />
				<Ellipse Width="4.4" Height="4.4" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#E6F4FF" />
			</Grid>
		</Grid>
	</Viewbox>
</UserControl>
