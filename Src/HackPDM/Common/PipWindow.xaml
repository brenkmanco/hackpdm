<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HackPDM.Common.PipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HackPDM.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Preview"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!--  1. Root preview host  -->
        <Grid x:Name="PipContentRoot" Padding="8">
            <TextBlock
                x:Name="PipEmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No preview available"
                TextAlignment="Center" />
            <Image
                x:Name="PipImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform"
                Visibility="Collapsed" />
        </Grid>

        <!--  2. Overlay return button  -->
        <Grid
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top">
            <Button
                x:Name="ExitPipButton"
                Padding="8"
                Background="#80000000"
                BorderThickness="0"
                Click="OnExitPipClicked"
                ToolTipService.ToolTip="Return to Main Window">
                <FontIcon
                    FontSize="14"
                    Foreground="White"
                    Glyph="&#xE73F;" />
            </Button>
        </Grid>
    </Grid>
</Window>
