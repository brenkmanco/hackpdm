<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="HackPDM.Common.PipWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HackPDM.Common"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Preview"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  CompactOverlay titlebar drag strip (visible on Windows when extending into titlebar)  -->
        <Grid
            x:Name="PipTitleBar"
            Grid.Row="0"
            Height="32"
            Background="Transparent"
            Visibility="Collapsed" />

        <!--  1. Root preview host  -->
        <Grid
            x:Name="PipContentRoot"
            Grid.Row="1"
            Padding="8">
            <TextBlock
                x:Name="PipEmptyText"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{ThemeResource OnSurfaceVariantBrush}"
                Text="No preview available"
                TextAlignment="Center" />
            <Image
                x:Name="PipImage"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Stretch="Uniform"
                Visibility="Collapsed" />
        </Grid>

        <!--  2. Overlay return button (bottom-right, clear of CompactOverlay caption controls)  -->
        <Grid
            Grid.Row="1"
            Margin="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
            <Button
                x:Name="ExitPipButton"
                Width="40"
                Height="40"
                Padding="0"
                Background="{ThemeResource SurfaceInverseBrush}"
                BorderThickness="0"
                CornerRadius="20"
                Opacity="0.85"
                Click="OnExitPipClicked"
                ToolTipService.ToolTip="Return to Main Window">
                <FontIcon
                    FontSize="16"
                    Foreground="{ThemeResource OnSurfaceInverseBrush}"
                    Glyph="&#xE73F;" />
            </Button>
        </Grid>
    </Grid>
</Window>
