<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Hack.HackSettingsView"
    xmlns="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d">
    <Grid Margin="12" ColumnSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!--  PWA Folder Label, TextBox, and Browse  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Text="PWA Folder" />
        <TextBox
            x:Name="txtPwaInput"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,5,0,5"
            PlaceholderText="Working vault folder path"
            Text="{x:Bind ViewModel.PwaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            x:Name="btnBrowsePwa"
            Grid.Row="0"
            Grid.Column="2"
            Margin="0,5,0,5"
            Command="{x:Bind ViewModel.BrowsePwaCommand}"
            Content="Browse…" />

        <!--  Temporary Folder Path Label, TextBox, and Browse  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Text="Temporary Folder Path" />
        <TextBox
            x:Name="HackTempFolderPath"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,5,0,5"
            PlaceholderText="Temporary preview folder path"
            Text="{x:Bind ViewModel.TempFolderPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <Button
            x:Name="btnBrowseTemp"
            Grid.Row="1"
            Grid.Column="2"
            Margin="0,5,0,5"
            Command="{x:Bind ViewModel.BrowseTempCommand}"
            Content="Browse…" />

        <!--  Submit Button  -->
        <Button
            x:Name="btnSubmit"
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Command="{x:Bind ViewModel.SubmitCommand}"
            Content="Save"
            Style="{StaticResource AccentButtonStyle}" />
    </Grid>
</Page>
