<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Mvvm.Views.Hack.HackFileManagerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:tv="using:WinUI.TableView"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:conv="using:HackPDM.Mvvm.Views.Common.Converters"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:model="using:HackPDM.Domain.Representation"
	xmlns:sys="using:System"
	xmlns:types="using:HackPDM.Mvvm.Views.Common.Types"
	xmlns:ui="using:CommunityToolkit.WinUI"
	mc:Ignorable="d">



	<Page.Resources>
		<!--  Converter  -->
		<conv:FileSizeConverter x:Key="FileSizeFormatter" />
		<conv:TypeIconConverter x:Key="TypeIcon" />
		<conv:StatusIconConverter x:Key="StatusIcon" />
		<!--  Icon Column Template  -->
		<DataTemplate x:Key="IconCellTemplate">
			<Canvas
				Width="40"
				Height="32"
				Margin="0,0,8,0">
				<Image
					Canvas.Left="0"
					Canvas.Top="0"
					Width="32"
					Height="32"
					Source="{Binding Type, Converter={StaticResource TypeIcon}}" />
				<Image
					Canvas.Left="10"
					Canvas.Top="0"
					Width="24"
					Height="24"
					Source="{Binding Status, Converter={StaticResource StatusIcon}}"
					Stretch="UniformToFill" />
			</Canvas>
		</DataTemplate>
		<!--  Size Column Template  -->
		<DataTemplate x:Key="SizeCellTemplate">
			<TextBlock
				Padding="5,0,5,0"
				HorizontalAlignment="Right"
				VerticalAlignment="Top"
				Text="{Binding Size, Converter={StaticResource FileSizeFormatter}}"
				TextAlignment="Right" />
		</DataTemplate>
		<!--  Group Header Style  -->
		<!-- <Style x:Key="GroupHeaderStyle" TargetType="tv:TableViewHeaderRow">
			<Setter Property="FontSize" Value="14" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Background" Value="Black" />
			<Setter Property="Foreground" Value="LightGray" />
			<Setter Property="Padding" Value="2,0,2,0" />
			<Setter Property="Height" Value="35" />
			<Setter Property="MinHeight" Value="25" />
		</Style> -->
		<Style TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="Light" />
			<Setter Property="Foreground" Value="White" />
		</Style>
	</Page.Resources>

	<Grid Margin="12" CornerRadius="10">
		<!--  TreeView for Directories  -->
		<SplitView
			Grid.RowSpan="4"
			Grid.ColumnSpan="1"
			DisplayMode="Inline"
			IsPaneOpen="True"
			OpenPaneLength="250"
			PanePlacement="Left">
			<SplitView.Pane>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<BreadcrumbBar
						x:Name="OdooDirectoryBreadcrumb"
						Grid.Row="0"
						Margin="5,0,5,10"
						VerticalAlignment="Top"
						BorderBrush="DimGray"
						BorderThickness="3"
						CornerRadius="10"
						ItemsSource="{x:Bind BreadcrumbPath}"
						Visibility="Visible">
						<BreadcrumbBar.ItemTemplate>
							<DataTemplate x:DataType="types:TreeData">
								<TextBlock Text="{x:Bind Name}" />
							</DataTemplate>
						</BreadcrumbBar.ItemTemplate>
					</BreadcrumbBar>
					<ScrollViewer
						Grid.Row="1"
						HorizontalScrollBarVisibility="Auto"
						HorizontalScrollMode="Auto">
						<TreeView
							x:Name="OdooDirectoryTree"
							Margin="0,0,10,0"
							VerticalAlignment="Top"
							BorderBrush="DimGray"
							BorderThickness="3"
							CanDrag="True"
							CanDragItems="False"
							CornerRadius="10"
							Visibility="Visible">
							<TreeView.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutSubItem x:Name="TreeDownload" Text="Download">
										<MenuFlyoutItem x:Name="TreeDownloadAll" Text="All"
										Command="{x:Bind ViewModel.GetLatestDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreeDownloadTop" Text="Top Directory"
										Command="{x:Bind ViewModel.GetLatestDirectoryTopCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeCheckout" Text="Checkout"
										Command="{x:Bind ViewModel.CheckoutDirectoryCommand}" />
									<MenuFlyoutItem x:Name="TreeUndoCheckout" Text="Undo Checkout"
										Command="{x:Bind ViewModel.UndoCheckoutDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeCommit" Text="Commit"
										Command="{x:Bind ViewModel.CommitDirectoryCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeAnalyze" Text="Analyze" />
									<MenuFlyoutSeparator />
									<MenuFlyoutSubItem x:Name="TreeDelete" Text="Delete">
										<MenuFlyoutItem x:Name="TreeLocalDelete" Text="Local"
										Command="{x:Bind ViewModel.LocalDeleteDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreeLogicalDelete" Text="Logical"
										Command="{x:Bind ViewModel.LogicalDeleteDirectoryCommand}" />
										<MenuFlyoutItem x:Name="TreePermanentDelete" Text="Permanent" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="TreeUndelete" Text="Restore">
										<MenuFlyoutItem x:Name="TreeRestoreAll" Text="All"
										Command="{x:Bind ViewModel.RestoreDirectoryRecursiveCommand}" />
										<MenuFlyoutItem x:Name="TreeRestoreTop" Text="Top Directory"
										Command="{x:Bind ViewModel.RestoreDirectoryCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSeparator />
									<MenuFlyoutItem x:Name="TreeOpenDirectory" Text="Open Directory"
										Command="{x:Bind ViewModel.OpenDirectoryCommand}" />
								</MenuFlyout>
							</TreeView.ContextFlyout>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="types:TreeData">
									<TreeViewItem Loaded="TreeViewItem_Loaded" Unloaded="TreeViewItem_Unloaded">
										<StackPanel Orientation="Horizontal">
											<Image
												Width="22"
												Height="22"
												Margin="0,0,8,0"
												Source="{x:Bind Icon}" />
											<TextBlock Text="{x:Bind Name}" />
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>
					</ScrollViewer>
				</Grid>
			</SplitView.Pane>
			<Grid x:Name="EntryContentGrid">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" MinWidth="300" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="*" MaxHeight="15" />
					<RowDefinition Height="*" MaxHeight="250" />
					<RowDefinition Height="*" MaxHeight="30" />
				</Grid.RowDefinitions>
				<!--  TabView for file lists  -->
				<TabView
					x:Name="ListTabs"
					Grid.Row="0"
					Grid.Column="1"
					Grid.ColumnSpan="2"
					Margin="0,0,10,0">

					<TabViewItem
						x:Name="RootEntryList"
						Header="Entries"
						IsClosable="False">
						<!--  headers and widths come from the saved column settings (ApplyColumnSettings), matched by SortMemberPath  -->
						<tv:TableView
							x:Name="OdooEntryList"
							VerticalContentAlignment="Stretch"
							AutoGenerateColumns="False"
							CanSortColumns="True"
							IsReadOnly="True"
							SelectionMode="Extended">
							<tv:TableView.Columns>
								<tv:TableViewTemplateColumn
									Width="32"
									CanReorder="True"
									CanResize="True"
									CellTemplate="{StaticResource IconCellTemplate}" />
								<tv:TableViewTextColumn Binding="{Binding Name}" SortMemberPath="Name" />
								<tv:TableViewTextColumn Binding="{Binding Type}" SortMemberPath="Type" />
								<tv:TableViewTemplateColumn CellTemplate="{StaticResource SizeCellTemplate}" SortMemberPath="Size" />
								<tv:TableViewTextColumn Binding="{Binding Status}" SortMemberPath="Status" />
								<tv:TableViewTextColumn Binding="{Binding Checkout}" SortMemberPath="Checkout" />
								<tv:TableViewTextColumn Binding="{Binding LocalDate}" SortMemberPath="LocalDate" />
								<tv:TableViewTextColumn Binding="{Binding RemoteDate}" SortMemberPath="RemoteDate" />
								<tv:TableViewTextColumn Binding="{Binding FullName}" SortMemberPath="FullName" />
							</tv:TableView.Columns>
							<tv:TableView.ContextFlyout>
								<MenuFlyout>
									<MenuFlyoutSubItem x:Name="EntryOpen" Text="Open">
										<MenuFlyoutItem Text="Preview Latest Remote" Command="{x:Bind ViewModel.OpenSelectedLatestRemoteCommand}" />
										<MenuFlyoutItem Text="Latest Local" Command="{x:Bind ViewModel.OpenSelectedLatestLocalCommand}" />
										<MenuFlyoutItem Text="File Directory" Command="{x:Bind ViewModel.OpenSelectedFoldersCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutItem Text="Download" Command="{x:Bind ViewModel.GetLatestSelectedCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Checkout" Command="{x:Bind ViewModel.CheckoutSelectedCommand}" />
									<MenuFlyoutItem Text="Undo Checkout" Command="{x:Bind ViewModel.UndoCheckoutSelectedCommand}" />
									<MenuFlyoutSeparator />
									<!--  one item per EntryRowKeys.Names, added by the view  -->
									<MenuFlyoutSubItem x:Name="EntryGroupBy" Text="Group By" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Commit" Command="{x:Bind ViewModel.CommitSelectedCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutItem Text="Restore" />
									<MenuFlyoutItem Text="Upload Icon" Command="{x:Bind ViewModel.UploadIconCommand}" />
									<MenuFlyoutSeparator />
									<MenuFlyoutSubItem x:Name="EntryDelete" Text="Delete">
										<MenuFlyoutItem Text="Local" Command="{x:Bind ViewModel.LocalDeleteSelectedCommand}" />
										<MenuFlyoutItem Text="Logical" Command="{x:Bind ViewModel.LogicalDeleteSelectedCommand}" />
										<MenuFlyoutItem Text="Permanent" Command="{x:Bind ViewModel.PermanentDeleteSelectedCommand}" />
									</MenuFlyoutSubItem>
								</MenuFlyout>
							</tv:TableView.ContextFlyout>
						</tv:TableView>
					</TabViewItem>
					<TabViewItem Header="Changes" IsClosable="False">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<ListView x:Name="HackChangesList" Grid.Column="0" />
							<ListView x:Name="OdooChangesList" Grid.Column="1" />
						</Grid>
					</TabViewItem>
				</TabView>
				<Grid
					Grid.Row="1"
					Grid.Column="1"
					Grid.ColumnSpan="3">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock
						x:Name="EntryListStatus"
						Grid.Column="0"
						Padding="5,0,5,0"
						VerticalAlignment="Center"
						FontWeight="Bold"
						Text="{x:Bind ViewModel.EntriesLabel, Mode=OneWay}" />
					<TextBlock
						x:Name="EntryListLocalOnly"
						Grid.Column="1"
						Padding="5,0,5,0"
						VerticalAlignment="Center"
						FontWeight="Bold"
						Text="{x:Bind ViewModel.EntriesLabelLocal, Mode=OneWay}" />
					<TextBlock
						x:Name="EntryListRemoteOnly"
						Grid.Column="2"
						Padding="5,0,5,0"
						VerticalAlignment="Center"
						FontWeight="Bold"
						Text="{x:Bind ViewModel.EntriesLabelRemote, Mode=OneWay}" />
				</Grid>

				<TabView
					x:Name="VersionTabs"
					Grid.Row="2"
					Grid.Column="1"
					MaxHeight="400"
					Margin="10,0,0,0"
					SelectionChanged="VersionTabs_SelectionChanged">
					<TabViewItem x:Name="HistoryTab" Header="History">

						<tv:TableView
							x:Name="OdooHistory"
							AutoGenerateColumns="False"
							ItemsSource="{x:Bind ViewModel.OHistories}"
							>
							<tv:TableView.Columns>
								<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
								<tv:TableViewTextColumn Binding="{Binding ModUser}" Header="Mod User" />
								<tv:TableViewTextColumn Binding="{Binding ModDate}" Header="Mod Date" />
								<tv:TableViewTextColumn Binding="{Binding Size}" Header="Size" />
								<tv:TableViewTextColumn Binding="{Binding RelDate}" Header="Rel Date" />
							</tv:TableView.Columns>
							<tv:TableView.ContextFlyout>
								<MenuFlyout x:Name="HistoryContextMenu">
									<MenuFlyoutSubItem x:Name="HistoryDownload" Text="Download">
										<MenuFlyoutItem x:Name="HistoryDownloadTemp" Text="Temporary"
										Command="{x:Bind ViewModel.DownloadHistoryToTempCommand}" />
										<MenuFlyoutItem x:Name="HistoryDownloadOverwrite" Text="Overwrite"
										Command="{x:Bind ViewModel.DownloadHistoryOverwriteCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="HistoryOpen" Text="Open">
										<MenuFlyoutItem x:Name="HistoryOpenTemp" Text="Temporary"
										Command="{x:Bind ViewModel.OpenHistoryFromTempCommand}" />
										<MenuFlyoutItem x:Name="HistoryOpenOverwrite" Text="Overwrite"
										Command="{x:Bind ViewModel.OpenHistoryOverwriteCommand}" />
									</MenuFlyoutSubItem>
									<MenuFlyoutSubItem x:Name="HistoryMove" Text="Move">
										<MenuFlyoutItem x:Name="HistoryMoveTemp" Text="Temporary"
										Command="{x:Bind ViewModel.MoveHistoryToTempCommand}" />
										<MenuFlyoutItem x:Name="HistoryMoveOverwrite" Text="Overwrite"
										Command="{x:Bind ViewModel.MoveHistoryToWorkingCommand}" />
									</MenuFlyoutSubItem>
								</MenuFlyout>
							</tv:TableView.ContextFlyout>
						</tv:TableView>
					</TabViewItem>
					<TabViewItem x:Name="ParentTab" Header="Where Used">
						<tv:TableView
							x:Name="OdooParents"
							AutoGenerateColumns="False"
							CanSortColumns="False"
							ItemsSource="{x:Bind ViewModel.OParents}"
							RowDetailsVisibilityMode="Collapsed">
							<tv:TableView.Columns>
								<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
								<tv:TableViewTextColumn Binding="{Binding Name}" Header="Name" />
								<tv:TableViewTextColumn Binding="{Binding BasePath}" Header="BasePath" />
							</tv:TableView.Columns>
						</tv:TableView>
					</TabViewItem>
					<TabViewItem x:Name="ChildTab" Header="Dependents">
						<tv:TableView
							x:Name="OdooChildren"
							AutoGenerateColumns="False"
							ItemsSource="{x:Bind ViewModel.OChildren}"
							RowDetailsVisibilityMode="Collapsed"
							SelectionMode="Extended">
							<tv:TableView.Columns>
								<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
								<tv:TableViewTextColumn Binding="{Binding Name}" Header="Name" />
								<tv:TableViewTextColumn Binding="{Binding BasePath}" Header="BasePath" />
							</tv:TableView.Columns>
						</tv:TableView>
					</TabViewItem>
					<TabViewItem x:Name="PropertiesTab" Header="Properties">
						<tv:TableView
							x:Name="OdooProperties"
							AutoGenerateColumns="False"
							ItemsSource="{x:Bind ViewModel.OProperties}"
							RowDetailsVisibilityMode="Collapsed">
							<tv:TableView.Columns>
								<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
								<tv:TableViewTextColumn Binding="{Binding Name}" Header="Property" />
								<tv:TableViewTextColumn Binding="{Binding Configuration}" Header="Configuration" />
								<tv:TableViewTextColumn Binding="{Binding Type}" Header="Type" />
								<tv:TableViewTextColumn Binding="{Binding ValueData}" Header="Value" />
							</tv:TableView.Columns>
						</tv:TableView>
					</TabViewItem>
					<TabViewItem x:Name="InfoTab" Header="Info">
						<tv:TableView
							x:Name="OdooVersionInfoList"
							AutoGenerateColumns="False"
							IsReadOnly="True"
							ItemsSource="{x:Bind ViewModel.OVersions}"
							RowDetailsVisibilityMode="Collapsed">
							<tv:TableView.Columns>
								<tv:TableViewTextColumn Binding="{Binding Id}" Header="Version Id" />
								<tv:TableViewTextColumn Binding="{Binding FileSize}" Header="File Size" />
								<tv:TableViewTextColumn Binding="{Binding DirectoryId}" Header="Directory Id" />
								<tv:TableViewTextColumn Binding="{Binding NodeId}" Header="Node Id" />
								<tv:TableViewTextColumn Binding="{Binding EntryId}" Header="Entry Id" />
								<tv:TableViewTextColumn Binding="{Binding AttachmentId}" Header="Attachment Id" />
								<tv:TableViewTextColumn Binding="{Binding ModifyDate}" Header="Modify Date" />
								<tv:TableViewTextColumn Binding="{Binding Checksum}" Header="Checksum" />
								<tv:TableViewTextColumn Binding="{Binding OdooCompletePath}" Header="Odoo Complete Path" />
							</tv:TableView.Columns>
						</tv:TableView>
					</TabViewItem>
				</TabView>

				<!--  Bottom Controls  -->
				<Grid
					Grid.Row="2"
					Grid.RowSpan="2"
					Grid.Column="3"
					BorderThickness="4">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="Auto" MaxWidth="10" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="40" />
					</Grid.RowDefinitions>
					<!--  Image Panel  -->

					<StackPanel
						x:Name="ImageSlot"
						Grid.Row="0"
						Width="256"
						Height="256">
						<ProgressRing
							x:Name="LoadRing"
							Width="256"
							Height="256"
							IsActive="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}"
							Visibility="{x:Bind ViewModel.IsTreeLoading, Mode=OneWay}" />
						<Image
							x:Name="OdooEntryImage"
							Width="256"
							Height="256"
							Visibility="{x:Bind ViewModel.IsPreviewVisible, Mode=OneWay}"
							Stretch="UniformToFill" />
						<Grid
							Margin="10"
							HorizontalAlignment="Right"
							VerticalAlignment="Top">
							<Button
								x:Name="EnterPipButton"
								Padding="8"
								Background="#80000000"
								BorderThickness="0"
								Click="OnTogglePipClicked"
								ToolTipService.ToolTip="Enter Picture-in-Picture Mode">
								<!--  Segoe MDL2 Assets code for 'Back to Window' icon  -->
								<FontIcon
									FontSize="16"
									Foreground="White"
									Glyph="&#xE73F;" />
							</Button>
						</Grid>

					</StackPanel>
					<CommandBar
						x:Name="MoreTools"
						Grid.Row="1"
						DefaultLabelPosition="Right">
						<AppBarToggleButton
							x:Name="ToggleGroups"
							VerticalAlignment="Center"
							Icon="Orientation"
							IsChecked="{x:Bind ViewModel.IsGroupingEnabled, Mode=TwoWay}"
							Label="Grouped" />
						<AppBarToggleButton
							x:Name="Anchor"
							VerticalAlignment="Center"
							Checked="Anchor_Checked"
							Icon="Pin"
							Unchecked="Anchor_Checked" />
						<AppBarToggleButton
							x:Name="ShowInactive"
							VerticalAlignment="Center"
							Icon="Stop"
							IsChecked="{x:Bind ViewModel.ShowInactive, Mode=TwoWay}"
							Label="Show Inactive" />
						<AppBarToggleButton
							x:Name="ShowHidden"
							VerticalAlignment="Center"
							Icon="View"
							Label="Ignore Filter" />
						<AppBarButton
							x:Name="AdditionalTools"
							VerticalAlignment="Center"
							Icon="More"
							Label="Additional Tools">
							<AppBarButton.Flyout>
								<MenuFlyout>
									<MenuFlyoutItem x:Name="OdooRefreshDropdown" Click="Refresh_Click" Text="Refresh View" />
									<MenuFlyoutItem x:Name="OdooSearchDropdown" Click="Search_Click" Text="Search" />
									<MenuFlyoutItem x:Name="OdooManageTypesDropdown" Click="ManageTypes_Click" Text="Manage File Types" />
								</MenuFlyout>
							</AppBarButton.Flyout>
						</AppBarButton>
					</CommandBar>
				</Grid>
			</Grid>
		</SplitView>
	</Grid>

</Page>
