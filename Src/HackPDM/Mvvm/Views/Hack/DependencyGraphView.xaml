<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Mvvm.Views.Hack.DependencyGraphView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="using:HackPDM.Mvvm.Views.Hack"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:types="using:HackPDM.Mvvm.Views.Common.Types"
	xmlns:tv="using:WinUI.TableView"
	mc:Ignorable="d">

	<Page.Resources>
		<Style x:Key="InfoLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.65" />
			<Setter Property="Margin" Value="0,0,10,0" />
		</Style>
		<Style x:Key="InfoValue" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="IsTextSelectionEnabled" Value="True" />
		</Style>
	</Page.Resources>

	<Grid Margin="12" ColumnSpacing="10">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="250" />
			<ColumnDefinition Width="260" />
			<ColumnDefinition Width="*" />
		</Grid.ColumnDefinitions>

		<!--  folders  -->
		<ScrollViewer
			Grid.Column="0"
			HorizontalScrollBarVisibility="Auto"
			HorizontalScrollMode="Auto">
			<TreeView
				x:Name="FolderTree"
				VerticalAlignment="Top"
				BorderBrush="DimGray"
				BorderThickness="3"
				CornerRadius="10"
				SelectionMode="Single">
				<TreeView.ItemTemplate>
					<DataTemplate x:DataType="types:TreeData">
						<TreeViewItem IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
							<StackPanel Orientation="Horizontal">
								<Image
									Width="22"
									Height="22"
									Margin="0,0,8,0"
									Source="{x:Bind Icon}" />
								<TextBlock Text="{x:Bind Name}" />
							</StackPanel>
						</TreeViewItem>
					</DataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>
		</ScrollViewer>

		<!--  files of the folder  -->
		<Grid
			Grid.Column="1"
			BorderBrush="DimGray"
			BorderThickness="3"
			CornerRadius="10"
			RowSpacing="4">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<CheckBox
				x:Name="SelectAll"
				Grid.Row="0"
				Margin="10,4,10,0"
				Content="Select all"
				IsThreeState="False" />
			<ListView
				x:Name="EntryList"
				Grid.Row="1"
				SelectionMode="Extended" />
			<TextBlock
				x:Name="EntryCount"
				Grid.Row="2"
				Margin="10,0,10,6"
				FontSize="11"
				Opacity="0.7" />
		</Grid>

		<!--  graph  -->
		<Grid Grid.Column="2" RowSpacing="6">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<StackPanel
				Grid.Row="0"
				Orientation="Horizontal"
				Spacing="6">
				<RadioButton
					x:Name="ShowChildren"
					Content="Children"
					GroupName="GraphDirection"
					IsChecked="True" />
				<RadioButton
					x:Name="ShowParents"
					Content="Parents"
					GroupName="GraphDirection" />
				<RadioButton
					x:Name="ShowBoth"
					Content="Both"
					GroupName="GraphDirection" />
				<AppBarSeparator />
				<Button
					x:Name="ZoomOut"
					Content="−"
					MinWidth="36"
					ToolTipService.ToolTip="Zoom out" />
				<TextBlock
					x:Name="ZoomText"
					MinWidth="48"
					VerticalAlignment="Center"
					Text="100%"
					TextAlignment="Center" />
				<Button
					x:Name="ZoomIn"
					Content="+"
					MinWidth="36"
					ToolTipService.ToolTip="Zoom in" />
				<Button
					x:Name="FitButton"
					Content="Fit"
					ToolTipService.ToolTip="Show the whole graph" />
				<ProgressRing
					x:Name="Busy"
					Width="20"
					Height="20"
					IsActive="False" />
			</StackPanel>
			<Border
				Grid.Row="1"
				BorderBrush="DimGray"
				BorderThickness="3"
				CornerRadius="10">
				<Grid>
					<local:NodeGraphView x:Name="Graph" />
					<TextBlock
						x:Name="Hint"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="Gray"
						IsHitTestVisible="False"
						Text="Pick one or more files to see their dependencies" />

					<!--  details of the clicked file, over the bottom of the graph  -->
					<Border
						x:Name="DetailPanel"
						Height="320"
						Margin="8"
						Padding="10"
						VerticalAlignment="Bottom"
						Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
						BorderBrush="DimGray"
						BorderThickness="1"
						CornerRadius="8"
						Visibility="Collapsed">
						<Grid ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="300" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  info card  -->
							<Grid RowSpacing="6">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Border
									x:Name="InfoHeader"
									Padding="10,6"
									CornerRadius="5">
									<TextBlock
										x:Name="InfoName"
										FontSize="14"
										FontWeight="SemiBold"
										Foreground="White"
										TextTrimming="CharacterEllipsis" />
								</Border>
								<Grid Grid.Row="1" ColumnSpacing="10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border
										Width="110"
										Height="90"
										Background="#202024"
										CornerRadius="4">
										<Grid>
											<Image x:Name="InfoPreview" Stretch="Uniform" />
											<TextBlock
												x:Name="InfoPreviewNone"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontSize="11"
												Foreground="Gray"
												Text="no preview" />
										</Grid>
									</Border>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock x:Name="InfoType" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoSize" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoVersions" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoState" Style="{StaticResource InfoValue}" />
									</StackPanel>
								</Grid>
								<Grid
									Grid.Row="2"
									ColumnSpacing="4"
									RowSpacing="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock Style="{StaticResource InfoLabel}" Text="Folder" />
									<TextBlock x:Name="InfoFolder" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Changed" />
									<TextBlock x:Name="InfoModified" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Uses" />
									<TextBlock x:Name="InfoUses" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="Used by" />
									<TextBlock x:Name="InfoUsedBy" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" />
								</Grid>
								<StackPanel
									Grid.Row="3"
									Orientation="Horizontal"
									Spacing="6">
									<Button x:Name="InfoFocus" Content="Graph around it" ToolTipService.ToolTip="Draw the graph around this file (or double-click its box)" />
									<Button x:Name="InfoLocate" Content="Show in file manager" />
								</StackPanel>
							</Grid>

							<!--  the file manager's detail tables  -->
							<TabView
								x:Name="DetailTabs"
								Grid.Column="1"
								IsAddTabButtonVisible="False">
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<tv:TableView
										x:Name="HistoryTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind HistoryRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Binding="{Binding ModUser}" Header="Mod User" />
											<tv:TableViewTextColumn Binding="{Binding ModDate}" Header="Mod Date" />
											<tv:TableViewTextColumn Binding="{Binding Size}" Header="Size" />
											<tv:TableViewTextColumn Binding="{Binding RelDate}" Header="Rel Date" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<tv:TableView
										x:Name="ParentTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ParentRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Binding="{Binding BasePath}" Header="BasePath" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<tv:TableView
										x:Name="ChildTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ChildRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Binding="{Binding BasePath}" Header="BasePath" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView
										x:Name="PropertiesTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind PropertyRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Binding="{Binding Name}" Header="Property" />
											<tv:TableViewTextColumn Binding="{Binding Configuration}" Header="Configuration" />
											<tv:TableViewTextColumn Binding="{Binding Type}" Header="Type" />
											<tv:TableViewTextColumn Binding="{Binding ValueData}" Header="Value" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView
										x:Name="VersionTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind VersionRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Binding="{Binding Id}" Header="Version Id" />
											<tv:TableViewTextColumn Binding="{Binding FileSize}" Header="File Size" />
											<tv:TableViewTextColumn Binding="{Binding DirectoryId}" Header="Directory Id" />
											<tv:TableViewTextColumn Binding="{Binding NodeId}" Header="Node Id" />
											<tv:TableViewTextColumn Binding="{Binding EntryId}" Header="Entry Id" />
											<tv:TableViewTextColumn Binding="{Binding AttachmentId}" Header="Attachment Id" />
											<tv:TableViewTextColumn Binding="{Binding ModifyDate}" Header="Modify Date" />
											<tv:TableViewTextColumn Binding="{Binding Checksum}" Header="Checksum" />
											<tv:TableViewTextColumn Binding="{Binding OdooCompletePath}" Header="Odoo Complete Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>

							<Button
								x:Name="DetailClose"
								Grid.Column="1"
								Width="30"
								Height="30"
								Padding="0"
								HorizontalAlignment="Right"
								VerticalAlignment="Top"
								Content="✕"
								ToolTipService.ToolTip="Close (Esc)" />
						</Grid>
					</Border>
				</Grid>
			</Border>
			<TextBlock
				x:Name="Status"
				Grid.Row="2"
				FontSize="11"
				Opacity="0.8"
				TextTrimming="CharacterEllipsis" />
		</Grid>
	</Grid>
</Page>
