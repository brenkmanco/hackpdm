<?xml version="1.0" encoding="utf-8" ?>
<Page
	x:Class="HackPDM.Mvvm.Views.Hack.DependencyGraphView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:conv="using:HackPDM.Mvvm.Views.Common.Converters"
	xmlns:controls="using:HackPDM.Mvvm.Views.Common.Controls"
	xmlns:local="using:HackPDM.Mvvm.Views.Hack"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:types="using:HackPDM.Mvvm.Views.Common.Types"
	xmlns:tv="using:WinUI.TableView"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	mc:Ignorable="d">

	<Page.Resources>
		<conv:FileSizeConverter x:Key="FileSizeFormatter" />
		<conv:LocalDateTimeConverter x:Key="LocalDateFormatter" />
		<Style x:Key="InfoLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="Opacity" Value="0.65" />
			<Setter Property="Margin" Value="0,0,10,0" />
		</Style>
		<Style x:Key="InfoValue" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
			<Setter Property="IsTextSelectionEnabled" Value="True" />
		</Style>
	</Page.Resources>

	<Grid Margin="12" RowSpacing="8">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<!--  Folder Breadcrumb & Pane Controls Bar  -->
		<Border
			Grid.Row="0"
			Padding="6,4"
			Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
			BorderBrush="{StaticResource HackPanelStrokeBrush}"
			BorderThickness="1"
			CornerRadius="6">
			<Grid ColumnSpacing="8">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<StackPanel
					Grid.Column="0"
					VerticalAlignment="Center"
					Orientation="Horizontal"
					Spacing="4">
					<ToggleButton
						x:Name="ToggleFoldersPaneBtn"
						Padding="7,4"
						Click="ToggleSidePanes_Click"
						IsChecked="True"
						ToolTipService.ToolTip="Show or hide folders sidebar">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon FontSize="11" Glyph="&#xE8B7;" />
							<TextBlock VerticalAlignment="Center" FontSize="11" Text="Folders" />
						</StackPanel>
					</ToggleButton>
					<ToggleButton
						x:Name="ToggleFilesPaneBtn"
						Padding="7,4"
						Click="ToggleSidePanes_Click"
						IsChecked="True"
						ToolTipService.ToolTip="Show or hide folder files list">
						<StackPanel Orientation="Horizontal" Spacing="5">
							<FontIcon FontSize="11" Glyph="&#xE8FD;" />
							<TextBlock VerticalAlignment="Center" FontSize="11" Text="Files" />
						</StackPanel>
					</ToggleButton>
					<Border
						Width="1"
						Height="18"
						Margin="4,0,2,0"
						VerticalAlignment="Center"
						Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
				</StackPanel>
				<BreadcrumbBar
					x:Name="FolderBreadcrumb"
					Grid.Column="1"
					VerticalAlignment="Center"
					ItemsSource="{x:Bind BreadcrumbPath}">
					<BreadcrumbBar.ItemTemplate>
						<DataTemplate x:DataType="types:TreeData">
							<StackPanel
								Padding="3,2"
								Orientation="Horizontal"
								Spacing="5"
								ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
								<controls:FolderIcon
									VerticalAlignment="Center"
									IconSize="14"
									IsOpen="False"
									IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
									Origin="{x:Bind Origin, Mode=OneWay}" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
									Text="{x:Bind Name}" />
							</StackPanel>
						</DataTemplate>
					</BreadcrumbBar.ItemTemplate>
				</BreadcrumbBar>
			</Grid>
		</Border>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="GraphFoldersCol" Width="264" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition x:Name="GraphFilesCol" Width="260" />
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<!--  folders  -->
			<Border
				x:Name="GraphFoldersCard"
				Grid.Column="0"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{StaticResource HackPanelStrokeBrush}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Padding="10,6,6,6"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,0,0,1">
						<Grid>
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<StackPanel
								Grid.Column="0"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="6">
								<controls:FolderIcon
									IconSize="15"
									IsOpen="True"
									IsRoot="True"
									Origin="Synced" />
								<TextBlock
									VerticalAlignment="Center"
									FontSize="12"
									FontWeight="SemiBold"
									Text="Folders" />
							</StackPanel>
							<StackPanel
								Grid.Column="1"
								VerticalAlignment="Center"
								Orientation="Horizontal"
								Spacing="2">
								<ToggleButton
									x:Name="GraphBranchLinesToggle"
									Padding="5,4"
									Click="BranchLinesToggle_Click"
									ToolTipService.ToolTip="Show or hide tree branching guide lines">
									<FontIcon FontSize="12" Glyph="&#xE8FD;" />
								</ToggleButton>
								<Button
									Padding="5,4"
									Click="ExpandAllFolders_Click"
									ToolTipService.ToolTip="Expand all folders">
									<FontIcon FontSize="11" Glyph="&#xE70D;" />
								</Button>
								<Button
									Padding="5,4"
									Click="CollapseAllFolders_Click"
									ToolTipService.ToolTip="Collapse all folders">
									<FontIcon FontSize="11" Glyph="&#xE70E;" />
								</Button>
							</StackPanel>
						</Grid>
					</Border>
					<Grid Grid.Row="1">
						<TreeView
							x:Name="FolderTree"
							Padding="4,4"
							VerticalAlignment="Stretch"
							BorderThickness="0"
							ScrollViewer.HorizontalScrollBarVisibility="Auto"
							ScrollViewer.VerticalScrollBarVisibility="Auto"
							SelectionMode="Single">
							<TreeView.Resources>
								<Thickness x:Key="TreeViewItemPresenterPadding">0,0,0,0</Thickness>
								<Thickness x:Key="TreeViewItemPresenterMargin">0,0,0,0</Thickness>
								<x:Double x:Key="TreeViewItemIndent">16</x:Double>
								<x:Double x:Key="TreeViewItemMinHeight">30</x:Double>
								<x:Double x:Key="TreeViewItemExpandCollapseChevronFontSize">11</x:Double>
							</TreeView.Resources>
							<TreeView.ItemTemplate>
								<DataTemplate x:DataType="types:TreeData">
									<TreeViewItem
										MinHeight="30"
										Margin="0"
										Padding="0"
										HorizontalContentAlignment="Stretch"
										VerticalContentAlignment="Stretch"
										IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
										ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
										<StackPanel
											VerticalAlignment="Stretch"
											Orientation="Horizontal">
											<controls:TreeBranchGuides
												VerticalAlignment="Stretch"
												BranchRevision="{x:Bind BranchRevision, Mode=OneWay}"
												IndentWidth="16"
												NodeData="{x:Bind}" />
											<controls:FolderIcon
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												IconSize="18"
												IsOpen="{x:Bind IsExpanded, Mode=OneWay}"
												IsRoot="{x:Bind IsRootNode, Mode=OneWay}"
												Origin="{x:Bind Origin, Mode=OneWay}" />
											<TextBlock
												Margin="0,0,6,0"
												VerticalAlignment="Center"
												FontSize="12"
												FontWeight="{x:Bind NameFontWeight, Mode=OneWay}"
												Text="{x:Bind Name}" />
											<Border
												Margin="0,0,5,0"
												Padding="5,0"
												VerticalAlignment="Center"
												Background="{ThemeResource SubtleFillColorSecondaryBrush}"
												CornerRadius="8"
												Visibility="{x:Bind SubfolderCountVisibility, Mode=OneWay}">
												<TextBlock
													FontSize="10"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Text="{x:Bind SubfolderCountText, Mode=OneWay}" />
											</Border>
										</StackPanel>
									</TreeViewItem>
								</DataTemplate>
							</TreeView.ItemTemplate>
						</TreeView>

						<Border
							x:Name="TreeLoadingOverlay"
							Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
							Visibility="Collapsed">
							<Grid RowDefinitions="Auto,*">
								<ProgressBar
									Grid.Row="0"
									Margin="6,6,6,0"
									IsIndeterminate="True" />
								<StackPanel
									Grid.Row="1"
									Padding="16"
									HorizontalAlignment="Center"
									VerticalAlignment="Center"
									Spacing="10">
									<ProgressRing
										x:Name="TreeBusyRing"
										Width="28"
										Height="28"
										HorizontalAlignment="Center"
										IsActive="False" />
									<TextBlock
										HorizontalAlignment="Center"
										FontSize="12"
										FontWeight="SemiBold"
										Text="Loading Folders…" />
								</StackPanel>
							</Grid>
						</Border>
					</Grid>
				</Grid>
			</Border>

			<!--  Splitter: Folders <-> Files  -->
			<controls:PaneSplitter
				x:Name="GraphFoldersSplitter"
				Grid.Column="1"
				DragCompleted="GraphSplitter_DragCompleted"
				DragDelta="GraphFoldersSplitter_DragDelta"
				Orientation="Vertical" />

			<!--  files of the folder  -->
			<Border
				x:Name="GraphFilesCard"
				Grid.Column="2"
				Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
				BorderBrush="{StaticResource HackPanelStrokeBrush}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Border
						Grid.Row="0"
						Padding="10,6,8,6"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,0,0,1">
						<Grid ColumnDefinitions="*,Auto">
							<TextBlock
								VerticalAlignment="Center"
								FontSize="12"
								FontWeight="SemiBold"
								Text="Files" />
							<CheckBox
								x:Name="SelectAll"
								Grid.Column="1"
								MinWidth="0"
								Content="Select all"
								IsThreeState="False" />
						</Grid>
					</Border>
					<Grid Grid.Row="1">
						<ListView
							x:Name="EntryList"
							SelectionMode="Extended" />
						<ProgressBar
							x:Name="EntryBusyBar"
							Height="3"
							VerticalAlignment="Top"
							IsHitTestVisible="False"
							IsIndeterminate="True"
							Visibility="Collapsed" />
						<Border
							x:Name="EntryBusyOverlay"
							Padding="18,14"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
							BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
							BorderThickness="1"
							CornerRadius="6"
							IsHitTestVisible="False"
							Visibility="Collapsed">
							<StackPanel Spacing="8">
								<ProgressRing
									x:Name="EntryBusyRing"
									Width="24"
									Height="24"
									HorizontalAlignment="Center"
									IsActive="False" />
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="Loading files…" />
							</StackPanel>
						</Border>
					</Grid>
					<Border
						Grid.Row="2"
						Padding="10,5"
						BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
						BorderThickness="0,1,0,0">
						<TextBlock
							x:Name="EntryCount"
							FontSize="11"
							Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
					</Border>
				</Grid>
			</Border>

			<!--  Splitter: Files <-> Graph  -->
			<controls:PaneSplitter
				x:Name="GraphFilesSplitter"
				Grid.Column="3"
				DragCompleted="GraphSplitter_DragCompleted"
				DragDelta="GraphFilesSplitter_DragDelta"
				Orientation="Vertical" />

			<!--  graph  -->
			<Grid Grid.Column="4" RowSpacing="6">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
				<RowDefinition Height="Auto" />
			</Grid.RowDefinitions>
			<StackPanel
				Grid.Row="0"
				Orientation="Horizontal"
				Spacing="6">
				<RadioButton
					x:Name="ShowChildren"
					Content="Children"
					GroupName="GraphDirection"
					IsChecked="True" />
				<RadioButton
					x:Name="ShowParents"
					Content="Parents"
					GroupName="GraphDirection" />
				<RadioButton
					x:Name="ShowBoth"
					Content="Both"
					GroupName="GraphDirection" />
				<AppBarSeparator />
				<Button
					x:Name="ZoomOut"
					Content="−"
					MinWidth="36"
					ToolTipService.ToolTip="Zoom out" />
				<TextBlock
					x:Name="ZoomText"
					MinWidth="48"
					VerticalAlignment="Center"
					Text="100%"
					TextAlignment="Center" />
				<Button
					x:Name="ZoomIn"
					Content="+"
					MinWidth="36"
					ToolTipService.ToolTip="Zoom in" />
				<Button
					x:Name="FitButton"
					Content="Fit"
					ToolTipService.ToolTip="Show the whole graph" />
				<ProgressRing
					x:Name="Busy"
					Width="20"
					Height="20"
					IsActive="False" />
			</StackPanel>
			<Border
				Grid.Row="1"
				BorderBrush="{StaticResource HackPanelStrokeBrush}"
				BorderThickness="{StaticResource HackPanelBorderThickness}"
				CornerRadius="{StaticResource HackPanelCornerRadius}">
				<Grid>
					<local:NodeGraphView x:Name="Graph" />
					<TextBlock
						x:Name="Hint"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Foreground="{ThemeResource TextFillColorSecondaryBrush}"
						IsHitTestVisible="False"
						Text="Pick one or more files to see their dependencies" />
					<Border
						x:Name="GraphBusyOverlay"
						Padding="16,10"
						HorizontalAlignment="Center"
						VerticalAlignment="Top"
						Margin="0,14,0,0"
						Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
						BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
						BorderThickness="1"
						CornerRadius="6"
						IsHitTestVisible="False"
						Visibility="Collapsed">
						<StackPanel Orientation="Horizontal" Spacing="10">
							<ProgressRing
								x:Name="GraphBusyRing"
								Width="18"
								Height="18"
								IsActive="False" />
							<TextBlock
								VerticalAlignment="Center"
								FontSize="12"
								Text="Building dependency graph…" />
						</StackPanel>
					</Border>

					<!--  details of the clicked file, over the bottom of the graph  -->
					<Border
						x:Name="DetailPanel"
						Height="320"
						Margin="8"
						Padding="10"
						VerticalAlignment="Bottom"
						Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
						BorderBrush="{StaticResource HackPanelStrokeBrush}"
						BorderThickness="1"
						CornerRadius="{StaticResource HackPanelCornerRadius}"
						Visibility="Collapsed">
						<Grid ColumnSpacing="12">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="296" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>

							<!--  info card  -->
							<Grid RowSpacing="6">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="*" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<Border
									x:Name="InfoHeader"
									Padding="10,6"
									CornerRadius="5">
									<TextBlock
										x:Name="InfoName"
										FontSize="14"
										FontWeight="SemiBold"
										Foreground="White"
										TextTrimming="CharacterEllipsis" />
								</Border>
								<Grid Grid.Row="1" ColumnSpacing="10">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="110" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Border
										Width="110"
										Height="90"
										Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
										CornerRadius="4">
										<Grid>
											<Image x:Name="InfoPreview" Stretch="Uniform" />
											<TextBlock
												x:Name="InfoPreviewNone"
												HorizontalAlignment="Center"
												VerticalAlignment="Center"
												FontSize="11"
												Foreground="{ThemeResource TextFillColorSecondaryBrush}"
												Text="no preview" />
										</Grid>
									</Border>
									<StackPanel Grid.Column="1" Spacing="2">
										<TextBlock x:Name="InfoType" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoSize" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoVersions" Style="{StaticResource InfoValue}" />
										<TextBlock x:Name="InfoState" Style="{StaticResource InfoValue}" />
									</StackPanel>
								</Grid>
								<Grid
									Grid.Row="2"
									ColumnSpacing="4"
									RowSpacing="3">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<TextBlock Style="{StaticResource InfoLabel}" Text="Folder" />
									<TextBlock x:Name="InfoFolder" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="1" Style="{StaticResource InfoLabel}" Text="Changed" />
									<TextBlock x:Name="InfoModified" Grid.Row="1" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="2" Style="{StaticResource InfoLabel}" Text="Uses" />
									<TextBlock x:Name="InfoUses" Grid.Row="2" Grid.Column="1" Style="{StaticResource InfoValue}" />
									<TextBlock Grid.Row="3" Style="{StaticResource InfoLabel}" Text="Used by" />
									<TextBlock x:Name="InfoUsedBy" Grid.Row="3" Grid.Column="1" Style="{StaticResource InfoValue}" />
								</Grid>
								<StackPanel
									Grid.Row="3"
									Orientation="Horizontal"
									Spacing="6">
									<Button x:Name="InfoFocus" Content="Graph around it" ToolTipService.ToolTip="Draw the graph around this file (or double-click its box)" />
									<Button x:Name="InfoLocate" Content="Show in file manager" />
								</StackPanel>
							</Grid>

							<!--  the file manager's detail tables  -->
							<TabView
								x:Name="DetailTabs"
								Grid.Column="1"
								IsAddTabButtonVisible="False">
								<TabViewItem x:Name="HistoryTab" Header="History" IsClosable="False">
									<tv:TableView
										x:Name="HistoryTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind HistoryRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="80" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="96" Binding="{Binding ModUser}" Header="Mod User" />
											<tv:TableViewTextColumn Width="156" Binding="{Binding ModDate, Converter={StaticResource LocalDateFormatter}}" Header="Mod Date" />
											<tv:TableViewTextColumn Width="80" Binding="{Binding Size, Converter={StaticResource FileSizeFormatter}}" Header="Size" />
											<tv:TableViewTextColumn MinWidth="88" Width="*" Binding="{Binding RelDate, Converter={StaticResource LocalDateFormatter}}" Header="Rel Date" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ParentTab" Header="Where Used" IsClosable="False">
									<tv:TableView
										x:Name="ParentTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ParentRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="200" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="ChildTab" Header="Dependents" IsClosable="False">
									<tv:TableView
										x:Name="ChildTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind ChildRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="200" Binding="{Binding Name}" Header="Name" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding BasePath}" Header="Folder Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="PropertiesTab" Header="Properties" IsClosable="False">
									<tv:TableView
										x:Name="PropertiesTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind PropertyRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="95" Binding="{Binding Version}" Header="Version" />
											<tv:TableViewTextColumn Width="150" Binding="{Binding Name}" Header="Property" />
											<tv:TableViewTextColumn Width="140" Binding="{Binding Configuration}" Header="Configuration" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding Type}" Header="Type" />
											<tv:TableViewTextColumn Width="*" Binding="{Binding ValueData}" Header="Value" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
								<TabViewItem x:Name="InfoTab" Header="Info" IsClosable="False">
									<tv:TableView
										x:Name="VersionTable"
										AutoGenerateColumns="False"
										IsReadOnly="True"
										ItemsSource="{x:Bind VersionRows}">
										<tv:TableView.Columns>
											<tv:TableViewTextColumn Width="105" Binding="{Binding Id}" Header="Version Id" />
											<tv:TableViewTextColumn Width="105" Binding="{Binding FileSize, Converter={StaticResource FileSizeFormatter}}" Header="File Size" />
											<tv:TableViewTextColumn Width="115" Binding="{Binding DirectoryId}" Header="Directory Id" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding NodeId}" Header="Node Id" />
											<tv:TableViewTextColumn Width="95" Binding="{Binding EntryId}" Header="Entry Id" />
											<tv:TableViewTextColumn Width="125" Binding="{Binding AttachmentId}" Header="Attachment Id" />
											<tv:TableViewTextColumn Width="155" Binding="{Binding ModifyDate, Converter={StaticResource LocalDateFormatter}}" Header="Modify Date" />
											<tv:TableViewTextColumn Width="180" Binding="{Binding Checksum}" Header="Checksum" />
											<tv:TableViewTextColumn Width="260" Binding="{Binding OdooCompletePath}" Header="Odoo Complete Path" />
										</tv:TableView.Columns>
									</tv:TableView>
								</TabViewItem>
							</TabView>

							<Button
								x:Name="DetailClose"
								Grid.Column="1"
								Width="30"
								Height="30"
