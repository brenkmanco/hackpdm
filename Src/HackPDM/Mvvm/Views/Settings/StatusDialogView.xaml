<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.StatusDialogView"
    xmlns="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rep="using:HackPDM.Domain.Representation"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{xaml:ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Main Status List  -->
        <tv:TableView
            x:Name="StatusList"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="120"
                    Binding="{xaml:Binding Status}"
                    Header="Action"
                    SortDirection="Descending"/>
                <tv:TableViewTextColumn
                    Width="1158"
                    Binding="{xaml:Binding Message}"
                    Header="Description" 
                    SortDirection="Descending"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Splitter between StatusList and the two lower lists  -->
        <SplitView
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Height="5"
            HorizontalAlignment="Stretch"
            Background="Gray" />

        <!--  Info List  -->
        <tv:TableView
            x:Name="InfoList"
            Grid.Row="2"
            Grid.Column="0"
            Margin="0,5,5,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OInfo, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="120"
                    Binding="{xaml:Binding Status}"
                    Header="Action" 
                    SortDirection="Descending"/>
                <tv:TableViewTextColumn
                    Width="1158"
                    Binding="{xaml:Binding Message}"
                    Header="Description" 
                    SortDirection="Descending"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Error List  -->
        <tv:TableView
            x:Name="ErrorList"
            Grid.Row="2"
            Grid.Column="1"
            Margin="5,5,0,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OError, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="120"
                    Binding="{xaml:Binding Status}"
                    Header="Action" 
                    SortDirection="Descending"/>
                <tv:TableViewTextColumn
                    Width="1158"
                    Binding="{xaml:Binding Message}"
                    Header="Description" 
                    SortDirection="Descending"/>
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Progress Bar  -->
        <ProgressBar
            x:Name="fileCheckStatus"
            Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
            Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}"
            Grid.Row="3"
            Grid.ColumnSpan="2"
            Height="15"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />

        <!--  Progress Text and Status Labels  -->
        <StackPanel
            Grid.Row="4"
            Grid.Column="0"
            VerticalAlignment="Bottom"
            Orientation="Horizontal">
            <TextBlock
                x:Name="ProgressText"
                Margin="0,0,10,0"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </StackPanel>

        <!--  Skipped Label  -->
        <TextBlock
            x:Name="SkippedLabel"
            Grid.Row="4"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" />

        <!--  Control Buttons  -->
        <StackPanel
            Grid.Row="4"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="StatusSettings"
                Margin="0,0,10,0"
                Content="configure settings" 
                Click="StatusSettings_Click"/>
            <CheckBox
                x:Name="cbxAutoClose"
                Margin="0,0,10,0"
                Content="Close When Complete" />
            <Button
                x:Name="cmdCancel"
                Margin="0,0,10,0"
                Content="Cancel" 
                Command="{x:Bind ViewModel.CancelCommand}"/>
            <Button x:Name="cmdClose" Content="Close" 
                Click="CmdCloseClick"/>
        </StackPanel>
        <Grid.Resources>

            <xaml:Style TargetType="xaml:ListViewItem">
                <xaml:Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </xaml:Style>

        </Grid.Resources>
    </Grid>
</Page>
