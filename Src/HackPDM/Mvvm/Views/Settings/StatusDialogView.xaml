<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.StatusDialogView"
    xmlns="using:Microsoft.UI.Xaml.Controls"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rep="using:HackPDM.Domain.Representation"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:xaml="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    Background="{xaml:ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Margin="0,0,0,4"
            FontWeight="SemiBold"
            Text="Operations" />

        <!--  Main Status List  -->
        <tv:TableView
            x:Name="StatusList"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,0,0,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="128"
                    Binding="{Binding Status}"
                    Header="Action" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="Description" />
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Divider between StatusList and the two lower lists  -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Height="2"
            Margin="0,4"
            HorizontalAlignment="Stretch"
            Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,5,4"
            FontWeight="SemiBold"
            Text="Info" />

        <TextBlock
            Grid.Row="3"
            Grid.Column="1"
            Margin="5,0,0,4"
            FontWeight="SemiBold"
            Text="Warnings &amp; Errors" />

        <!--  Info List  -->
        <tv:TableView
            x:Name="InfoList"
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,0,5,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OInfo, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="128"
                    Binding="{Binding Status}"
                    Header="Action" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="Description" />
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Error List  -->
        <tv:TableView
            x:Name="ErrorList"
            Grid.Row="4"
            Grid.Column="1"
            Margin="5,0,0,5"
            AutoGenerateColumns="False"
            CanSortColumns="True"
            IsReadOnly="True"
            ItemsSource="{x:Bind ViewModel.OError, Mode=OneWay}"
            RowDetailsVisibilityMode="Collapsed">
            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="128"
                    Binding="{Binding Status}"
                    Header="Action" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="Description" />
            </tv:TableView.Columns>
        </tv:TableView>

        <!--  Progress Bar  -->
        <ProgressBar
            x:Name="fileCheckStatus"
            Maximum="{x:Bind ViewModel.MaxCount, Mode=OneWay}"
            Value="{x:Bind ViewModel.TotalProcessed, Mode=OneWay}"
            Grid.Row="5"
            Grid.ColumnSpan="2"
            Height="15"
            Margin="0,4,0,4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center" />

        <!--  Progress Text and Transfer Metrics  -->
        <StackPanel
            Grid.Row="6"
            Grid.Column="0"
            Margin="0,6,0,0"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">
            <TextBlock
                x:Name="ProgressText"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
            <TextBlock
                x:Name="SkippedLabel"
                VerticalAlignment="Center"
                Text="{x:Bind ViewModel.SkippedText, Mode=OneWay}" />
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="Downloaded"
                    Text="{x:Bind ViewModel.DownloadedText, Mode=OneWay}" />
                <TextBlock
                    x:Name="TotalDownload"
                    Text="{x:Bind ViewModel.SessionDownloadedText, Mode=OneWay}" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="Uploaded"
                    Text="{x:Bind ViewModel.UploadedText, Mode=OneWay}" />
                <TextBlock
                    x:Name="TotalUpload"
                    Text="{x:Bind ViewModel.SessionUploadedText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>

        <!--  Control Buttons  -->
        <StackPanel
            Grid.Row="6"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="StatusSettings"
                Margin="0,0,10,0"
                Content="Configure Settings"
                Click="StatusSettings_Click"/>
            <CheckBox
                x:Name="cbxAutoClose"
                Margin="0,0,10,0"
                Content="Close When Complete"
                IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />
            <Button
                x:Name="cmdCancel"
                Margin="0,0,10,0"
                Content="Cancel" 
                Command="{x:Bind ViewModel.CancelCommand}"/>
            <Button x:Name="cmdClose" Content="Close" 
                Click="CmdCloseClick"/>
        </StackPanel>
        <Grid.Resources>

            <xaml:Style TargetType="xaml:ListViewItem">
                <xaml:Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </xaml:Style>

        </Grid.Resources>
    </Grid>
</Page>
