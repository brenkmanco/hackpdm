<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.ThemeEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:HackPDM.Mvvm.Views.Common.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tv="using:WinUI.TableView"
    xmlns:vm="using:HackPDM.Mvvm.ViewModels.Settings"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="GallerySection" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="SectionHeader" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" ColumnSpacing="12" Padding="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Editor: color list | picker and actions  -->
        <Grid ColumnSpacing="12" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Theme" />
                <ComboBox
                    Header="Base theme"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Modes}"
                    SelectedIndex="{x:Bind ViewModel.SelectedModeIndex, Mode=TwoWay}" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    <Run Text="Editing the" />
                    <Run FontWeight="SemiBold" Text="{x:Bind ViewModel.EditingThemeText, Mode=OneWay}" />
                    <Run Text="theme. Color changes apply live." />
                </TextBlock>
                <InfoBar
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.RestartNotice, Mode=OneWay}"
                    Severity="Warning"
                    Visibility="{x:Bind ViewModel.IsEditable, Mode=OneWay, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            </StackPanel>

            <ListView
                x:Name="ColorList"
                Grid.Row="1"
                Grid.RowSpan="3"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="6"
                ItemsSource="{x:Bind ViewModel.Colors}"
                SelectedItem="{x:Bind ViewModel.SelectedColor, Mode=TwoWay}"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ThemeColorItem">
                        <StackPanel Padding="0,4" ToolTipService.ToolTip="{x:Bind Description}">
                            <TextBlock
                                Margin="0,6,0,4"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="{x:Bind Group}"
                                Visibility="{x:Bind IsGroupStart, Converter={StaticResource BoolToVisibility}}" />
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="28"
                                    Height="28"
                                    Background="{x:Bind Hex, Mode=OneWay, Converter={StaticResource HexToBrush}}"
                                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Hex, Mode=OneWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="changed"
                                    Visibility="{x:Bind IsOverridden, Mode=OneWay, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Spacing="6">
                <TextBlock Margin="0,8,0,0" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedColor.Label, Mode=OneWay, FallbackValue=''}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SelectedColor.Description, Mode=OneWay, FallbackValue=''}"
                    TextWrapping="Wrap" />
                <ColorPicker
                    x:Name="Picker"
                    IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}"
                    ColorChanged="Picker_ColorChanged"
                    ColorSpectrumShape="Box"
                    IsAlphaEnabled="True"
                    IsAlphaSliderVisible="True"
                    IsColorChannelTextInputVisible="False"
                    IsColorPreviewVisible="True"
                    IsHexInputVisible="False"
                    IsMoreButtonVisible="False" />
                <TextBox Header="Hex (#AARRGGBB or #RRGGBB)" IsEnabled="{x:Bind ViewModel.IsEditable, Mode=OneWay}" Text="{x:Bind ViewModel.HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Grid.Row="2" Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Bottom" Spacing="6">
                <Grid ColumnSpacing="6" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button
                        HorizontalAlignment="Stretch"
                        Command="{x:Bind ViewModel.SaveCommand}"
                        Content="Save theme"
                        Style="{StaticResource AccentButtonStyle}" />
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.RevertCommand}" Content="Undo unsaved" />
                    <Button Grid.Row="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ResetSelectedCommand}" Content="Reset color" />
                    <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Command="{x:Bind ViewModel.ResetAllCommand}" Content="Reset all colors" />
                </Grid>
                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    IsTextSelectionEnabled="True"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap">
                    <Run Text="Saved to" />
                    <Run Text="{x:Bind ViewModel.SavePath}" />
                </TextBlock>
            </StackPanel>
        </Grid>

        <!--  Preview: every control type the app uses  -->
        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Padding="0,0,12,12" Spacing="12">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Preview" />

                <Border Style="{StaticResource GallerySection}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Text" />
                        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Title text" />
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Body text: labels, list rows and most of the app." />
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Secondary text: captions and column headers" />
                        <TextBlock Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="Tertiary text: placeholders" />
                        <TextBlock Foreground="{ThemeResource TextFillColorDisabledBrush}" Text="Disabled text" />
                        <TextBlock Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Text="Accent text" />
                        <HyperlinkButton Content="Hyperlink button" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8B7;" />
                            <SymbolIcon Symbol="Document" />
                            <SymbolIcon Symbol="Folder" />
                            <Rectangle Width="40" Height="16" Fill="{ThemeResource AccentFillColorDefaultBrush}" />
                            <Rectangle Width="40" Height="16" Fill="{ThemeResource ControlFillColorDefaultBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GallerySection}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Buttons and commands" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Button" />
                            <Button Content="Accent button" Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="Disabled" IsEnabled="False" />
                            <ToggleButton Content="Toggle button" IsChecked="True" />
                            <Button Content="Menu">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Icon="Download" Text="Get latest" />
                                        <MenuFlyoutItem Icon="Upload" Text="Commit" />
                                        <MenuFlyoutSeparator />
                                        <MenuFlyoutSubItem Text="More">
                                            <MenuFlyoutItem Text="Properties" />
                                            <MenuFlyoutItem IsEnabled="False" Text="Disabled item" />
                                        </MenuFlyoutSubItem>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <Button Click="ShowDialog_Click" Content="Open dialog" />
                        </StackPanel>
                        <CommandBar HorizontalAlignment="Left" DefaultLabelPosition="Right">
                            <AppBarButton Icon="Refresh" Label="Refresh" />
                            <AppBarButton Icon="Add" Label="Add" />
                            <AppBarToggleButton Icon="Filter" IsChecked="True" Label="Filter" />
                            <AppBarSeparator />
                            <AppBarButton Icon="Delete" IsEnabled="False" Label="Delete" />
                            <CommandBar.SecondaryCommands>
                                <AppBarButton Icon="Setting" Label="Options" />
                            </CommandBar.SecondaryCommands>
                        </CommandBar>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GallerySection}">
                    <Grid ColumnSpacing="16" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="Inputs" />
                        <TextBox Grid.Row="1" Header="Text box" PlaceholderText="Placeholder text" />
                        <PasswordBox Grid.Row="1" Grid.Column="1" Header="Password box" Password="password" />
                        <NumberBox Grid.Row="2" Header="Number box" SpinButtonPlacementMode="Inline" Value="42" />
                        <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Header="Combo box" SelectedIndex="0">
                            <x:String>ilike</x:String>
                            <x:String>=</x:String>
                            <x:String>!=</x:String>
                        </ComboBox>
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="12">
                            <CheckBox Content="Check box" IsChecked="True" />
                            <CheckBox Content="Unchecked" />
                            <CheckBox Content="Disabled" IsEnabled="False" />
                        </StackPanel>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch IsOn="True" />
                            <ToggleSwitch IsOn="False" />
                        </StackPanel>
                        <TextBox Grid.Row="4" Header="Disabled text box" IsEnabled="False" Text="Can't edit" />
                        <RichEditBox Grid.Row="4" Grid.Column="1" Header="Rich edit box" MinHeight="60" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource GallerySection}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Navigation" />
                        <BreadcrumbBar x:Name="SampleBreadcrumb" />
                        <SelectorBar>
                            <SelectorBarItem IsSelected="True" Text="Local" />
                            <SelectorBarItem Text="Remote" />
                            <SelectorBarItem Text="History" />
                        </SelectorBar>
                        <TabView Height="120" IsAddTabButtonVisible="False">
                            <TabViewItem Header="History">
                                <TextBlock Margin="8" Text="Tab content" />
                            </TabViewItem>
                            <TabViewItem Header="Parents">
                                <TextBlock Margin="8" Text="Second tab" />
                            </TabViewItem>
                            <TabViewItem Header="Children" />
                        </TabView>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource GallerySection}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.ColumnSpan="2" Style="{StaticResource SectionHeader}" Text="Trees, lists and tables" />
                        <TreeView x:Name="SampleTree" Grid.Row="1" Grid.RowSpan="2" Height="220" />
                        <tv:TableView
                            x:Name="SampleTable"
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="170"
                            AutoGenerateColumns="False">
                            <tv:TableView.Columns>
                                <tv:TableViewTextColumn Binding="{Binding Name}" Header="Name" />
                                <tv:TableViewTextColumn Binding="{Binding Status}" Header="Status" />
                                <tv:TableViewTextColumn Binding="{Binding Size}" Header="Size" />
                                <tv:TableViewTextColumn Binding="{Binding ModUser}" Header="Mod User" />
                            </tv:TableView.Columns>
                        </tv:TableView>
                        <ListView
                            x:Name="SampleList"
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="110"
                            Margin="0,8,0,0"
                            SelectionMode="Single" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource GallerySection}">
                    <StackPanel Spacing="8">
                        <TextBlock Style="{StaticResource SectionHeader}" Text="Status" />
                        <ProgressBar Value="60" />
                        <ProgressBar IsIndeterminate="True" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <ProgressRing IsActive="True" />
                            <ProgressRing IsIndeterminate="False" Value="70" />
                            <InfoBadge Value="5" />
                            <InfoBadge Style="{ThemeResource AttentionIconInfoBadgeStyle}" />
                            <InfoBadge Style="{ThemeResource CriticalIconInfoBadgeStyle}" />
                        </StackPanel>
                        <InfoBar IsClosable="False" IsOpen="True" Message="Informational message" Severity="Informational" Title="Info" />
                        <InfoBar IsClosable="False" IsOpen="True" Message="Files committed" Severity="Success" Title="Success" />
                        <InfoBar IsClosable="False" IsOpen="True" Message="File is checked out by another user" Severity="Warning" Title="Warning" />
                        <InfoBar IsClosable="False" IsOpen="True" Message="Could not reach the server" Severity="Error" Title="Error" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
