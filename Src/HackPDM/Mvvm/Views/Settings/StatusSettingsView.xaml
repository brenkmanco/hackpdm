<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.StatusSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Padding="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel MaxWidth="460" HorizontalAlignment="Left" Spacing="12">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Status Window" />

            <TextBox
                x:Name="HistoryLengthBox"
                Header="Log history length (lines per list)"
                Text="{x:Bind ViewModel.HistoryLengthText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

            <CheckBox
                x:Name="AutoCloseBox"
                Content="Close status window automatically when an operation completes"
                IsChecked="{x:Bind ViewModel.AutoClose, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="SaveButton"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    Content="Save"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Name="ClearLogsButton"
                    Command="{x:Bind ViewModel.ClearLogsCommand}"
                    Content="Clear Status Logs" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
