<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Settings.ProfileManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HackPDM.Mvvm.Views.Hack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:rep="using:HackPDM.Domain.Representation"
    xmlns:xaml="using:Microsoft.UI.Xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="55" />
        </Grid.RowDefinitions>

        <!--  Hack Settings Button  -->
        <Button
            x:Name="HackSettingsBtn"
            Command="{x:Bind ViewModel.OpenSettingsCommand}"
            Grid.Row="1"
            Grid.Column="0"
            Height="35"
            MinWidth="100"
            Margin="5,5,5,5"
            Padding="5,5,5,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Content="Hack Settings" />

        <!--  Odoo Settings Button  -->
        <Button
            x:Name="odooSettingsBtn"
            Command="{x:Bind ViewModel.OpenSettingsCommand}"
            Grid.Row="1"
            Grid.Column="1"
            Height="35"
            MinWidth="100"
            Margin="5,5,5,5"
            Padding="5,5,5,5"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Content="Odoo Settings" />
        <!--  Odoo Login Button  -->
        <Button
            x:Name="OdooLoginBtn"
            Command="{x:Bind ViewModel.LoginCommand}"
            Grid.Row="1"
            Grid.Column="2"
            Height="35"
            MinWidth="100"
            Margin="5,5,5,5"
            Padding="5,5,5,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Content="Odoo Login"
            Style="{StaticResource AccentButtonStyle}" />
        <StackPanel
            x:Name="InfoOrLoad"
            Grid.Row="1"
            Grid.Column="3"
            Margin="5,5,0,5"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="6">
            <ProgressRing
                x:Name="OdooLoginProgressRing"
                Width="24"
                Height="24"
                VerticalAlignment="Center"
                IsActive="{x:Bind ViewModel.IsLoggingIn, Mode=OneWay}" />
            <CommandBar
                x:Name="MoreTools"
                VerticalAlignment="Center"
                DefaultLabelPosition="Right">
                <AppBarButton
                    x:Name="AdditionalTools"
                    Icon="More">
                    <AppBarButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem
                                x:Name="LoadJsonSettingsBtn"
                                Command="{x:Bind ViewModel.LoadProfileCommand}"
                                Text="Load Json Settings" />

                            <MenuFlyoutSubItem Text="Save Configuration To Json">
                                <MenuFlyoutItem
                                    x:Name="SaveSettingsJson"
                                    Command="{x:Bind ViewModel.SaveProfileCommand}"
                                    Text="With Password" />
                                <MenuFlyoutItem
                                    x:Name="SaveSettingsJsonWithoutPass"
                                    Command="{x:Bind ViewModel.SaveProfileWithoutPasswordCommand}"
                                    Text="Without Password" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="CreateTemplateSettingsJson"
                                Command="{x:Bind ViewModel.CreateTemplateCommand}"
                                Text="Create Template Json" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="OpenStatusLogBtn"
                                Click="OpenStatusLog_Click"
                                Text="Status Log" />
                        </MenuFlyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
            </CommandBar>
        </StackPanel>
        <!--  Status List View  -->
        <tv:TableView
            x:Name="ProfileManStatusList"
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="4"
            Margin="0,5,0,10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AutoGenerateColumns="False"
            ItemsSource="{x:Bind ViewModel.OStatus, Mode=OneWay}"
            BorderThickness="1,1,1,1">
            <!--  FIX: Remove ListView.View, use ListView.ItemTemplate for UWP/WinUI  -->
            <tv:TableView.Columns>
                <!--<TextBlock Grid.Column="0" Text="{data:Binding Status}" />
				<TextBlock Grid.Column="1" Text="{data:Binding Message}" />-->
                <tv:TableViewTextColumn
                    Width="140"
                    Binding="{Binding Status}"
                    Header="Action" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Message}"
                    Header="Description" />

            </tv:TableView.Columns>
        </tv:TableView>
    </Grid>
</Page>
