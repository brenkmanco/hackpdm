<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Odoo.OdooSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Odoo Address  -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Odoo Address" />
        <TextBox
            x:Name="txtOdooAddress"
            Text="{x:Bind ViewModel.OdooAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="0"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  Odoo Port  -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Odoo Port" />
        <TextBox
            x:Name="txtOdooPort"
            Text="{x:Bind ViewModel.OdooPort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="1"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  HTTPS: Odoo sends the password with every request  -->
        <CheckBox
            x:Name="chkUseHttps"
            Grid.Row="2"
            Grid.Column="1"
            Margin="0,5,0,5"
            Content="Use HTTPS (recommended: without it the password is sent unencrypted)"
            IsChecked="{x:Bind ViewModel.OdooUseHttps, Mode=TwoWay}" />

        <!--  Odoo DB  -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Odoo DB" />
        <TextBox
            x:Name="txtOdooDb"
            Text="{x:Bind ViewModel.OdooDb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="3"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  Odoo User  -->
        <TextBlock
            Grid.Row="4"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Odoo User" />
        <TextBox
            x:Name="txtOdooUser"
            Text="{x:Bind ViewModel.OdooUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="4"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  Odoo Pass  -->
        <TextBlock
            Grid.Row="5"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Password or API key" />
        <PasswordBox
            x:Name="txtOdooPass"
            Password="{x:Bind ViewModel.OdooPass, Mode=TwoWay}"
            Grid.Row="5"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  SW Key  -->
        <TextBlock
            Grid.Row="6"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="SW Key" />
        <TextBox
            x:Name="txtSwKey"
            Text="{x:Bind ViewModel.OdooSwKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="6"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  Area Factor  -->
        <TextBlock
            Grid.Row="7"
            Grid.Column="0"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Text="Area Factor" />
        <TextBox
            x:Name="txtAreaFactor"
            Text="{x:Bind ViewModel.OdooAreaFactor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
            Grid.Row="7"
            Grid.Column="1"
            Margin="0,5,0,5" />

        <!--  Submit Button  -->
        <Button
            x:Name="btnSubmit"
            Grid.Row="8"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Command="{x:Bind ViewModel.SubmitCommand}"
            Content="Submit" />
    </Grid>
</Page>

