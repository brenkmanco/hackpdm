<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.Mvvm.Views.Odoo.SearchOdooView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tv="using:WinUI.TableView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:globalData="using:HackPDM.Shared.GlobalData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:odoo="using:HackPDM.Infrastructure.Odoo"
    xmlns:rep="using:HackPDM.Domain.Representation"
    xmlns:x1="using:System"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <globalData:OperatorConverter x:Key="OperationConverter" />
        <!--  Create list of enumeration values  -->
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock x:Name="label1" Text="Filename Value" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox
                        x:Name="OdooSearchComparer"
                        Width="80"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.OperatorList}"
                        SelectedItem="{x:Bind ViewModel.SelectedComparer, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="rep:OperatorsRow">
                                <TextBlock Text="{Binding OpRepr}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBox
                        x:Name="FileNameTextbox"
                        MinWidth="250"
                        HorizontalAlignment="Stretch"
                        Text="{x:Bind ViewModel.FileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="24">
                    <CheckBox
                        x:Name="OdooCheckedMe"
                        Content="Checked Out to Me"
                        IsChecked="{x:Bind ViewModel.CheckedOutMe, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                    <CheckBox
                        x:Name="OdooLocalOnly"
                        Content="Only Existing Locally"
                        IsChecked="{x:Bind ViewModel.LocalOnly, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.IsLocalOnlyEnabled, Mode=OneWay}" />
                    <CheckBox
                        x:Name="OdooDeletedIsLocal"
                        Content="Deleted Existing Locally"
                        IsChecked="{x:Bind ViewModel.DeletedRemotely, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    Margin="0,4,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock
                        x:Name="lblMaxRes"
                        VerticalAlignment="Center"
                        Text="Max Results" />
                    <TextBox
                        x:Name="OdooMaxRes"
                        Width="60"
                        Text="{x:Bind ViewModel.MaxResults, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="8">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="label2" Text="Property" />
                        <ComboBox
                            x:Name="OdooSearchProperty"
                            MinWidth="150"
                            IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.PropertiesSearchable}"
                            SelectedItem="{x:Bind ViewModel.SelectedProperty, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rep:SearchPropertiesRow">
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock x:Name="OdooPropComparer" Text="is" />
                        <ComboBox
                            x:Name="OdooSearchPropEqual"
                            Width="80"
                            IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                            ItemsSource="{x:Bind ViewModel.OperatorList}"
                            SelectedItem="{x:Bind ViewModel.SelectedPropertyOperator, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="rep:OperatorsRow">
                                    <TextBlock Text="{Binding OpRepr}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock x:Name="label3" Text="Value" />
                        <TextBox
                            x:Name="OdooSearchPropValue"
                            MinWidth="150"
                            IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                            Text="{x:Bind ViewModel.PropertyValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>

                    <Button
                        x:Name="OdooPropAdd"
                        Grid.Column="3"
                        MinWidth="120"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.AddPropertyCommand}"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                        Content="Add" />
                </Grid>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="OdooPropDelete"
                        Command="{x:Bind ViewModel.DeletePropertiesCommand}"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                        Content="Delete" />
                    <Button
                        x:Name="OdooPropertyReset"
                        Command="{x:Bind ViewModel.ResetPropertiesCommand}"
                        IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
                        Content="Reset List" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <tv:TableView
            x:Name="OdooSearchPropList"
            Grid.Row="1"
            Height="120"
            Margin="0,16,0,0"
            AutoGenerateColumns="False"
            IsEnabled="{x:Bind ViewModel.AreRemoteFiltersEnabled, Mode=OneWay}"
            ItemsSource="{x:Bind ViewModel.PropertiesActive}">
            <tv:TableView.Columns>
                <tv:TableViewComboBoxColumn
                    Width="2*"
                    Binding="{Binding Name}"
                    Header="Property Name" />

                <tv:TableViewComboBoxColumn
                    Width="1*"
                    Binding="{Binding Comparer}"
                    Header="Comparer" />

                <tv:TableViewTextColumn
                    Width="2*"
                    Binding="{Binding Value}"
                    Header="Value" />
            </tv:TableView.Columns>
        </tv:TableView>

        <tv:TableView
            x:Name="OdooSearchResults"
            Grid.Row="2"
            Margin="0,16,0,0"
            DoubleTapped="OdooSearchResults_DoubleTapped"
            ItemsSource="{x:Bind ViewModel.SearchResultsList, Mode=OneWay}"
            SelectionMode="Extended">

            <tv:TableView.Columns>
                <tv:TableViewTextColumn
                    Width="0"
                    Binding="{Binding Id}"
                    Header="ID" />

                <tv:TableViewTextColumn
                    Width="350"
                    Binding="{Binding Name}"
                    Header="File Name" />
                <tv:TableViewTextColumn
                    Width="*"
                    Binding="{Binding Directory}"
                    Header="File Path" />
            </tv:TableView.Columns>
            <tv:TableView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutSubItem x:Name="CheckOutMenuItem" Text="Checkout">
                        <MenuFlyoutItem
                            x:Name="checkoutToolStripMenuItem"
                            Command="{x:Bind ViewModel.CheckoutCommand}"
                            Text="Checkout" />
                        <MenuFlyoutItem
                            x:Name="checkoutOpenToolStripMenuItem"
                            Command="{x:Bind ViewModel.CheckoutAndOpenCommand}"
                            Text="Checkout and Open" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutItem
                        x:Name="unCheckoutToolStripMenuItem"
                        Command="{x:Bind ViewModel.UndoCheckoutCommand}"
                        Text="UnCheckout" />
                    <MenuFlyoutItem
                        x:Name="openToolStripMenuItem"
                        Command="{x:Bind ViewModel.OpenCommand}"
                        Text="Open" />
                </MenuFlyout>
            </tv:TableView.ContextFlyout>
        </tv:TableView>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    x:Name="btnCancel"
                    Click="OdooCancel_Click"
                    Content="Cancel"
                    Style="{ThemeResource AccentButtonStyle}">
                    <Button.Resources>
                        <ResourceDictionary>
                            <!--  a red "stop" button in every color preset (the accent style reads the AccentButton* keys)  -->
                            <SolidColorBrush x:Key="AccentButtonBackground" Color="{ThemeResource SystemFillColorCritical}" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Opacity="0.85" Color="{ThemeResource SystemFillColorCritical}" />
                            <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Opacity="0.7" Color="{ThemeResource SystemFillColorCritical}" />
                            <SolidColorBrush x:Key="AccentButtonForeground" Color="White" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPointerOver" Color="White" />
                            <SolidColorBrush x:Key="AccentButtonForegroundPressed" Color="White" />
                        </ResourceDictionary>
                    </Button.Resources>
                </Button>
                <Button
                    x:Name="btnReset"
                    Command="{x:Bind ViewModel.ResetCommand}"
                    Content="Reset" />
            </StackPanel>

            <Button
                x:Name="btnSearch"
                Grid.Column="2"
                MinWidth="200"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="Search"
                Style="{ThemeResource AccentButtonStyle}" />
        </Grid>
    </Grid>
</Page>