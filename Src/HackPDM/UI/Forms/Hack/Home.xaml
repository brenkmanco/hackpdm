<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.UI.Forms.Hack.Home"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HackPDM.UI.Forms.Hack"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <NavigationView
        x:Name="HomeNavigator"
        AlwaysShowHeader="False"
        ExpandedModeThresholdWidth="900"
        Header="HackPDM"
        IsBackButtonVisible="Auto"
        IsBackEnabled="True"
        IsSettingsVisible="True"
        IsTabStop="False"
        PaneDisplayMode="LeftCompact"
        PaneTitle="Pane"
        SelectionChanged="HomeNavigator_SelectionChanged"
        SelectionFollowsFocus="Disabled">

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="HackFMNavItem"
                Content="Hack File Manager"
                Tag="HackFileManager">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Home" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="Settings" />

            <NavigationViewItem
                x:Name="ProfileManagerNavItem"
                Content="Profile Manager"
                Tag="ProfileManager">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Account" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="HackOdoo"
                Content="Configurations"
                Tag="HackOdoo">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Edit" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

        </NavigationView.MenuItems>

        <Frame x:Name="NavFrame" Margin="0,0,0,0" />

    </NavigationView>
</Page>
