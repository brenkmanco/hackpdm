<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="HackPDM.UI.Forms.Settings.ApplicationSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Microsoft.UI.Xaml.Controls;assembly=Microsoft.WinUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:HackPDM.UI.Forms.Settings"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Frame>
        <StackPanel x:Name="RootStack">
            <ColorPicker
                x:Name="ColorPick"
                ColorSpectrumShape="Box"
                IsAlphaEnabled="True"
                IsAlphaSliderVisible="True"
                IsColorChannelTextInputVisible="True"
                IsColorPreviewVisible="True"
                IsHexInputVisible="True" />
        </StackPanel>
    </Frame>
</Page>
